<task_definition_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> ( "approval" | "action" ) (* required; data type: string; lov: STATIC *)
<task_definition_group_block> ::= <task_definition_advanced>
  | <task_definition_column_mapping>
  | <task_definition_comments>
  | <task_definition_deadline>
  | <task_definition_source>
