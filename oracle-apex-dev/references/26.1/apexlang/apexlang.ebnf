<plugin_component> ::= <indent> "component" <ws> "{" <line_end> { <plugin_component_property_line> } <indent> "}" <line_end>
<plugin_component_property_line> ::= <indent> <plugin_component_property> <line_end>
<plugin_component_property> ::= "standardAttributes" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = templateComponent *)
  | "standardAttributes" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = item; dynamic values omitted *)
  | "standardAttributes" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = region; dynamic values omitted *)
  | "standardAttributes" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = dynamicAction *)
  | "standardAttributes" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = authenticationScheme *)
  | "standardAttributes" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = restDataSource *)
  | "standardAttributes" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = process *)
  | "supports" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; lov: STATIC; applies when type = item *)
  | "supports" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; lov: STATIC; applies when type = process *)
  | "supportsSessionStateDataTypes" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; lov: STATIC; applies when type = item *)
