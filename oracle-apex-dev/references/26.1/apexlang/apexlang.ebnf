  | "fetchOnSearch" ":" <ws> <boolean> (* required; data type: boolean *)
  | "fetchOnType" ":" <ws> <boolean> (* required; data type: boolean *)
  | "filenameColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when based_on = DB_COLUMN *)
  | "foregroundColor" ":" <ws> <string_like_value> (* data type: string *)
  | "format" ":" <ws> ( "plainText" | "html" | "markdown" | "htmlUnsafe" ) (* required; data type: string; lov: STATIC *)
  | "height" ":" <ws> <number> (* data type: integer *)
  | "hideControl" ":" <ws> <boolean> (* required; data type: boolean *)
  | "highlightedDate" ":" <ws> <string_like_value> (* data type: string *)
  | "htmlExpression" ":" <ws> <string_like_value> (* required; data type: string *)
  | "icon" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_defaults = N *)
  | "inactiveColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "infiniteScroll" ":" <ws> <boolean> (* required; data type: boolean *)
  | "initialFetch" ":" <ws> ( "auto" | "autoCurrentValue" | "onUserRequest" ) (* required; data type: string; lov: STATIC *)
  | "interactiveMap" ":" <ws> <boolean> (* required; data type: boolean *)
  | "manualEntriesItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when fetch_on_search = N *)
  | "manualEntry" ":" <ws> <boolean> (* required; data type: boolean *)
  | "markerColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when show_marker = Y *)
  | "maxDate" ":" <ws> ( "static" | "none" | "item" ) (* required; data type: string; lov: STATIC *)
  | "maxHeight" ":" <ws> <number> (* data type: number *)
  | "maxItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when max_date = ITEM *)
  | "maxStatic" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when max_date = STATIC *)
  | "maxValue" ":" <ws> <number> (* data type: number *)
  | "maxValuesInList" ":" <ws> <number> (* conditional; data type: integer; applies when infinite_scroll = N *)
  | "mimeTypeColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when based_on = DB_COLUMN *)
  | "minDate" ":" <ws> ( "none" | "item" | "static" ) (* required; data type: string; lov: STATIC *)
  | "minHeight" ":" <ws> <number> (* data type: number *)
  | "minItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when min_date = ITEM *)
  | "minStatic" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when min_date = STATIC *)
  | "minValue" ":" <ws> <number> (* data type: number *)
  | "mode" ":" <ws> ( "simple" | "full" ) (* required; conditional; data type: string; lov: STATIC *)
  | "multiSelection" ":" <ws> <boolean> (* required; data type: boolean *)
  | "multipleMonths" ":" <ws> ( "5" | "false" | "3" | "2" | "4" ) (* required; conditional; data type: string; lov: STATIC; applies when display_as in (POPUP) or display_as in (INLINE) *)
  | "navigationListFor" ":" <ws> ( "month" | "monthAndYear" | "year" | "none" ) (* required; data type: string; lov: STATIC *)
  | "noOfCols" ":" <ws> <number> (* required; data type: integer *)
  | "noOfMonths" ":" <ws> <string_like_value> (* conditional; data type: string; applies when show_other_months = Y *)
  | "noOfStars" ":" <ws> ( "2" | "4" | "3" | "10" | "8" | "1" | "6" | "5" | "7" | "9" ) (* required; data type: string; lov: STATIC *)
  | "numberAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; data type: string; lov: STATIC *)
  | "offLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "offValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "onLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "onValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "pageActionOnSelection" ":" <ws> ( "none" | "redirectSetValue" | "submitPage" ) (* required; data type: string; lov: STATIC *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when format = PLAIN and based_on = PLSQL *)
  | "popupHeight" ":" <ws> <number> (* data type: number *)
  | "popupWidth" ":" <ws> <number> (* data type: number *)
  | "prefixText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when user_can_choose_operator = N *)
  | "preserveCase" ":" <ws> <boolean> (* required; data type: boolean *)
  | "rangeText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when manual_entry = Y *)
  | "readOnlyDisplay" ":" <ws> ( "singleStarAndValue" | "stars" | "value" | "starsAndValue" ) (* required; conditional; data type: string; lov: STATIC; applies when use_defaults = N *)
  | "resizable" ":" <ws> <boolean> (* required; data type: boolean *)
  | "returnValueAs" ":" <ws> ( "hsla" | "hsl" | "anyCssValue" | "rgb" | "hex" | "rgba" ) (* required; conditional; data type: string; lov: STATIC *)
  | "sanitizeAddress" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when structured_address = Y *)
  | "searchType" ":" <ws> ( "oracleText" | "rowSearch" ) (* required; data type: string; lov: STATIC *)
  | "selectMultiple" ":" <ws> <boolean> (* required; data type: boolean *)
  | "selector" ":" <ws> <string_like_value> (* conditional; data type: string; applies when trigger_geocoding = JQUERY_SELECTOR *)
  | "sendOnPageSubmit" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when disabled = Y *)
  | "show" ":" <ws> ( "inline" | "onIconClick" | "onFocus" | "both" ) (* required; data type: string; lov: STATIC *)
  | "showClearButton" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_defaults = N *)
  | "showControls" ":" <ws> ( "none" | "orderingOnly" | "all" | "movingOnly" ) (* required; data type: string; lov: STATIC *)
  | "showLineBreaks" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when format = PLAIN and based_on in (VALUE) or format = PLAIN and based_on in (LOV) *)
  | "showMapControls" ":" <ws> <boolean> (* required; data type: boolean *)
  | "showMarker" ":" <ws> <boolean> (* required; data type: boolean *)
  | "showOn" ":" <ws> ( "iconClick" | "itemFocus" ) (* required; conditional; data type: string; lov: STATIC; applies when display_as in (POPUP) and use_defaults = N or display_as in (INLINE) and use_defaults = N *)
  | "showOtherMonths" ":" <ws> <boolean> (* required; data type: boolean *)
  | "showSelectAll" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when enable_multi_select = Y *)
  | "showTime" ":" <ws> <boolean> (* required; data type: boolean *)
  | "showValue" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_defaults = N *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when based_on = SQL *)
  | "structuredAddress" ":" <ws> <boolean> (* required; data type: boolean *)
  | "submitWhenEnterPressed" ":" <ws> <boolean> (* required; data type: boolean *)
  | "subtype" ":" <ws> ( "search" | "phone" | "url" | "text" | "email" ) (* required; data type: string; lov: STATIC *)
  | "suffixText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when user_can_choose_operator = N *)
  | "syntaxHighlighting" ":" <ws> <boolean> (* required; data type: boolean *)
  | "textCase" ":" <ws> ( "lower" | "upper" ) (* data type: string; lov: STATIC *)
  | "textColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when show_value = Y *)
  | "timeIncrement" ":" <ws> <number> (* conditional; data type: integer; applies when display_as in (POPUP) and use_defaults = N or display_as in (INLINE) and use_defaults = N *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "toolbar" ":" <ws> ( "simple" | "full" | "none" ) (* required; data type: string; lov: STATIC *)
  | "toolbarStyle" ":" <ws> ( "overflowMenu" | "multiline" ) (* required; conditional; data type: string; lov: STATIC; applies when format = HTML and toolbar in (INTERMEDIATE) or format = HTML and toolbar in (FULL) *)
  | "tooltip" ":" <ws> <string_like_value> (* conditional; data type: string; applies when show_marker = Y *)
  | "triggerGeocoding" ":" <ws> ( "jquerySelector" | "automatic" | "dynamicAction" ) (* required; data type: string; lov: STATIC *)
  | "trimSpaces" ":" <ws> ( "trailing" | "leadingAndTrailing" | "leading" | "none" ) (* required; data type: string; lov: STATIC *)
  | "uncheckedValue" ":" <ws> <string_like_value> (* conditional; data type: string *)
  | "useCache" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when fetch_on_search = Y *)
  | "useDefaults" ":" <ws> <boolean> (* required; data type: boolean *)
  | "userCanChooseOperator" ":" <ws> <boolean> (* required; data type: boolean *)
  | "valueHtmlExpression" ":" <ws> <string_like_value> (* data type: string *)
  | "valueProtected" ":" <ws> <boolean> (* required; data type: boolean *)
  | "valuesCase" ":" <ws> ( "lower" | "mixed" | "upper" ) (* required; conditional; data type: string; lov: STATIC; applies when comparison_operator in (STARTS_WITH) and case_sensitive = Y or comparison_operator in (CONTAINS) and case_sensitive = Y or comparison_operator in (NOT_STARTS_WITH) and case_sensitive = Y or other dependency conditions are satisfied *)
  | "virtualKeyboard" ":" <ws> ( "decimal" | "numeric" | "text" ) (* required; data type: string; lov: STATIC *)
  | "yearRange" ":" <ws> <string_like_value> (* conditional; data type: string; applies when navigation_list_for in (YEAR) or navigation_list_for in (MONTH_AND_YEAR) *)
  | "zoomLevel" ":" <ws> <number> (* required; data type: integer *)
<page_item_source> ::= <indent> "source" <ws> "{" <line_end> { <page_item_source_property_line> } <indent> "}" <line_end>
<page_item_source_property_line> ::= <indent> <page_item_source_property> <line_end>
<page_item_source_property> ::= "column" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports SOURCE and formRegion is set *)
  | "dataType" ":" <ws> ( "varchar2" | "number" | "date" | "timestamp" | "timestampWithTimeZone" | "timestampWithLocalTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "clob" | "blob" | "boolean" | "rowid" | "bfile" | "sdoGeometry" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE and formRegion is set *)
  | "databaseColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports SOURCE and type = databaseColumn *)
  | "formRegion" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: region; applies when type supports SOURCE; dynamic values omitted *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports SOURCE and type = item *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE and type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE and type = functionBody *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = functionBody and language = plsql *)
  | "postCalculationComputation" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports SOURCE and type = preference *)
  | "primaryKey" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports SOURCE and formRegion is set *)
  | "queryOnly" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports SOURCE and formRegion is set *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = sqlQuerySingleValue *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = sqlQueryMultipleValues *)
  | "staticValue" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = staticValue *)
  | "type" ":" <ws> ( "staticValue" | "databaseColumn" | "item" | "sqlQuerySingleValue" | "sqlQueryMultipleValues" | "expression" | "functionBody" | "preference" | "null" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE *)
  | "used" ":" <ws> ( "always" | "onlyWhenSessionStateIsNull" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE *)
<page_item_storage> ::= <indent> "storage" <ws> "{" <line_end> { <page_item_storage_property_line> } <indent> "}" <line_end>
<page_item_storage_property_line> ::= <indent> <page_item_storage_property> <line_end>
<page_item_storage_property> ::= "allowMultipleFiles" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when storage_type = APEX_APPLICATION_TEMP_FILES *)
  | "blobLastUpdatedColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "bobLastUpdatedColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "charSetColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "fileTypes" ":" <ws> <string_like_value> (* data type: string *)
  | "filenameColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "maxFileSize" ":" <ws> <number> (* data type: integer *)
  | "mimeTypeColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "purgeFileAt" ":" <ws> ( "endOfRequest" | "endOfSession" ) (* required; conditional; data type: string; lov: STATIC; applies when storage_type = APEX_APPLICATION_TEMP_FILES *)
  | "purgeFilesAt" ":" <ws> ( "endOfRequest" | "endOfSession" ) (* required; conditional; data type: string; lov: STATIC; applies when storage_type = APEX_APPLICATION_TEMP_FILES *)
  | "type" ":" <ws> ( "appTempFiles" | "wwvFlowFiles" | "blobCol" ) (* required; data type: string; lov: STATIC *)
<page_item_validation> ::= <indent> "validation" <ws> "{" <line_end> { <page_item_validation_property_line> } <indent> "}" <line_end>
<page_item_validation_property_line> ::= <indent> <page_item_validation_property> <line_end>
<page_item_validation_property> ::= "maxLength" ":" <ws> <number> (* conditional; data type: number; applies when type supports WIDTH *)
  | "valueRequired" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports SESSION_STATE *)

(* process *)
(* direct properties use default group: identification *)
<process> ::= "process" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <process_body_line> } <indent> ")" <line_end>
<process_body_line> ::= <process_direct_property_line>
  | <process_group_block>
  | <process_child_component>
<process_direct_property_line> ::= <indent> <process_direct_property> <line_end>
<process_direct_property> ::= "editableRegion" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: region; applies when type supports REGION and executionChain does not support RUN_IN_BACKGROUND; dynamic values omitted *)
  | "executionChain" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: process; dynamic values omitted *)
  | "formRegion" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: region; applies when type supports FORM; dynamic values omitted *)
  | "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> <process_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
<process_group_block> ::= <process_action>
  | <process_address>
  | <process_advanced>
  | <process_background_execution>
  | <process_clear>
  | <process_comments>
  | <process_compare>
  | <process_condition>
  | <process_config>
  | <process_data_loading>
  | <process_email_attachments>
  | <process_email_content>
  | <process_email_dispatch_mode>
  | <process_email_header>
  | <process_email_template>
  | <process_end_state>
  | <process_error>
  | <process_execution>
  | <process_file_handling>
  | <process_gen_ai>
  | <process_geocoding_input>
  | <process_geocoding_result>
  | <process_human_task>
  | <process_input_value>
  | <process_invoke>
  | <process_lock_row>
  | <process_navigation>
  | <process_overrides>
  | <process_parsing_options>
  | <process_processing>
  | <process_processing_result>
  | <process_renew>
  | <process_reset_pagination>
  | <process_security>
  | <process_serialization>
  | <process_server_side_condition>
  | <process_settings>
  | <process_source>
  | <process_source_data>
  | <process_success_message>
  | <process_switch>
  | <process_target>
  | <process_timeout>
  | <process_use_response>
  | <process_workflow>
  | <process_workflow_instance>
<process_action> ::= <indent> "action" <ws> "{" <line_end> { <process_action_property_line> } <indent> "}" <line_end>
<process_action_property_line> ::= <indent> <process_action_property> <line_end>
<process_action_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (SET_PREFERENCE_TO_ITEM_VALUE) or type in (SET_PREFERENCE_TO_ITEM_VALUE_IF_ITEM_NOT_NULL) *)
  | "preferenceName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (SET_PREFERENCE_TO_ITEM_VALUE) or type in (SET_PREFERENCE_TO_ITEM_VALUE_IF_ITEM_NOT_NULL) *)
  | "type" ":" <ws> ( "setToItemValue" | "setToItemValueIfNotNull" | "resetPreferences" ) (* required; data type: string; lov: STATIC *)
<process_address> ::= <indent> "address" <ws> "{" <line_end> { <process_address_property_line> } <indent> "}" <line_end>
<process_address_property_line> ::= <indent> <process_address_property> <line_end>
<process_address_property> ::= "sanitizeAddress" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when structured_address = Y *)
  | "structuredAddress" ":" <ws> <boolean> (* required; data type: boolean *)
<process_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <process_advanced_property_line> } <indent> "}" <line_end>
<process_advanced_property_line> ::= <indent> <process_advanced_property> <line_end>
<process_advanced_property> ::= "executionMappingIdentifier" ":" <ws> <string_like_value> (* data type: string *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<process_background_execution> ::= <indent> "backgroundExecution" <ws> "{" <line_end> { <process_background_execution_property_line> } <indent> "}" <line_end>
<process_background_execution_property_line> ::= <indent> <process_background_execution_property> <line_end>
<process_background_execution_property> ::= "contextValueItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when run_in_background = Y *)
  | "executionsLimit" ":" <ws> <number> (* conditional; data type: number; applies when run_in_background = Y *)
  | "returnIdIntoItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when run_in_background = Y *)
  | "runInBackground" ":" <ws> <boolean> (* required; data type: boolean *)
  | "submitImmediately" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when run_in_background = Y *)
  | "tempFileHandling" ":" <ws> ( "ignore" | "copy" | "move" ) (* required; conditional; data type: string; lov: STATIC; applies when run_in_background = Y *)
  | "tempFileItems" ":" <ws> <string_like_value> (* conditional; data type: string; applies when run_in_background = Y and temporary_file_handling in (MOVE) or run_in_background = Y and temporary_file_handling in (COPY) *)
<process_clear> ::= <indent> "clear" <ws> "{" <line_end> { <process_clear_property_line> } <indent> "}" <line_end>
<process_clear_property_line> ::= <indent> <process_clear_property> <line_end>
<process_clear_property> ::= "applications" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CLEAR_CACHE_FOR_FLOWS *)
  | "items" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CLEAR_CACHE_FOR_ITEMS *)
  | "pages" ":" <ws> <number> (* required; conditional; data type: integer; applies when type = CLEAR_CACHE_FOR_PAGES *)
  | "type" ":" <ws> ( "apps" | "session" | "currentPage" | "currentApp" | "items" | "pages" ) (* required; data type: string; lov: STATIC *)
<process_comments> ::= <indent> "comments" <ws> "{" <line_end> { <process_comments_property_line> } <indent> "}" <line_end>
<process_comments_property_line> ::= <indent> <process_comments_property> <line_end>
<process_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<process_compare> ::= <indent> "compare" <ws> "{" <line_end> { <process_compare_property_line> } <indent> "}" <line_end>
<process_compare_property_line> ::= <indent> <process_compare_property> <line_end>
<process_compare_property> ::= "compareLanguage" ":" <ws> ( "plsql" | "js-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = CASE and compare_type in (EXPRESSION) or type = CASE and compare_type in (FUNCTION_BODY) *)
  | "comparePlsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = EXPRESSION *)
  | "comparePlsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = FUNCTION_BODY *)
  | "compareSqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = SQL_QUERY *)
  | "compareType" ":" <ws> ( "expression" | "sqlQuery" | "functionBody" ) (* required; conditional; data type: string; lov: STATIC; applies when type = CASE *)
  | "compareVar" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CHECK_WF_VARIABLE *)
  | "dataType" ":" <ws> ( "timestampWithLocalTimeZone" | "number" | "varchar2" | "boolean" | "timestamp" | "timestampWithTimeZone" ) (* required; conditional; data type: string; lov: STATIC; applies when type = CASE *)
<process_condition> ::= <indent> "condition" <ws> "{" <line_end> { <process_condition_property_line> } <indent> "}" <line_end>
<process_condition_property_line> ::= <indent> <process_condition_property> <line_end>
<process_condition_property> ::= "conditionType" ":" <ws> ( "functionBody" | "workflowVarIsNotNull" | "workflowVarNotEqualsValue" | "workflowVarEqualsValue" | "expression" | "rowsNotReturned" | "rowsReturned" | "workflowVarIsNull" ) (* required; conditional; data type: string; lov: STATIC; applies when type = TRUE_FALSE_CHECK *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = TRUE_FALSE_CHECK and condition_type in (EXPRESSION) or type = TRUE_FALSE_CHECK and condition_type in (FUNCTION_BODY) *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type = EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type = FUNCTION_BODY *)
