  | "showProgress" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = chart and show = true and type = gantt *)
  | "showRow" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = chart and show = true and type = gantt *)
