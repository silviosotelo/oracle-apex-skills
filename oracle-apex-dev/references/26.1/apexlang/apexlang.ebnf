(* action *)
(* direct properties use default group: identification *)
<action_f> ::= "action" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <action_f_body_line> } <indent> ")" <line_end>
<action_f_body_line> ::= <action_f_direct_property_line>
  | <action_f_group_block>
  | <action_f_child_component>
<action_f_direct_property_line> ::= <indent> <action_f_direct_property> <line_end>
<action_f_direct_property> ::= "label" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when position supports TEMPLATE and template supports LABEL or position supports TMPL_LABEL *)
  | "position" ":" <ws> <string_like_value> (* required; data type: string; lov: PLUGIN_ACTION_POSITIONS *)
  | "template" ":" <ws> <string_like_value> (* required; conditional; data type: string; lov: PLUGIN_ACTION_TEMPLATES; applies when position supports TEMPLATE *)
