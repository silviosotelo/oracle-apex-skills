<rest_data_source_settings> ::= <indent> "settings" <ws> "{" <line_end> { <rest_data_source_settings_property_line> } <indent> "}" <line_end>
<rest_data_source_settings_property_line> ::= <indent> <rest_data_source_settings_property> <line_end>
<rest_data_source_settings_property> ::= "caseInsensitiveFiltering" ":" <ws> ( "basedOnUpperCase" | "notSupported" | "basedOnLowerCase" ) (* required; data type: string; lov: STATIC *)
  | "discoverReferences" ":" <ws> <boolean> (* required; data type: boolean *)
  | "fixedPageSize" ":" <ws> <number> (* required; conditional; data type: number; applies when pagination_type = PAGE_NUMBER_FIXED_SIZE *)
  | "hasMoreRowsAttrValue" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when pagination_type is set and has_more_rows_selector is set and has_more_rows_when_value = EQUALS *)
  | "hasMoreRowsSelector" ":" <ws> <string_like_value> (* conditional; data type: string; applies when pagination_type is set *)
  | "hasMoreRowsWhenValue" ":" <ws> ( "isNotNull" | "equals" ) (* required; conditional; data type: string; lov: STATIC; applies when pagination_type is set and has_more_rows_selector is set *)
  | "indexOfFirstPage" ":" <ws> ( "0" | "1" ) (* required; conditional; data type: string; lov: STATIC; applies when pagination_type in (PAGE_NUMBER_FLEXIBLE_SIZE) or pagination_type in (PAGE_NUMBER_FIXED_SIZE) *)
  | "nextPageTokenSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when pagination_type = PAGE_TOKEN_FLEXIBLE_SIZE *)
  | "pageNoUrlParam" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when pagination_type in (PAGE_NUMBER_FLEXIBLE_SIZE) or pagination_type in (PAGE_NUMBER_FIXED_SIZE) *)
  | "pageSizeMax" ":" <ws> <number> (* conditional; data type: number; applies when pagination_type in (PAGE_NUMBER_FLEXIBLE_SIZE) or pagination_type in (FLEXIBLE) or pagination_type in (PAGE_TOKEN_FLEXIBLE_SIZE) *)
  | "pageSizeUrlParam" ":" <ws> <string_like_value> (* conditional; data type: string; applies when pagination_type in (FLEXIBLE) or pagination_type in (PAGE_NUMBER_FLEXIBLE_SIZE) or pagination_type in (PAGE_TOKEN_FLEXIBLE_SIZE) *)
  | "pageTokenUrlParam" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when pagination_type = PAGE_TOKEN_FLEXIBLE_SIZE *)
  | "paginationType" ":" <ws> ( "pageSizeAndPageNo" | "pageNo" | "pageSizeAndFetchOffset" | "pageSizeAndPageToken" ) (* data type: string; lov: STATIC *)
  | "paramDefaultValues" ":" <ws> <string_like_value> (* data type: string *)
  | "resourcePath" ":" <ws> <string_like_value> (* required; data type: string *)
  | "resourceType" ":" <ws> ( "searchView" | "businessObjectView" | "extractionView" ) (* required; data type: string; lov: STATIC *)
  | "returnTotalResultCount" ":" <ws> ( "notSupported" | "inlineInResponse" | "inlineInResponseAllpages" | "separateHttpRequest" ) (* required; data type: string; lov: STATIC *)
  | "returnsLegacyOrdsJson" ":" <ws> <boolean> (* required; data type: boolean *)
  | "rootResourceName" ":" <ws> <string_like_value> (* data type: string *)
  | "rowOffsetType" ":" <ws> ( "rowsToSkip" | "firstRowToFetch" ) (* required; conditional; data type: string; lov: STATIC; applies when pagination_type = FLEXIBLE *)
  | "rowOffsetUrlParam" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when pagination_type = FLEXIBLE *)
  | "sendQueryOptions" ":" <ws> ( "passAsRequestBody" | "appendToUrl" ) (* required; data type: string; lov: STATIC *)
  | "sortingNulls" ":" <ws> ( "flexible" | "nullsHighest" ) (* required; conditional; data type: string; lov: STATIC; applies when returns_legacy_ords_json = N *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; data type: string *)
  | "supportedOdataFilters" ":" <ws> ( "contains" | "in" | "endsWith" | "startsWith" ) (* data type: string; lov: STATIC *)
  | "supportedOdataOptions" ":" <ws> ( "rowSearch" | "returnSortedResults" | "returnOnlySpecificCols" | "resultsPagination" | "supportsEtag" ) (* data type: string; lov: STATIC *)
  | "totalRowsSelector" ":" <ws> <string_like_value> (* conditional; data type: string; applies when pagination_type is set *)
  | "useBatchDml" ":" <ws> <boolean> (* required; data type: boolean *)
  | "useBulkDml" ":" <ws> <boolean> (* required; data type: boolean *)
  | "usePagination" ":" <ws> <boolean> (* required; data type: boolean *)
  | "useTotalResults" ":" <ws> <boolean> (* required; data type: boolean *)
