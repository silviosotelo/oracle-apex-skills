  | "fontFamily" ":" <ws> ( "arial" | "arialBlack" | "bookman" | "comicSansMs" | "courier" | "courierNew" | "garamond" | "georgia" | "helvetica" | "impact" | "palatino" | "times" | "timesNewRoman" | "trebuchetMs" | "verdana" ) (* conditional; data type: string; lov: STATIC; applies when show = true *)
  | "fontSize" ":" <ws> ( "8" | "10" | "12" | "14" | "16" | "18" | "20" | "22" ) (* conditional; data type: string; lov: STATIC; applies when show = true *)
  | "fontStyle" ":" <ws> ( "normal" | "italic" | "oblique" ) (* conditional; data type: string; lov: STATIC; applies when show = true *)
  | "position" ":" <ws> ( "center" | "outsideSlice" | "aboveMarker" | "belowMarker" | "beforeMarker" | "afterMarker" | "insideBarEdge" | "outsideBarEdge" | "auto" | "none" | "start" ) (* required; conditional; data type: string; lov: STATIC; applies when show = true *)
  | "show" ":" <ws> <boolean> (* required; data type: boolean *)
