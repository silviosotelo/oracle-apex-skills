<series_local_post_processing_property> ::= "item" ":" <ws> <value> (* required; conditional; data type: complex; applies when location = restSource and restSource is set and type = whereOrderByClause and orderByType = item *)
  | "item" ":" <ws> <value> (* required; conditional; data type: complex; applies when location = jsonDualityView and jsonDualityView is set and type = whereOrderByClause and orderByType = item *)
