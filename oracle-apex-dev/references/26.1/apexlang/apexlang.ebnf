  | <search_source> (* applies when type = search *)

(* action *)
(* direct properties use default group: identification *)
<action_e> ::= "action" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <action_e_body_line> } <indent> ")" <line_end>
<action_e_body_line> ::= <action_e_direct_property_line>
  | <action_e_group_block>
  | <action_e_child_component>
<action_e_direct_property_line> ::= <indent> <action_e_direct_property> <line_end>
<action_e_direct_property> ::= "label" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when position supports TEMPLATE and template supports LABEL or position supports TMPL_LABEL *)
  | "position" ":" <ws> <string_like_value> (* required; data type: string; lov: PLUGIN_ACTION_POSITIONS *)
  | "template" ":" <ws> <string_like_value> (* required; conditional; data type: string; lov: PLUGIN_ACTION_TEMPLATES; applies when position supports TEMPLATE *)
<action_e_group_block> ::= <action_e_advanced>
  | <action_e_appearance>
  | <action_e_behavior>
  | <action_e_comments>
  | <action_e_config>
  | <action_e_layout>
  | <action_e_security>
  | <action_e_server_side_condition>
<action_e_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <action_e_advanced_property_line> } <indent> "}" <line_end>
