(* operation *)
(* direct properties use default group: identification *)
<operation> ::= "operation" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <operation_body_line> } <indent> ")" <line_end>
<operation_body_line> ::= <operation_direct_property_line>
  | <operation_group_block>
<operation_direct_property_line> ::= <indent> <operation_direct_property> <line_end>
<operation_direct_property> ::= "label" ":" <ws> <string_like_value> (* data type: string *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<operation_group_block> ::= <operation_advanced>
  | <operation_comments>
  | <operation_data_profile>
  | <operation_operation>
  | <operation_remote_cache>
  | <operation_request_body>
<operation_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <operation_advanced_property_line> } <indent> "}" <line_end>
<operation_advanced_property_line> ::= <indent> <operation_advanced_property> <line_end>
<operation_advanced_property> ::= "allowFetchingAllRows" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when databaseOperation = fetchRows *)
  | "fetchAllRowsTimeout" ":" <ws> <number> (* conditional; data type: integer; applies when databaseOperation = fetchRows and allowFetchingAllRows = true *)
  | "fixedPageSize" ":" <ws> <number> (* data type: integer *)
  | "forceRaiseHttp404Error" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when databaseOperation = fetchRows *)
  | "staticId" ":" <ws> <string_like_value> (* data type: string *)
<operation_comments> ::= <indent> "comments" <ws> "{" <line_end> { <operation_comments_property_line> } <indent> "}" <line_end>
<operation_comments_property_line> ::= <indent> <operation_comments_property> <line_end>
<operation_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<operation_data_profile> ::= <indent> "dataProfile" <ws> "{" <line_end> { <operation_data_profile_property_line> } <indent> "}" <line_end>
<operation_data_profile_property_line> ::= <indent> <operation_data_profile_property> <line_end>
<operation_data_profile_property> ::= "nestedRows" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: dataProfileColumn; dynamic values omitted *)
<operation_operation> ::= <indent> "operation" <ws> "{" <line_end> { <operation_operation_property_line> } <indent> "}" <line_end>
<operation_operation_property_line> ::= <indent> <operation_operation_property> <line_end>
<operation_operation_property> ::= "databaseOperation" ":" <ws> ( "fetchRows" | "fetchSingleRow" | "insert" | "update" | "delete" ) (* data type: string; lov: STATIC *)
  | "httpMethod" ":" <ws> ( "get" | "post" | "put" | "delete" | "patch" ) (* required; data type: string; lov: STATIC *)
  | "urlPattern" ":" <ws> <string_like_value> (* required; data type: string *)
<operation_remote_cache> ::= <indent> "remoteCache" <ws> "{" <line_end> { <operation_remote_cache_property_line> } <indent> "}" <line_end>
<operation_remote_cache_property_line> ::= <indent> <operation_remote_cache_property> <line_end>
<operation_remote_cache_property> ::= "caching" ":" <ws> ( "allUsers" | "user" | "session" ) (* conditional; data type: string; lov: STATIC; applies when httpMethod in (get) and databaseOperation in (fetchRows) or httpMethod in (get) and databaseOperation in (fetchSingleRow) or httpMethod in (post) and databaseOperation in (fetchRows) or other dependency conditions are satisfied *)
  | "timeout" ":" <ws> <multiline_string> (* conditional; data type: string; applies when httpMethod in (get) and databaseOperation in (fetchRows) and caching is set or httpMethod in (get) and databaseOperation in (fetchSingleRow) and caching is set or httpMethod in (post) and databaseOperation in (fetchRows) and caching is set or other dependency conditions are satisfied *)
<operation_request_body> ::= <indent> "requestBody" <ws> "{" <line_end> { <operation_request_body_property_line> } <indent> "}" <line_end>
<operation_request_body_property_line> ::= <indent> <operation_request_body_property> <line_end>
<operation_request_body_property> ::= "template" ":" <ws> <multiline_string> (* conditional; data type: string *)
  | "versionNumber" ":" <ws> ( "1" | "2" ) (* required; conditional; data type: string; lov: STATIC *)

(* parameter *)
