<series_direct_property_line> ::= <indent> <series_direct_property> <line_end>
<series_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> ( "area" | "bar" | "line" | "lineWithArea" | "barRange" | "areaRange" ) (* required; conditional; data type: string; lov: STATIC; applies when type = combination *)
  | "type" ":" <ws> ( "barRange" | "areaRange" ) (* required; conditional; data type: string; lov: STATIC; applies when type = range *)
  | "type" ":" <ws> ( "area" | "bar" | "line" | "lineWithArea" | "scatter" | "bubble" | "barRange" | "areaRange" ) (* required; conditional; data type: string; lov: STATIC; applies when type = polar *)
  | "type" ":" <ws> ( "area" | "areaRange" | "line" ) (* required; conditional; data type: string; lov: STATIC; applies when type = radar *)
  | "type" ":" <ws> ( "area" | "bar" | "boxPlot" | "line" | "lineWithArea" ) (* required; conditional; data type: string; lov: STATIC; applies when type = boxPlot *)
