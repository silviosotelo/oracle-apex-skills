<layer_legend_property_line> ::= <indent> <layer_legend_property> <line_end>
<layer_legend_property> ::= "advancedFormatting" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when show = true *)
  | "enableToHide" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when show = true and advancedFormatting = false *)
  | "htmlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when show = true and advancedFormatting = true *)
  | "iconCssClasses" ":" <ws> <string_like_value> (* conditional; data type: string; applies when show = true and advancedFormatting = false *)
  | "show" ":" <ws> <boolean> (* required; data type: boolean *)
