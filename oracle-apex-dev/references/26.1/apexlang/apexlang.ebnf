  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* conditional; data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<page_security> ::= <indent> "security" <ws> "{" <line_end> { <page_security_property_line> } <indent> "}" <line_end>
<page_security_property_line> ::= <indent> <page_security_property> <line_end>
<page_security_property> ::= "authentication" ":" <ws> ( "required" | "public" ) (* required; conditional; data type: string; lov: STATIC *)
  | "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* conditional; data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
  | "browserCache" ":" <ws> ( "true" | "false" ) (* conditional; data type: string; lov: STATIC *)
  | "deepLinking" ":" <ws> ( "true" | "false" ) (* conditional; data type: string; lov: STATIC *)
  | "formAutoComplete" ":" <ws> ( "true" | "false" ) (* required; conditional; data type: string; lov: STATIC *)
  | "pageAccessProtection" ":" <ws> ( "unrestricted" | "argumentsMustHaveChecksum" | "noArgumentsSupported" | "noUrlAccess" ) (* required; conditional; data type: string; lov: STATIC *)
<page_server_cache> ::= <indent> "serverCache" <ws> "{" <line_end> { <page_server_cache_property_line> } <indent> "}" <line_end>
<page_server_cache_property_line> ::= <indent> <page_server_cache_property> <line_end>
<page_server_cache_property> ::= "cacheTimeout" ":" <ws> ( "10Seconds" | "1Minute" | "10Minutes" | "30Minutes" | "1Hour" | "2Hours" | "3Hours" | "4Hours" | "6Hours" | "12Hours" | "1Day" | "2Days" | "3Days" | "4Days" | "1Week" | "2Weeks" | "4Weeks" | "10Weeks" | "1Year" ) (* required; conditional; data type: string; lov: STATIC *)
  | "caching" ":" <ws> ( "false" | "true" | "cacheByUser" | "cacheBySession" ) (* required; conditional; data type: string; lov: STATIC *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* conditional; data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<page_session_management> ::= <indent> "sessionManagement" <ws> "{" <line_end> { <page_session_management_property_line> } <indent> "}" <line_end>
<page_session_management_property_line> ::= <indent> <page_session_management_property> <line_end>
<page_session_management_property> ::= "rejoinSessions" ":" <ws> ( "false" | "publicSessions" | "allSessions" ) (* conditional; data type: string; lov: STATIC *)
<page_child_component> ::= <branch_a>
  | <button>
  | <computation_a>
  | <dynamic_action>
  | <meta_tag> (* applies when authentication = public and enableMetaTags = true *)
  | <page_item>
  | <process>
  | <region>
  | <validation_b>

(* branch *)
(* direct properties use default group: identification *)
<branch_a> ::= "branch" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <branch_a_body_line> } <indent> ")" <line_end>
<branch_a_body_line> ::= <branch_a_direct_property_line>
  | <branch_a_group_block>
<branch_a_direct_property_line> ::= <indent> <branch_a_direct_property> <line_end>
<branch_a_direct_property> ::= "name" ":" <ws> <string_like_value> (* data type: string *)
<branch_a_group_block> ::= <branch_a_behavior>
  | <branch_a_comments>
  | <branch_a_config>
  | <branch_a_execution>
  | <branch_a_security>
  | <branch_a_server_side_condition>
<branch_a_behavior> ::= <indent> "behavior" <ws> "{" <line_end> { <branch_a_behavior_property_line> } <indent> "}" <line_end>
<branch_a_behavior_property_line> ::= <indent> <branch_a_behavior_property> <line_end>
<branch_a_behavior_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (pageIdentifiedByItem) or type in (urlIdentifiedByItem) *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (functionReturningPage) and language in (javaScript-mle) or type in (functionReturningUrl) and language in (javaScript-mle) *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (functionReturningPage) or type in (functionReturningUrl) *)
  | "pageNumber" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (page) or type in (pageProcessing) *)
  | "plsqlCode" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = plsqlProcedure *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (functionReturningPage) and language in (plsql) or type in (functionReturningUrl) and language in (plsql) *)
  | "request" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = pageProcessing *)
  | "saveStateBeforeBranching" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = pageOrUrl *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = pageOrUrl *)
  | "type" ":" <ws> ( "pageOrUrl" | "urlIdentifiedByItem" | "functionReturningUrl" | "page" | "pageIdentifiedByItem" | "functionReturningPage" | "plsqlProcedure" | "pageProcessing" ) (* required; data type: string; lov: STATIC *)
<branch_a_comments> ::= <indent> "comments" <ws> "{" <line_end> { <branch_a_comments_property_line> } <indent> "}" <line_end>
<branch_a_comments_property_line> ::= <indent> <branch_a_comments_property> <line_end>
<branch_a_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<branch_a_config> ::= <indent> "config" <ws> "{" <line_end> { <branch_a_config_property_line> } <indent> "}" <line_end>
<branch_a_config_property_line> ::= <indent> <branch_a_config_property> <line_end>
<branch_a_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<branch_a_execution> ::= <indent> "execution" <ws> "{" <line_end> { <branch_a_execution_property_line> } <indent> "}" <line_end>
<branch_a_execution_property_line> ::= <indent> <branch_a_execution_property> <line_end>
<branch_a_execution_property> ::= "point" ":" <ws> ( "beforeHeader" | "afterSubmit" | "validating" | "processing" | "afterProcessing" ) (* required; data type: string; lov: STATIC *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
<branch_a_security> ::= <indent> "security" <ws> "{" <line_end> { <branch_a_security_property_line> } <indent> "}" <line_end>
<branch_a_security_property_line> ::= <indent> <branch_a_security_property> <line_end>
<branch_a_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<branch_a_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <branch_a_server_side_condition_property_line> } <indent> "}" <line_end>
<branch_a_server_side_condition_property_line> ::= <indent> <branch_a_server_side_condition_property> <line_end>
<branch_a_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
  | "whenButtonPressed" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: button; dynamic values omitted *)

(* button *)
(* direct properties use default group: identification *)
<button> ::= "button" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <button_body_line> } <indent> ")" <line_end>
<button_body_line> ::= <button_direct_property_line>
  | <button_group_block>
  | <button_child_component>
<button_direct_property_line> ::= <indent> <button_direct_property> <line_end>
<button_direct_property> ::= "buttonName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "label" ":" <ws> <string_like_value> (* required; data type: string *)
<button_group_block> ::= <button_advanced>
  | <button_appearance>
  | <button_behavior>
  | <button_comments>
  | <button_config>
  | <button_confirmation>
  | <button_layout>
  | <button_security>
  | <button_server_side_condition>
<button_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <button_advanced_property_line> } <indent> "}" <line_end>
<button_advanced_property_line> ::= <indent> <button_advanced_property> <line_end>
<button_advanced_property> ::= "customAttributes" ":" <ws> <string_like_value> (* data type: string *)
  | "htmlDomId" ":" <ws> <string_like_value> (* data type: string *)
  | "postText" ":" <ws> <multiline_string> (* data type: string *)
  | "preText" ":" <ws> <multiline_string> (* data type: string *)
  | "requestSource" ":" <ws> <multiline_string> (* conditional; data type: string; applies when requestSourceType is set *)
  | "requestSourceType" ":" <ws> ( "staticValue" | "databaseColumn" | "item" | "sqlQuerySingleValue" | "sqlQueryMultipleValues" | "plsqlExpression" | "plsqlFunctionBody" | "preference" | "null" ) (* data type: string; lov: STATIC *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<button_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <button_appearance_property_line> } <indent> "}" <line_end>
<button_appearance_property_line> ::= <indent> <button_appearance_property> <line_end>
<button_appearance_property> ::= "buttonTemplate" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: buttonTemplate; dynamic values omitted *)
  | "cssClasses" ":" <ws> <array_of_string_like_value> (* data type: string *)
  | "hot" ":" <ws> <boolean> (* required; data type: boolean *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
  | "showAsDisabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when buttonTemplate supports IS_DISABLED *)
  | "templateOptions" ":" <ws> <array_of_string_like_value> (* data type: string; lov: TEMPLATE_OPTIONS *)
<button_behavior> ::= <indent> "behavior" <ws> "{" <line_end> { <button_behavior_property_line> } <indent> "}" <line_end>
<button_behavior_property_line> ::= <indent> <button_behavior_property> <line_end>
<button_behavior_property> ::= "action" ":" <ws> ( "submitPage" | "triggerAction" | "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "definedByDynamicAction" | "resetPage" | "nextPage" | "previousPage" ) (* required; conditional; data type: string; lov: STATIC; applies when type = standard *)
  | "databaseAction" ":" <ws> ( "insert" | "update" | "delete" ) (* conditional; data type: string; lov: STATIC; applies when type = standard *)
  | "executeValidations" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = standard and action in (submitPage) or type = standard and action in (redirectUrl) or type = standard and action in (definedByDynamicAction) or other dependency conditions are satisfied *)
  | "requiresConfirmation" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = standard *)
  | "showProcessing" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = standard and action = submitPage *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = standard and action = redirectThisApp *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = standard and action = redirectOtherApp *)
  | "targetUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = standard and action = redirectUrl *)
  | "type" ":" <ws> ( "standard" | "menu" ) (* required; data type: string; lov: STATIC *)
  | "warnOnUnsavedChanges" ":" <ws> ( "doNotCheck" ) (* conditional; data type: string; lov: STATIC; applies when type = standard *)
<button_comments> ::= <indent> "comments" <ws> "{" <line_end> { <button_comments_property_line> } <indent> "}" <line_end>
<button_comments_property_line> ::= <indent> <button_comments_property> <line_end>
<button_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<button_config> ::= <indent> "config" <ws> "{" <line_end> { <button_config_property_line> } <indent> "}" <line_end>
<button_config_property_line> ::= <indent> <button_config_property> <line_end>
<button_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<button_confirmation> ::= <indent> "confirmation" <ws> "{" <line_end> { <button_confirmation_property_line> } <indent> "}" <line_end>
<button_confirmation_property_line> ::= <indent> <button_confirmation_property> <line_end>
<button_confirmation_property> ::= "message" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = standard and requiresConfirmation = true *)
  | "style" ":" <ws> ( "information" | "warning" | "danger" | "success" ) (* conditional; data type: string; lov: STATIC; applies when type = standard and requiresConfirmation = true *)
<button_layout> ::= <indent> "layout" <ws> "{" <line_end> { <button_layout_property_line> } <indent> "}" <line_end>
<button_layout_property_line> ::= <indent> <button_layout_property> <line_end>
<button_layout_property> ::= "alignment" ":" <ws> ( "center" | "centerBottom" | "centerCenter" | "centerTop" | "left" | "leftBottom" | "leftCenter" | "leftTop" | "right" | "rightBottom" | "rightCenter" | "rightTop" ) (* required; conditional; data type: string; lov: STATIC; applies when slot = BODY *)
  | "column" ":" <ws> <string_like_value> (* data type: string; lov: GRID_COLUMNS *)
  | "columnAttributes" ":" <ws> <array_of_string_like_value> (* data type: string *)
  | "columnCssClasses" ":" <ws> <array_of_string_like_value> (* data type: string *)
  | "columnSpan" ":" <ws> <string_like_value> (* data type: string; lov: GRID_COLUMNS *)
  | "horizontalAlignment" ":" <ws> ( "left" | "right" ) (* required; conditional; data type: string; lov: STATIC; applies when slot in (TOP) or slot in (TOP_AND_BOTTOM) or slot in (ABOVE_BOX) or other dependency conditions are satisfied *)
  | "newColumn" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when startNewLayout = false and startNewRow = false *)
  | "region" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: region; dynamic values omitted *)
  | "rowCssClasses" ":" <ws> <array_of_string_like_value> (* data type: string *)
  | "rowSpan" ":" <ws> <number> (* data type: number *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
  | "slot" ":" <ws> <string_like_value> (* required; data type: string; lov: SLOTS *)
  | "startNewLayout" ":" <ws> <boolean> (* required; data type: boolean *)
  | "startNewRow" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when startNewLayout = false *)
<button_security> ::= <indent> "security" <ws> "{" <line_end> { <button_security_property_line> } <indent> "}" <line_end>
<button_security_property_line> ::= <indent> <button_security_property> <line_end>
<button_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<button_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <button_server_side_condition_property_line> } <indent> "}" <line_end>
<button_server_side_condition_property_line> ::= <indent> <button_server_side_condition_property> <line_end>
<button_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<button_child_component> ::= <menu_c> (* applies when type = menu *)
  | <trigger_action_c> (* applies when type = standard and action = triggerAction *)

(* menu *)
(* direct properties use default group: identification *)
<menu_c> ::= "menu" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <menu_c_body_line> } <indent> ")" <line_end>
<menu_c_body_line> ::= <menu_c_direct_property_line>
  | <menu_c_group_block>
  | <menu_c_child_component>
<menu_c_direct_property_line> ::= <indent> <menu_c_direct_property> <line_end>
<menu_c_direct_property> ::= "label" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) or type in (subMenu) *)
  | "parentMenu" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: menu; dynamic values omitted *)
  | "type" ":" <ws> ( "menuEntry" | "subMenu" | "separator" ) (* required; data type: string; lov: STATIC *)
<menu_c_group_block> ::= <menu_c_advanced>
  | <menu_c_appearance>
  | <menu_c_behavior>
  | <menu_c_comments>
  | <menu_c_config>
  | <menu_c_layout>
  | <menu_c_security>
  | <menu_c_server_side_condition>
<menu_c_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <menu_c_advanced_property_line> } <indent> "}" <line_end>
<menu_c_advanced_property_line> ::= <indent> <menu_c_advanced_property> <line_end>
<menu_c_advanced_property> ::= "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<menu_c_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <menu_c_appearance_property_line> } <indent> "}" <line_end>
<menu_c_appearance_property_line> ::= <indent> <menu_c_appearance_property> <line_end>
<menu_c_appearance_property> ::= "icon" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (menuEntry) or type in (subMenu) *)
<menu_c_behavior> ::= <indent> "behavior" <ws> "{" <line_end> { <menu_c_behavior_property_line> } <indent> "}" <line_end>
<menu_c_behavior_property_line> ::= <indent> <menu_c_behavior_property> <line_end>
<menu_c_behavior_property> ::= "linkAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = menuEntry and type in (redirectThisApp) or type = menuEntry and type in (redirectOtherApp) or type = menuEntry and type in (redirectUrl) *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = menuEntry and type = redirectThisApp *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = menuEntry and type = redirectOtherApp *)
  | "targetUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = menuEntry and type = redirectUrl *)
  | "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "triggerAction" ) (* required; conditional; data type: string; lov: STATIC; applies when type = menuEntry *)
<menu_c_comments> ::= <indent> "comments" <ws> "{" <line_end> { <menu_c_comments_property_line> } <indent> "}" <line_end>
<menu_c_comments_property_line> ::= <indent> <menu_c_comments_property> <line_end>
<menu_c_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<menu_c_config> ::= <indent> "config" <ws> "{" <line_end> { <menu_c_config_property_line> } <indent> "}" <line_end>
<menu_c_config_property_line> ::= <indent> <menu_c_config_property> <line_end>
<menu_c_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<menu_c_layout> ::= <indent> "layout" <ws> "{" <line_end> { <menu_c_layout_property_line> } <indent> "}" <line_end>
<menu_c_layout_property_line> ::= <indent> <menu_c_layout_property> <line_end>
<menu_c_layout_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
<menu_c_security> ::= <indent> "security" <ws> "{" <line_end> { <menu_c_security_property_line> } <indent> "}" <line_end>
<menu_c_security_property_line> ::= <indent> <menu_c_security_property> <line_end>
<menu_c_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* conditional; data type: string; lov: COMPONENT; references: authorization; applies when type in (menuEntry) or type in (subMenu); dynamic values omitted *)
<menu_c_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <menu_c_server_side_condition_property_line> } <indent> "}" <line_end>
<menu_c_server_side_condition_property_line> ::= <indent> <menu_c_server_side_condition_property> <line_end>
<menu_c_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (item=value) or type in (menuEntry) and type in (item!=value) or type in (menuEntry) and type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type = textIsContainedInItem or type in (subMenu) and type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = javaScript-mle or type in (subMenu) and type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = functionBody and language = javaScript-mle or type in (subMenu) and type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (menuEntry) and type = expression or type in (subMenu) and type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (menuEntry) and type = functionBody or type in (subMenu) and type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (itemIsInColonDelimitedList) or type in (menuEntry) and type in (itemIsNotInColonDelimitedList) or type in (subMenu) and type in (itemIsInColonDelimitedList) or other dependency conditions are satisfied *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (menuEntry) and type in (currentPage=page) or type in (menuEntry) and type in (currentPage!=page) or type in (subMenu) and type in (currentPage=page) or other dependency conditions are satisfied *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (menuEntry) and type in (currentPageInList) or type in (menuEntry) and type in (currentPageNotInList) or type in (subMenu) and type in (currentPageInList) or other dependency conditions are satisfied *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = plsql or type in (subMenu) and type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = functionBody and language = plsql or type in (subMenu) and type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (userPreference=value) or type in (menuEntry) and type in (userPreference!=value) or type in (subMenu) and type in (userPreference=value) or other dependency conditions are satisfied *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = sql or type in (subMenu) and type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (rowsReturned) or type in (menuEntry) and type in (noRowsReturned) or type in (subMenu) and type in (rowsReturned) or other dependency conditions are satisfied *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (textIsContainedInItem) or type in (menuEntry) and type in (textIsContainedInValue) or type in (menuEntry) and type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* conditional; data type: string; lov: STATIC; applies when type in (menuEntry) or type in (subMenu); dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (request=Value) or type in (menuEntry) and type in (request!=Value) or type in (menuEntry) and type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (item=value) or type in (menuEntry) and type in (item!=value) or type in (menuEntry) and type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (textIsContainedInValue) or type in (menuEntry) and type in (textIsNotContainedInValue) or type in (menuEntry) and type in (text=value) or other dependency conditions are satisfied *)
<menu_c_child_component> ::= <trigger_action_e> (* applies when type = menuEntry and type = triggerAction *)

(* triggerAction *)
(* direct properties use default group: identification *)
<trigger_action_e> ::= "triggerAction" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <trigger_action_e_body_line> } <indent> ")" <line_end>
<trigger_action_e_body_line> ::= <trigger_action_e_direct_property_line>
  | <trigger_action_e_group_block>
<trigger_action_e_direct_property_line> ::= <indent> <trigger_action_e_direct_property> <line_end>
<trigger_action_e_direct_property> ::= "action" ":" <ws> <trigger_action_e_action_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<trigger_action_e_group_block> ::= <trigger_action_e_advanced>
  | <trigger_action_e_affected_elements>
  | <trigger_action_e_appearance>
  | <trigger_action_e_client_side_condition>
  | <trigger_action_e_comments>
  | <trigger_action_e_config>
  | <trigger_action_e_execution>
  | <trigger_action_e_file_handling>
  | <trigger_action_e_gen_ai>
  | <trigger_action_e_initial_prompt>
  | <trigger_action_e_input_value>
  | <trigger_action_e_quick_actions>
  | <trigger_action_e_security>
  | <trigger_action_e_server_side_condition>
  | <trigger_action_e_settings>
  | <trigger_action_e_source>
  | <trigger_action_e_use_response>
<trigger_action_e_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <trigger_action_e_advanced_property_line> } <indent> "}" <line_end>
<trigger_action_e_advanced_property_line> ::= <indent> <trigger_action_e_advanced_property> <line_end>
<trigger_action_e_advanced_property> ::= "initJavaScriptFunction" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports INIT_JAVASCRIPT_CODE *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<trigger_action_e_affected_elements> ::= <indent> "affectedElements" <ws> "{" <line_end> { <trigger_action_e_affected_elements_property_line> } <indent> "}" <line_end>
<trigger_action_e_affected_elements_property_line> ::= <indent> <trigger_action_e_affected_elements_property> <line_end>
<trigger_action_e_affected_elements_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when action supports ITEM and selectionType = button or action supports BUTTON and selectionType = button or action supports REGION and selectionType = button or other dependency conditions are satisfied; dynamic values omitted *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = items or action supports BUTTON and selectionType = items or action supports REGION and selectionType = items or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = javaScriptExpression or action supports BUTTON and selectionType = javaScriptExpression or action supports REGION and selectionType = javaScriptExpression or other dependency conditions are satisfied *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = jquerySelector or action supports BUTTON and selectionType = jquerySelector or action supports REGION and selectionType = jquerySelector or other dependency conditions are satisfied *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when action supports ITEM and selectionType = region or action supports BUTTON and selectionType = region or action supports REGION and selectionType = region or other dependency conditions are satisfied; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jquerySelector" | "javaScriptExpression" | "triggeringElement" | "eventSource" ) (* conditional; data type: string; lov: STATIC; applies when action supports ITEM or action supports BUTTON or action supports REGION or other dependency conditions are satisfied *)
<trigger_action_e_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <trigger_action_e_appearance_property_line> } <indent> "}" <line_end>
<trigger_action_e_appearance_property_line> ::= <indent> <trigger_action_e_appearance_property> <line_end>
<trigger_action_e_appearance_property> ::= "containerSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when display_as = INLINE *)
  | "displayAs" ":" <ws> ( "dialog" | "inline" ) (* required; data type: string; lov: STATIC *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as = DIALOG *)
<trigger_action_e_client_side_condition> ::= <indent> "clientSideCondition" <ws> "{" <line_end> { <trigger_action_e_client_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_e_client_side_condition_property_line> ::= <indent> <trigger_action_e_client_side_condition_property> <line_end>
<trigger_action_e_client_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInList) or type in (itemIsNotInList) *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* data type: string; lov: STATIC *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
<trigger_action_e_comments> ::= <indent> "comments" <ws> "{" <line_end> { <trigger_action_e_comments_property_line> } <indent> "}" <line_end>
<trigger_action_e_comments_property_line> ::= <indent> <trigger_action_e_comments_property> <line_end>
<trigger_action_e_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<trigger_action_e_config> ::= <indent> "config" <ws> "{" <line_end> { <trigger_action_e_config_property_line> } <indent> "}" <line_end>
<trigger_action_e_config_property_line> ::= <indent> <trigger_action_e_config_property> <line_end>
<trigger_action_e_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<trigger_action_e_execution> ::= <indent> "execution" <ws> "{" <line_end> { <trigger_action_e_execution_property_line> } <indent> "}" <line_end>
<trigger_action_e_execution_property_line> ::= <indent> <trigger_action_e_execution_property> <line_end>
<trigger_action_e_execution_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports STOP_EXECUTION_ON_ERROR *)
  | "waitForResult" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports WAIT_FOR_RESULT *)
<trigger_action_e_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <trigger_action_e_file_handling_property_line> } <indent> "}" <line_end>
<trigger_action_e_file_handling_property_line> ::= <indent> <trigger_action_e_file_handling_property> <line_end>
<trigger_action_e_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
  | "viewFileAs" ":" <ws> ( "inline" | "attachment" ) (* required; conditional; data type: string; lov: STATIC; applies when multiple_files = N *)
<trigger_action_e_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <trigger_action_e_gen_ai_property_line> } <indent> "}" <line_end>
<trigger_action_e_gen_ai_property_line> ::= <indent> <trigger_action_e_gen_ai_property> <line_end>
<trigger_action_e_gen_ai_property> ::= "agent" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: aiAgent; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "enabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports AI_ENABLED *)
  | "itemsToSubmit" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true *)
  | "service" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: genAIService; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "systemPrompt" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED and enabled = true *)
  | "welcomeMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_UI and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_UI and action supports AI_ENABLED and enabled = true *)
<trigger_action_e_initial_prompt> ::= <indent> "initialPrompt" <ws> "{" <line_end> { <trigger_action_e_initial_prompt_property_line> } <indent> "}" <line_end>
<trigger_action_e_initial_prompt_property_line> ::= <indent> <trigger_action_e_initial_prompt_property> <line_end>
<trigger_action_e_initial_prompt_property> ::= "displayedMessage" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "immediateActionPrompt" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = JAVASCRIPT_EXPRESSION *)
  | "type" ":" <ws> ( "item" | "jsExpression" ) (* data type: string; lov: STATIC *)
<trigger_action_e_input_value> ::= <indent> "inputValue" <ws> "{" <line_end> { <trigger_action_e_input_value_property_line> } <indent> "}" <line_end>
<trigger_action_e_input_value_property_line> ::= <indent> <trigger_action_e_input_value_property> <line_end>
<trigger_action_e_input_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = JAVASCRIPT *)
  | "type" ":" <ws> ( "jsCode" | "item" | "onlySystemPrompt" ) (* required; data type: string; lov: STATIC *)
<trigger_action_e_quick_actions> ::= <indent> "quickActions" <ws> "{" <line_end> { <trigger_action_e_quick_actions_property_line> } <indent> "}" <line_end>
<trigger_action_e_quick_actions_property_line> ::= <indent> <trigger_action_e_quick_actions_property> <line_end>
<trigger_action_e_quick_actions_property> ::= "message1" ":" <ws> <string_like_value> (* data type: string *)
  | "message2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when quick_action_message1 is set *)
<trigger_action_e_security> ::= <indent> "security" <ws> "{" <line_end> { <trigger_action_e_security_property_line> } <indent> "}" <line_end>
<trigger_action_e_security_property_line> ::= <indent> <trigger_action_e_security_property> <line_end>
<trigger_action_e_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<trigger_action_e_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <trigger_action_e_server_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_e_server_side_condition_property_line> ::= <indent> <trigger_action_e_server_side_condition_property> <line_end>
<trigger_action_e_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<trigger_action_e_settings> ::= <indent> "settings" <ws> "{" <line_end> { <trigger_action_e_settings_property_line> } <indent> "}" <line_end>
<trigger_action_e_settings_property_line> ::= <indent> <trigger_action_e_settings_property> <line_end>
<trigger_action_e_settings_property> ::= "action" ":" <ws> ( "subscription" | "aggregate" | "flashback" | "filters" | "columns" | "compute" | "pivot" | "controlBreak" | "download" | "groupBy" | "saveReport" | "sort" | "chart" | "highlight" ) (* required; data type: string; lov: STATIC *)
  | "cancelLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "class" ":" <ws> <string_like_value> (* required; data type: string *)
  | "clearErrors" ":" <ws> <boolean> (* required; data type: boolean *)
  | "confirmLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "cssClasses" ":" <ws> <string_like_value> (* data type: string *)
  | "enableHighAccuracy" ":" <ws> <boolean> (* required; data type: boolean *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (SQL_STATEMENT) or type in (PLSQL_EXPRESSION) or type in (FUNCTION_BODY) *)
  | "filePassword" ":" <ws> <string_like_value> (* data type: string *)
  | "fileSource" ":" <ws> ( "sqlQuery" | "fileUrls" ) (* required; conditional; data type: string; lov: STATIC; applies when share_type = files *)
  | "fileUrls" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = file_url *)
  | "filename" ":" <ws> <string_like_value> (* data type: string *)
  | "hidePageItemsOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = geojson *)
  | "itemsToReturn" ":" <ws> <string_like_value> (* data type: string *)
  | "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "jsCode" ":" <ws> <string_like_value> (* required; data type: string *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = JAVASCRIPT_EXPRESSION *)
  | "jsFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = javascript_code *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; data type: string; lov: STATIC *)
  | "latitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "longitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "maintainPagination" ":" <ws> <boolean> (* required; data type: boolean *)
  | "message" ":" <ws> <string_like_value> (* required; data type: string *)
  | "okLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = PLSQL *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY *)
  | "reportQuery" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: reportQuery; dynamic values omitted *)
  | "requestButtonName" ":" <ws> <string_like_value> (* data type: string *)
  | "returnItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = DIALOG_RETURN_ITEM *)
  | "returnType" ":" <ws> ( "jsFunction" | "latitudeAndLongitude" | "geojson" ) (* required; data type: string; lov: STATIC *)
  | "showAllOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "showProcessing" ":" <ws> <boolean> (* required; data type: boolean *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = sql_query *)
  | "style" ":" <ws> ( "information" | "danger" | "warning" | "success" ) (* data type: string; lov: STATIC *)
  | "styleName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when items_to_return is set *)
  | "text" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "url" | "currentPage" | "files" ) (* required; data type: string; lov: STATIC *)
  | "type" ":" <ws> ( "plsqlExpression" | "dialogReturnItem" | "static" | "plsqlFunctionBody" | "sqlQuery" | "jsExpression" ) (* required; data type: string; lov: STATIC *)
  | "url" ":" <ws> <value> (* required; conditional; data type: complex; applies when share_type = url *)
  | "value" ":" <ws> <string_like_value> (* data type: string *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; data type: string; lov: STATIC *)
<trigger_action_e_source> ::= <indent> "source" <ws> "{" <line_end> { <trigger_action_e_source_property_line> } <indent> "}" <line_end>
<trigger_action_e_source_property_line> ::= <indent> <trigger_action_e_source_property> <line_end>
<trigger_action_e_source_property> ::= "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = N *)
<trigger_action_e_use_response> ::= <indent> "useResponse" <ws> "{" <line_end> { <trigger_action_e_use_response_property_line> } <indent> "}" <line_end>
<trigger_action_e_use_response_property_line> ::= <indent> <trigger_action_e_use_response_property> <line_end>
<trigger_action_e_use_response_property> ::= "buttonLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = ITEM *)
  | "jsCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = JAVASCRIPT *)
  | "jsDetectionExpression" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_response_type = ITEM *)
  | "type" ":" <ws> ( "item" | "jsCode" ) (* data type: string; lov: STATIC *)

(* triggerAction *)
(* direct properties use default group: identification *)
<trigger_action_c> ::= "triggerAction" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <trigger_action_c_body_line> } <indent> ")" <line_end>
<trigger_action_c_body_line> ::= <trigger_action_c_direct_property_line>
  | <trigger_action_c_group_block>
<trigger_action_c_direct_property_line> ::= <indent> <trigger_action_c_direct_property> <line_end>
<trigger_action_c_direct_property> ::= "action" ":" <ws> <trigger_action_c_action_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<trigger_action_c_group_block> ::= <trigger_action_c_advanced>
  | <trigger_action_c_affected_elements>
  | <trigger_action_c_appearance>
  | <trigger_action_c_client_side_condition>
  | <trigger_action_c_comments>
  | <trigger_action_c_config>
  | <trigger_action_c_execution>
  | <trigger_action_c_file_handling>
  | <trigger_action_c_gen_ai>
  | <trigger_action_c_initial_prompt>
  | <trigger_action_c_input_value>
  | <trigger_action_c_quick_actions>
  | <trigger_action_c_security>
  | <trigger_action_c_server_side_condition>
  | <trigger_action_c_settings>
  | <trigger_action_c_source>
  | <trigger_action_c_use_response>
<trigger_action_c_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <trigger_action_c_advanced_property_line> } <indent> "}" <line_end>
<trigger_action_c_advanced_property_line> ::= <indent> <trigger_action_c_advanced_property> <line_end>
<trigger_action_c_advanced_property> ::= "initJavaScriptFunction" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports INIT_JAVASCRIPT_CODE *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<trigger_action_c_affected_elements> ::= <indent> "affectedElements" <ws> "{" <line_end> { <trigger_action_c_affected_elements_property_line> } <indent> "}" <line_end>
<trigger_action_c_affected_elements_property_line> ::= <indent> <trigger_action_c_affected_elements_property> <line_end>
<trigger_action_c_affected_elements_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when action supports ITEM and selectionType = button or action supports BUTTON and selectionType = button or action supports REGION and selectionType = button or other dependency conditions are satisfied; dynamic values omitted *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = items or action supports BUTTON and selectionType = items or action supports REGION and selectionType = items or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = javaScriptExpression or action supports BUTTON and selectionType = javaScriptExpression or action supports REGION and selectionType = javaScriptExpression or other dependency conditions are satisfied *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = jquerySelector or action supports BUTTON and selectionType = jquerySelector or action supports REGION and selectionType = jquerySelector or other dependency conditions are satisfied *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when action supports ITEM and selectionType = region or action supports BUTTON and selectionType = region or action supports REGION and selectionType = region or other dependency conditions are satisfied; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jquerySelector" | "javaScriptExpression" | "triggeringElement" | "eventSource" ) (* conditional; data type: string; lov: STATIC; applies when action supports ITEM or action supports BUTTON or action supports REGION or other dependency conditions are satisfied *)
<trigger_action_c_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <trigger_action_c_appearance_property_line> } <indent> "}" <line_end>
<trigger_action_c_appearance_property_line> ::= <indent> <trigger_action_c_appearance_property> <line_end>
<trigger_action_c_appearance_property> ::= "containerSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when display_as = INLINE *)
  | "displayAs" ":" <ws> ( "dialog" | "inline" ) (* required; data type: string; lov: STATIC *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as = DIALOG *)
<trigger_action_c_client_side_condition> ::= <indent> "clientSideCondition" <ws> "{" <line_end> { <trigger_action_c_client_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_c_client_side_condition_property_line> ::= <indent> <trigger_action_c_client_side_condition_property> <line_end>
<trigger_action_c_client_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInList) or type in (itemIsNotInList) *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* data type: string; lov: STATIC *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
<trigger_action_c_comments> ::= <indent> "comments" <ws> "{" <line_end> { <trigger_action_c_comments_property_line> } <indent> "}" <line_end>
<trigger_action_c_comments_property_line> ::= <indent> <trigger_action_c_comments_property> <line_end>
<trigger_action_c_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<trigger_action_c_config> ::= <indent> "config" <ws> "{" <line_end> { <trigger_action_c_config_property_line> } <indent> "}" <line_end>
<trigger_action_c_config_property_line> ::= <indent> <trigger_action_c_config_property> <line_end>
<trigger_action_c_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<trigger_action_c_execution> ::= <indent> "execution" <ws> "{" <line_end> { <trigger_action_c_execution_property_line> } <indent> "}" <line_end>
<trigger_action_c_execution_property_line> ::= <indent> <trigger_action_c_execution_property> <line_end>
<trigger_action_c_execution_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports STOP_EXECUTION_ON_ERROR *)
  | "waitForResult" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports WAIT_FOR_RESULT *)
<trigger_action_c_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <trigger_action_c_file_handling_property_line> } <indent> "}" <line_end>
<trigger_action_c_file_handling_property_line> ::= <indent> <trigger_action_c_file_handling_property> <line_end>
<trigger_action_c_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
  | "viewFileAs" ":" <ws> ( "inline" | "attachment" ) (* required; conditional; data type: string; lov: STATIC; applies when multiple_files = N *)
<trigger_action_c_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <trigger_action_c_gen_ai_property_line> } <indent> "}" <line_end>
<trigger_action_c_gen_ai_property_line> ::= <indent> <trigger_action_c_gen_ai_property> <line_end>
<trigger_action_c_gen_ai_property> ::= "agent" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: aiAgent; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "enabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports AI_ENABLED *)
  | "itemsToSubmit" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true *)
  | "service" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: genAIService; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "systemPrompt" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED and enabled = true *)
  | "welcomeMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_UI and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_UI and action supports AI_ENABLED and enabled = true *)
<trigger_action_c_initial_prompt> ::= <indent> "initialPrompt" <ws> "{" <line_end> { <trigger_action_c_initial_prompt_property_line> } <indent> "}" <line_end>
<trigger_action_c_initial_prompt_property_line> ::= <indent> <trigger_action_c_initial_prompt_property> <line_end>
<trigger_action_c_initial_prompt_property> ::= "displayedMessage" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "immediateActionPrompt" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = JAVASCRIPT_EXPRESSION *)
  | "type" ":" <ws> ( "item" | "jsExpression" ) (* data type: string; lov: STATIC *)
<trigger_action_c_input_value> ::= <indent> "inputValue" <ws> "{" <line_end> { <trigger_action_c_input_value_property_line> } <indent> "}" <line_end>
<trigger_action_c_input_value_property_line> ::= <indent> <trigger_action_c_input_value_property> <line_end>
<trigger_action_c_input_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = JAVASCRIPT *)
  | "type" ":" <ws> ( "jsCode" | "item" | "onlySystemPrompt" ) (* required; data type: string; lov: STATIC *)
<trigger_action_c_quick_actions> ::= <indent> "quickActions" <ws> "{" <line_end> { <trigger_action_c_quick_actions_property_line> } <indent> "}" <line_end>
<trigger_action_c_quick_actions_property_line> ::= <indent> <trigger_action_c_quick_actions_property> <line_end>
<trigger_action_c_quick_actions_property> ::= "message1" ":" <ws> <string_like_value> (* data type: string *)
  | "message2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when quick_action_message1 is set *)
<trigger_action_c_security> ::= <indent> "security" <ws> "{" <line_end> { <trigger_action_c_security_property_line> } <indent> "}" <line_end>
<trigger_action_c_security_property_line> ::= <indent> <trigger_action_c_security_property> <line_end>
<trigger_action_c_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<trigger_action_c_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <trigger_action_c_server_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_c_server_side_condition_property_line> ::= <indent> <trigger_action_c_server_side_condition_property> <line_end>
<trigger_action_c_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<trigger_action_c_settings> ::= <indent> "settings" <ws> "{" <line_end> { <trigger_action_c_settings_property_line> } <indent> "}" <line_end>
<trigger_action_c_settings_property_line> ::= <indent> <trigger_action_c_settings_property> <line_end>
<trigger_action_c_settings_property> ::= "action" ":" <ws> ( "subscription" | "aggregate" | "flashback" | "filters" | "columns" | "compute" | "pivot" | "controlBreak" | "download" | "groupBy" | "saveReport" | "sort" | "chart" | "highlight" ) (* required; data type: string; lov: STATIC *)
  | "cancelLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "class" ":" <ws> <string_like_value> (* required; data type: string *)
  | "clearErrors" ":" <ws> <boolean> (* required; data type: boolean *)
  | "confirmLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "cssClasses" ":" <ws> <string_like_value> (* data type: string *)
  | "enableHighAccuracy" ":" <ws> <boolean> (* required; data type: boolean *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (SQL_STATEMENT) or type in (PLSQL_EXPRESSION) or type in (FUNCTION_BODY) *)
  | "filePassword" ":" <ws> <string_like_value> (* data type: string *)
  | "fileSource" ":" <ws> ( "sqlQuery" | "fileUrls" ) (* required; conditional; data type: string; lov: STATIC; applies when share_type = files *)
  | "fileUrls" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = file_url *)
  | "filename" ":" <ws> <string_like_value> (* data type: string *)
  | "hidePageItemsOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = geojson *)
  | "itemsToReturn" ":" <ws> <string_like_value> (* data type: string *)
  | "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "jsCode" ":" <ws> <string_like_value> (* required; data type: string *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = JAVASCRIPT_EXPRESSION *)
  | "jsFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = javascript_code *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; data type: string; lov: STATIC *)
  | "latitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "longitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "maintainPagination" ":" <ws> <boolean> (* required; data type: boolean *)
  | "message" ":" <ws> <string_like_value> (* required; data type: string *)
  | "okLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = PLSQL *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY *)
  | "reportQuery" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: reportQuery; dynamic values omitted *)
  | "requestButtonName" ":" <ws> <string_like_value> (* data type: string *)
  | "returnItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = DIALOG_RETURN_ITEM *)
  | "returnType" ":" <ws> ( "jsFunction" | "latitudeAndLongitude" | "geojson" ) (* required; data type: string; lov: STATIC *)
  | "showAllOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "showProcessing" ":" <ws> <boolean> (* required; data type: boolean *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = sql_query *)
  | "style" ":" <ws> ( "information" | "danger" | "warning" | "success" ) (* data type: string; lov: STATIC *)
  | "styleName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when items_to_return is set *)
  | "text" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "url" | "currentPage" | "files" ) (* required; data type: string; lov: STATIC *)
  | "type" ":" <ws> ( "plsqlExpression" | "dialogReturnItem" | "static" | "plsqlFunctionBody" | "sqlQuery" | "jsExpression" ) (* required; data type: string; lov: STATIC *)
  | "url" ":" <ws> <value> (* required; conditional; data type: complex; applies when share_type = url *)
  | "value" ":" <ws> <string_like_value> (* data type: string *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; data type: string; lov: STATIC *)
