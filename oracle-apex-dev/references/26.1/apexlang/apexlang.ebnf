  | "welcomeMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports AI_UI and type supports AI_ENABLED_ALWAYS and type supports AI_ENABLED and enabled = true or type supports AI_UI and type supports AI_ENABLED and enabled = true *)
