  | "sequence" ":" <ws> <number> (* required; data type: number *)
<custom_attribute_builder> ::= <indent> "builder" <ws> "{" <line_end> { <custom_attribute_builder_property_line> } <indent> "}" <line_end>
<custom_attribute_builder_property_line> ::= <indent> <custom_attribute_builder_property> <line_end>
<custom_attribute_builder_property> ::= "common" ":" <ws> <boolean> (* required; data type: boolean *)
  | "displayWidth" ":" <ws> <number> (* conditional; data type: number; applies when type in (text) or type in (textarea) or type in (number) or other dependency conditions are satisfied *)
  | "includeColumnsInItemsPicker" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (region) and type in (text) or type in (region) and type in (textarea) or type in (region) and type in (html) or other dependency conditions are satisfied *)
  | "showInWizard" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
  | "translatable" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (text) or type in (textarea) or type in (html) or other dependency conditions are satisfied *)
  | "unit" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (text) or type in (number) or type in (integer) *)
<custom_attribute_comments> ::= <indent> "comments" <ws> "{" <line_end> { <custom_attribute_comments_property_line> } <indent> "}" <line_end>
<custom_attribute_comments_property_line> ::= <indent> <custom_attribute_comments_property> <line_end>
<custom_attribute_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
