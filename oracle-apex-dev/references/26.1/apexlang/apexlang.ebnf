  | "text" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "url" | "currentPage" | "files" ) (* required; data type: string; lov: STATIC *)
