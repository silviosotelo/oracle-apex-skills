  | "localTableOwner" ":" <ws> <string_like_value> (* data type: string *)
  | "nestedRows" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: dataProfileColumn; applies when localTableName is set; dynamic values omitted *)
  | "schedule" ":" <ws> <multiline_string> (* conditional; data type: string; applies when localTableName is set *)
  | "type" ":" <ws> ( "append" | "merge" | "fullRefreshDelete" | "fullRefreshTruncate" ) (* required; conditional; data type: string; lov: STATIC; applies when localTableName is set *)
