<layer_local_post_processing_property_line> ::= <indent> <layer_local_post_processing_property> <line_end>
<layer_local_post_processing_property> ::= "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when location = jsonDualityView and jsonDualityView is set and type = plsqlFunctionBody and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when location = jsonSource and jsonSource is set and type = plsqlFunctionBody and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when location = restSource and restSource is set and type = plsqlFunctionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when location = jsonDualityView and jsonDualityView is set and type = plsqlFunctionBody *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when location = jsonSource and jsonSource is set and type = plsqlFunctionBody *)
