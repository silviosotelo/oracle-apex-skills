  | "name" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = collectionClob or name supports IN_OUT_PARAMETER and type = collectionClob or name supports IN_OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = interactiveGrid and enabled = true and ignoreOutput = false and type = collectionClob or other dependency conditions are satisfied *)
