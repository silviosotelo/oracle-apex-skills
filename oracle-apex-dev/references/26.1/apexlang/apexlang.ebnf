<plugin_default_slots> ::= <indent> "defaultSlots" <ws> "{" <line_end> { <plugin_default_slots_property_line> } <indent> "}" <line_end>
<plugin_default_slots_property_line> ::= <indent> <plugin_default_slots_property> <line_end>
<plugin_default_slots_property> ::= "buttons" ":" <ws> <string_like_value> (* conditional; data type: string; lov: SLOTS; applies when type = templateComponent *)
