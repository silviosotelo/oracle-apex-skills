<action_e_appearance_property_line> ::= <indent> <action_e_appearance_property> <line_end>
<action_e_appearance_property> ::= "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when position supports TEMPLATE and template supports CSS_CLASSES or position supports TMPL_CSS_CLASSES *)
  | "displayType" ":" <ws> ( "text" | "icon" | "textWithIcon" ) (* required; conditional; data type: string; lov: STATIC; applies when position supports TEMPLATE and template supports ICON_CLASSES or position supports TMPL_ICON_CLASSES *)
  | "hot" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when position supports TEMPLATE and template supports IS_HOT or position supports TMPL_IS_HOT *)
  | "icon" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when position supports TEMPLATE and template supports ICON_CLASSES and displayType in (icon) or position supports TEMPLATE and template supports ICON_CLASSES and displayType in (textWithIcon) or position supports TMPL_ICON_CLASSES and displayType in (icon) or other dependency conditions are satisfied *)
  | "showAsDisabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when position supports TEMPLATE and template supports IS_DISABLED or position supports TMPL_IS_DISABLED *)
<action_e_behavior> ::= <indent> "behavior" <ws> "{" <line_end> { <action_e_behavior_property_line> } <indent> "}" <line_end>
<action_e_behavior_property_line> ::= <indent> <action_e_behavior_property> <line_end>
<action_e_behavior_property> ::= "linkAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when position supports TEMPLATE and template supports LINK_URL and type in (redirectThisApp) and template supports LINK_ATTR or position supports TEMPLATE and template supports LINK_URL and type in (redirectThisApp) and position supports LINK or position supports TEMPLATE and template supports LINK_URL and type in (redirectThisApp) and position supports TMPL_LINK_ATTR or other dependency conditions are satisfied *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when position supports TEMPLATE and template supports LINK_URL and type = redirectThisApp or position supports LINK and type = redirectThisApp or position supports TMPL_LINK_URL and type = redirectThisApp *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when position supports TEMPLATE and template supports LINK_URL and type = redirectOtherApp or position supports LINK and type = redirectOtherApp or position supports TMPL_LINK_URL and type = redirectOtherApp *)
  | "targetUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when position supports TEMPLATE and template supports LINK_URL and type = redirectUrl or position supports LINK and type = redirectUrl or position supports TMPL_LINK_URL and type = redirectUrl *)
  | "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "triggerAction" ) (* required; conditional; data type: string; lov: STATIC; applies when position supports TEMPLATE and template supports LINK_URL or position supports LINK or position supports TMPL_LINK_URL *)
<action_e_comments> ::= <indent> "comments" <ws> "{" <line_end> { <action_e_comments_property_line> } <indent> "}" <line_end>
<action_e_comments_property_line> ::= <indent> <action_e_comments_property> <line_end>
