(* Component productions *)

(* app *)
(* direct properties use default group: identification *)
<app> ::= "app" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <app_body_line> } <indent> ")" <line_end>
<app_body_line> ::= <app_direct_property_line>
  | <app_group_block>
  | <app_child_component>
<app_direct_property_line> ::= <indent> <app_direct_property> <line_end>
<app_direct_property> ::= "alias" ":" <ws> <string_like_value> (* required; data type: string *)
  | "group" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: appGroup; dynamic values omitted *)
  | "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> ( "standard" | "library" | "boilerplate" | "theme" ) (* required; data type: string; lov: STATIC *)
  | "version" ":" <ws> <string_like_value> (* required; data type: string *)
<app_group_block> ::= <app_advanced>
  | <app_app_format_masks>
  | <app_authentication>
  | <app_authorization>
  | <app_availability>
  | <app_char_value_comparison>
  | <app_comments>
  | <app_css>
  | <app_custom_service_worker>
  | <app_database_session>
  | <app_error_handling>
  | <app_file_storage>
  | <app_gen_ai>
  | <app_globalization>
  | <app_java_script>
  | <app_logo>
  | <app_navigation>
  | <app_navigation_bar>
  | <app_navigation_menu>
  | <app_progressive_web_app>
  | <app_proxy>
  | <app_report_printing>
  | <app_row_search>
  | <app_runtime>
  | <app_security>
  | <app_session_management>
  | <app_session_state_protection>
  | <app_static_files>
  | <app_user_interface>
<app_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <app_advanced_property_line> } <indent> "}" <line_end>
<app_advanced_property_line> ::= <indent> <app_advanced_property> <line_end>
<app_advanced_property> ::= "appBuilderIconName" ":" <ws> <string_like_value> (* data type: string *)
  | "copyrightBanner" ":" <ws> <multiline_string> (* data type: string *)
  | "emailFromAddress" ":" <ws> <string_like_value> (* data type: string *)
  | "exactSubstitutions" ":" <ws> <boolean> (* data type: boolean *)
  | "faviconHtml" ":" <ws> <multiline_string> (* data type: string *)
  | "maxBackgroundPageProcessJobs" ":" <ws> <number> (* data type: integer *)
  | "mediaType" ":" <ws> <string_like_value> (* data type: string *)
  | "modernizeApp" ":" <ws> <boolean> (* required; data type: boolean *)
  | "opentelemetryProductFamily" ":" <ws> <string_like_value> (* data type: string *)
  | "passEcid" ":" <ws> <boolean> (* required; data type: boolean *)
  | "vacationRuleProcedureName" ":" <ws> <string_like_value> (* data type: string *)
<app_app_format_masks> ::= <indent> "appFormatMasks" <ws> "{" <line_end> { <app_app_format_masks_property_line> } <indent> "}" <line_end>
<app_app_format_masks_property_line> ::= <indent> <app_app_format_masks_property> <line_end>
<app_app_format_masks_property> ::= "date" ":" <ws> <string_like_value> (* data type: string *)
  | "dateTime" ":" <ws> <string_like_value> (* data type: string *)
  | "timestamp" ":" <ws> <string_like_value> (* data type: string *)
  | "timestampTimeZone" ":" <ws> <string_like_value> (* data type: string *)
<app_authentication> ::= <indent> "authentication" <ws> "{" <line_end> { <app_authentication_property_line> } <indent> "}" <line_end>
<app_authentication_property_line> ::= <indent> <app_authentication_property> <line_end>
<app_authentication_property> ::= "configProcedureName" ":" <ws> <string_like_value> (* data type: string *)
  | "publicUser" ":" <ws> <string_like_value> (* data type: string *)
  | "scheme" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: authentication; dynamic values omitted *)
<app_authorization> ::= <indent> "authorization" <ws> "{" <line_end> { <app_authorization_property_line> } <indent> "}" <line_end>
<app_authorization_property_line> ::= <indent> <app_authorization_property> <line_end>
<app_authorization_property> ::= "runOnBackgroundJob" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when scheme is set *)
  | "runOnPublicPages" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
  | "scheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
  | "sourceForRoleOrGroupSchemes" ":" <ws> ( "accessControlUserRoleAssignments" | "authenticationScheme" | "customCode" ) (* required; data type: string; lov: STATIC *)
<app_availability> ::= <indent> "availability" <ws> "{" <line_end> { <app_availability_property_line> } <indent> "}" <line_end>
<app_availability_property_line> ::= <indent> <app_availability_property> <line_end>
<app_availability_property> ::= "buildStatus" ":" <ws> ( "runOnly" | "runAndBuild" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (standard) or type in (boilerplate) *)
  | "globalNotificationMessage" ":" <ws> <multiline_string> (* data type: string *)
  | "message" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when status in (unavailable) or status in (unavailableStatusShownWithPlsql) or status in (unavailableRedirectToUrl) *)
  | "restrictUserList" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when status = restricted *)
  | "status" ":" <ws> ( "available" | "availableWithDevToolbar" | "availableDevsOnly" | "restricted" | "unavailable" | "unavailableStatusShownWithPlsql" | "unavailableRedirectToUrl" ) (* required; data type: string; lov: STATIC *)
<app_char_value_comparison> ::= <indent> "charValueComparison" <ws> "{" <line_end> { <app_char_value_comparison_property_line> } <indent> "}" <line_end>
<app_char_value_comparison_property_line> ::= <indent> <app_char_value_comparison_property> <line_end>
<app_char_value_comparison_property> ::= "behavior" ":" <ws> ( "binary" | "linguistic" ) (* data type: string; lov: STATIC *)
  | "mode" ":" <ws> <string_like_value> (* data type: string *)
<app_comments> ::= <indent> "comments" <ws> "{" <line_end> { <app_comments_property_line> } <indent> "}" <line_end>
<app_comments_property_line> ::= <indent> <app_comments_property> <line_end>
<app_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<app_css> ::= <indent> "css" <ws> "{" <line_end> { <app_css_property_line> } <indent> "}" <line_end>
<app_css_property_line> ::= <indent> <app_css_property> <line_end>
<app_css_property> ::= "fileUrls" ":" <ws> <array_of_string_like_value> (* data type: string *)
<app_custom_service_worker> ::= <indent> "customServiceWorker" <ws> "{" <line_end> { <app_custom_service_worker_property_line> } <indent> "}" <line_end>
<app_custom_service_worker_property_line> ::= <indent> <app_custom_service_worker_property> <line_end>
<app_custom_service_worker_property> ::= "activateMode" ":" <ws> ( "default" | "custom" | "hook" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "canMakePaymentMode" ":" <ws> ( "default" | "custom" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "evenCanMakePayment" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and canMakePaymentMode = custom *)
  | "evenNotificationClickAfter" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and notificationClickMode = hook *)
  | "evenNotificationClickBefore" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and notificationClickMode = hook *)
  | "evenNotificationClose" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and notificationCloseMode = custom *)
  | "evenPaymentRequest" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and paymentRequestMode = custom *)
  | "eventActivate" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and activateMode = custom *)
  | "eventActivateAfter" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and activateMode = hook *)
  | "eventActivateBefore" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and activateMode = hook *)
  | "eventFetch" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and fetchMode = custom *)
  | "eventFetchBefore" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and fetchMode = hook *)
  | "eventFetchCacheDefinition" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and fetchMode = hook *)
  | "eventFetchCacheResponse" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and fetchMode = hook *)
  | "eventFetchNetworkFallback" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and fetchMode = hook *)
  | "eventFetchNetworkResponseError" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and fetchMode = hook *)
  | "eventFetchNetworkResponseSuccess" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and fetchMode = hook *)
  | "eventFetchOfflinePage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and fetchMode = hook *)
  | "eventInstall" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and installMode = custom *)
  | "eventInstallAfter" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and installMode = hook *)
  | "eventInstallBefore" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and installMode = hook *)
  | "eventNotificationClick" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and notificationClickMode = custom *)
  | "eventPush" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and pushMode = custom *)
  | "eventPushAfter" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and pushMode = hook *)
  | "eventPushBefore" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and pushMode = hook *)
  | "eventSync" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and syncMode = custom *)
  | "fetchMode" ":" <ws> ( "default" | "custom" | "hook" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "functionVariableDeclaration" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and mode = custom and functionVariableDeclarationMode = hook *)
  | "functionVariableDeclarationMode" ":" <ws> ( "default" | "hook" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "installMode" ":" <ws> ( "default" | "custom" | "hook" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "mode" ":" <ws> ( "default" | "custom" | "url" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true *)
  | "notificationClickMode" ":" <ws> ( "default" | "custom" | "hook" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "notificationCloseMode" ":" <ws> ( "default" | "custom" | "hook" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "paymentRequestMode" ":" <ws> ( "default" | "custom" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "pushMode" ":" <ws> ( "default" | "custom" | "hook" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "syncMode" ":" <ws> ( "default" | "custom" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and mode = custom *)
  | "url" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when enable = true and mode = url *)
<app_database_session> ::= <indent> "databaseSession" <ws> "{" <line_end> { <app_database_session_property_line> } <indent> "}" <line_end>
<app_database_session_property_line> ::= <indent> <app_database_session_property> <line_end>
<app_database_session_property> ::= "cleanupPlsqlCode" ":" <ws> <multiline_string> (* data type: string *)
  | "initPlsqlCode" ":" <ws> <multiline_string> (* data type: string *)
  | "mleEnvironment" ":" <ws> <string_like_value> (* data type: string *)
  | "parsingSchema" ":" <ws> <string_like_value> (* data type: string *)
<app_error_handling> ::= <indent> "errorHandling" <ws> "{" <line_end> { <app_error_handling_property_line> } <indent> "}" <line_end>
<app_error_handling_property_line> ::= <indent> <app_error_handling_property> <line_end>
<app_error_handling_property> ::= "defaultDisplayLocation" ":" <ws> ( "inlineWithFieldAndInNotification" | "inlineWithField" | "inlineInNotification" ) (* required; data type: string; lov: STATIC *)
  | "errorHandlingFunctionName" ":" <ws> <string_like_value> (* data type: string *)
<app_file_storage> ::= <indent> "fileStorage" <ws> "{" <line_end> { <app_file_storage_property_line> } <indent> "}" <line_end>
<app_file_storage_property_line> ::= <indent> <app_file_storage_property> <line_end>
<app_file_storage_property> ::= "fileServer" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: fileServer; applies when type = objectStorage; dynamic values omitted *)
  | "type" ":" <ws> ( "database" | "objectStorage" ) (* required; data type: string; lov: STATIC *)
<app_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <app_gen_ai_property_line> } <indent> "}" <line_end>
<app_gen_ai_property_line> ::= <indent> <app_gen_ai_property> <line_end>
<app_gen_ai_property> ::= "aiConsentMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when service is set *)
  | "requestHandlerProcedure" ":" <ws> <string_like_value> (* data type: string *)
  | "responseHandlerProcedure" ":" <ws> <string_like_value> (* data type: string *)
  | "service" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: genAIService; dynamic values omitted *)
<app_globalization> ::= <indent> "globalization" <ws> "{" <line_end> { <app_globalization_property_line> } <indent> "}" <line_end>
<app_globalization_property_line> ::= <indent> <app_globalization_property> <line_end>
<app_globalization_property> ::= "autoCsvEncoding" ":" <ws> <boolean> (* required; data type: boolean *)
  | "autoTimeZone" ":" <ws> <boolean> (* required; data type: boolean *)
  | "documentDirection" ":" <ws> ( "leftToRight" | "rightToLeft" ) (* data type: string; lov: STATIC *)
  | "languageDerivedFrom" ":" <ws> ( "notTranslated" | "appPrimaryLanguage" | "browserPreference" | "appPreference" | "itemPreference" | "session" ) (* required; data type: string; lov: STATIC *)
  | "primaryLanguage" ":" <ws> <string_like_value> (* required; data type: string; lov: STATIC; dynamic values omitted *)
  | "translationMethod" ":" <ws> ( "translationApps" | "textMessages" ) (* data type: string; lov: STATIC *)
<app_java_script> ::= <indent> "javaScript" <ws> "{" <line_end> { <app_java_script_property_line> } <indent> "}" <line_end>
<app_java_script_property_line> ::= <indent> <app_java_script_property> <line_end>
<app_java_script_property> ::= "fileUrls" ":" <ws> <array_of_string_like_value> (* data type: string *)
  | "includeJqueryMigrate" ":" <ws> <boolean> (* required; data type: boolean *)
  | "includeLegacyJavascript" ":" <ws> <array_of_string_like_value> (* data type: string; lov: STATIC *)
<app_logo> ::= <indent> "logo" <ws> "{" <line_end> { <app_logo_property_line> } <indent> "}" <line_end>
<app_logo_property_line> ::= <indent> <app_logo_property> <line_end>
<app_logo_property> ::= "customHtml" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = custom *)
  | "imageUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (image) or type in (imageAndText) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (text) or type in (imageAndText) *)
  | "type" ":" <ws> ( "image" | "text" | "imageAndText" | "custom" ) (* data type: string; lov: STATIC *)
<app_navigation> ::= <indent> "navigation" <ws> "{" <line_end> { <app_navigation_property_line> } <indent> "}" <line_end>
<app_navigation_property_line> ::= <indent> <app_navigation_property> <line_end>
<app_navigation_property> ::= "homeUrl" ":" <ws> <value> (* required; data type: complex *)
  | "loginUrl" ":" <ws> <value> (* data type: complex *)
<app_navigation_bar> ::= <indent> "navigationBar" <ws> "{" <line_end> { <app_navigation_bar_property_line> } <indent> "}" <line_end>
<app_navigation_bar_property_line> ::= <indent> <app_navigation_bar_property> <line_end>
<app_navigation_bar_property> ::= "implementation" ":" <ws> ( "classic" | "list" ) (* required; data type: string; lov: STATIC *)
  | "list" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: list; applies when implementation = list; dynamic values omitted *)
  | "listTemplate" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: listTemplate; applies when implementation = list; dynamic values omitted *)
  | "templateOptions" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: TEMPLATE_OPTIONS; applies when implementation = list and listTemplate is set *)
<app_navigation_menu> ::= <indent> "navigationMenu" <ws> "{" <line_end> { <app_navigation_menu_property_line> } <indent> "}" <line_end>
<app_navigation_menu_property_line> ::= <indent> <app_navigation_menu_property> <line_end>
<app_navigation_menu_property> ::= "list" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: list; applies when listTemplate is set; dynamic values omitted *)
  | "listPosition" ":" <ws> ( "top" | "side" ) (* required; conditional; data type: string; lov: STATIC; applies when listTemplate is set *)
  | "listTemplate" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: listTemplate; dynamic values omitted *)
  | "templateOptions" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: TEMPLATE_OPTIONS; applies when listTemplate is set *)
<app_progressive_web_app> ::= <indent> "progressiveWebApp" <ws> "{" <line_end> { <app_progressive_web_app_property_line> } <indent> "}" <line_end>
<app_progressive_web_app_property_line> ::= <indent> <app_progressive_web_app_property> <line_end>
<app_progressive_web_app_property> ::= "appDescription" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and installable = true *)
  | "appShortName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when enable = true *)
  | "backgroundColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when enable = true and installable = true *)
  | "contactEmail" ":" <ws> <string_like_value> (* conditional; data type: string; applies when enable = true and enablePushNotifications = true *)
  | "customManifest" ":" <ws> <multiline_string> (* conditional; data type: string; applies when enable = true and installable = true *)
  | "display" ":" <ws> ( "fullscreen" | "standalone" | "minimalUI" | "browser" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and installable = true *)
  | "enable" ":" <ws> <boolean> (* required; data type: boolean *)
  | "enablePushNotifications" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when enable = true *)
  | "installable" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when enable = true *)
  | "manifestIconUrl" ":" <ws> <string_like_value> (* conditional; data type: string; applies when enable = true *)
  | "pushNotificationsCredentials" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: webCredential; applies when enable = true and enablePushNotifications = true; dynamic values omitted *)
  | "screenOrientation" ":" <ws> ( "any" | "natural" | "landscape" | "landscapePrimary" | "landscapeSecondary" | "portrait" | "portraitPrimary" | "portraitSecondary" ) (* required; conditional; data type: string; lov: STATIC; applies when enable = true and installable = true *)
  | "themeColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when enable = true and installable = true *)
<app_proxy> ::= <indent> "proxy" <ws> "{" <line_end> { <app_proxy_property_line> } <indent> "}" <line_end>
<app_proxy_property_line> ::= <indent> <app_proxy_property> <line_end>
<app_proxy_property> ::= "noProxyDomains" ":" <ws> <string_like_value> (* conditional; data type: string; applies when proxyServer is set *)
  | "proxyServer" ":" <ws> <string_like_value> (* data type: string *)
<app_report_printing> ::= <indent> "reportPrinting" <ws> "{" <line_end> { <app_report_printing_property_line> } <indent> "}" <line_end>
<app_report_printing_property_line> ::= <indent> <app_report_printing_property> <line_end>
<app_report_printing_property> ::= "credentials" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: webCredential; applies when type = remote; dynamic values omitted *)
  | "remotePrintServer" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: printServer; applies when type = remote; dynamic values omitted *)
  | "type" ":" <ws> ( "native" | "remote" | "useInstanceSettings" ) (* required; data type: string; lov: STATIC *)
<app_row_search> ::= <indent> "rowSearch" <ws> "{" <line_end> { <app_row_search_property_line> } <indent> "}" <line_end>
<app_row_search_property_line> ::= <indent> <app_row_search_property> <line_end>
<app_row_search_property> ::= "customFunctionName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when textQueryFunction = custom *)
  | "textQueryFunction" ":" <ws> ( "searchEngine" | "expertSearch" | "custom" ) (* data type: string; lov: STATIC *)
  | "tokenize" ":" <ws> <boolean> (* required; data type: boolean *)
<app_runtime> ::= <indent> "runtime" <ws> "{" <line_end> { <app_runtime_property_line> } <indent> "}" <line_end>
<app_runtime_property_line> ::= <indent> <app_runtime_property> <line_end>
<app_runtime_property> ::= "accessibleReadOnlyItems" ":" <ws> <boolean> (* required; data type: boolean *)
  | "allowFeedback" ":" <ws> <boolean> (* required; data type: boolean *)
  | "compatibilityMode" ":" <ws> ( "26.1" | "24.2" | "21.2" | "19.2-20.1-20.2-21.1" | "19.1" | "5.1-18.1-18.2" | "5.0" | "4.2" | "4.1" | "4.0" ) (* required; data type: string; lov: STATIC *)
  | "debugging" ":" <ws> <boolean> (* required; data type: boolean *)
  | "friendlyUrls" ":" <ws> <boolean> (* required; data type: boolean *)
  | "logging" ":" <ws> <boolean> (* required; data type: boolean *)
<app_security> ::= <indent> "security" <ws> "{" <line_end> { <app_security_property_line> } <indent> "}" <line_end>
<app_security_property_line> ::= <indent> <app_security_property> <line_end>
<app_security_property> ::= "browserCache" ":" <ws> ( "true" | "false" ) (* required; conditional; data type: string; lov: STATIC *)
  | "deepLinking" ":" <ws> ( "true" | "false" ) (* required; data type: string; lov: STATIC *)
  | "embedInFrames" ":" <ws> ( "deny" | "allowSameOrigin" | "allow" ) (* required; conditional; data type: string; lov: STATIC *)
  | "enableDictation" ":" <ws> <boolean> (* required; data type: boolean *)
  | "htmlEscapingMode" ":" <ws> ( "basic" | "extended" ) (* required; data type: string; lov: STATIC *)
  | "httpResponseHeaders" ":" <ws> <multiline_string> (* data type: string *)
  | "referrerPolicy" ":" <ws> ( "noReferrer" | "noReferrerWhenDowngrade" | "origin" | "originWhenCrossOrigin" | "sameOrigin" | "strictOrigin" | "strictOriginWhenCrossOrigin" | "unsafeUrl" ) (* required; data type: string; lov: STATIC *)
  | "runtimeApiUsage" ":" <ws> <array_of_string_like_value> (* data type: string; lov: STATIC *)
<app_session_management> ::= <indent> "sessionManagement" <ws> "{" <line_end> { <app_session_management_property_line> } <indent> "}" <line_end>
<app_session_management_property_line> ::= <indent> <app_session_management_property> <line_end>
<app_session_management_property> ::= "maxSessionIdleTime" ":" <ws> <number> (* data type: integer *)
  | "maxSessionLength" ":" <ws> <number> (* data type: integer *)
  | "rejoinSessions" ":" <ws> ( "false" | "publicSessions" | "allSessions" ) (* required; data type: string; lov: STATIC *)
  | "sessionIdleTimeoutUrl" ":" <ws> <string_like_value> (* data type: string *)
  | "sessionStateCommits" ":" <ws> ( "immediate" | "endOfRequest" ) (* required; data type: string; lov: STATIC *)
  | "sessionTimeoutUrl" ":" <ws> <string_like_value> (* data type: string *)
  | "sessionTimeoutWarning" ":" <ws> <number> (* data type: integer *)
<app_session_state_protection> ::= <indent> "sessionStateProtection" <ws> "{" <line_end> { <app_session_state_protection_property_line> } <indent> "}" <line_end>
<app_session_state_protection_property_line> ::= <indent> <app_session_state_protection_property> <line_end>
<app_session_state_protection_property> ::= "acceptPre202UrlChecksums" ":" <ws> <boolean> (* data type: boolean *)
  | "allowUrlsCreatedAfter" ":" <ws> <datetime_value> (* data type: datetime *)
  | "bookmarkHashFunction" ":" <ws> ( "sha1" | "sha2-256bit" | "sha2-384bit" | "sha2-512bit" | "md5" ) (* required; data type: string; lov: STATIC *)
  | "checksumSalt" ":" <ws> <string_like_value> (* data type: string *)
  | "enabled" ":" <ws> <boolean> (* required; data type: boolean *)
<app_static_files> ::= <indent> "staticFiles" <ws> "{" <line_end> { <app_static_files_property_line> } <indent> "}" <line_end>
<app_static_files_property_line> ::= <indent> <app_static_files_property> <line_end>
<app_static_files_property> ::= "apexFilesPath" ":" <ws> <string_like_value> (* data type: string *)
  | "appFilesPath" ":" <ws> <string_like_value> (* data type: string *)
<app_user_interface> ::= <indent> "userInterface" <ws> "{" <line_end> { <app_user_interface_property_line> } <indent> "}" <line_end>
<app_user_interface_property_line> ::= <indent> <app_user_interface_property> <line_end>
<app_user_interface_property> ::= "addBuiltWithApexToFooter" ":" <ws> <boolean> (* required; data type: boolean *)
  | "autoDismissSuccessMessages" ":" <ws> <boolean> (* required; data type: boolean *)
  | "currentTheme" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: theme; dynamic values omitted *)
  | "globalPage" ":" <ws> <number> (* data type: integer *)
  | "usersCanChooseThemeStyle" ":" <ws> <boolean> (* required; data type: boolean *)
<app_child_component> ::= <ai_agent>
  | <app_computation>
  | <app_item>
  | <app_process>
  | <app_setting>
  | <authentication>
  | <authorization>
  | <automation>
  | <breadcrumb>
  | <build_option_a>
  | <classic_navigation_bar_entry>
  | <component_group>
  | <component_setting>
  | <concatenated_file>
  | <data_load_definition>
  | <developer_comment>
  | <dynamic_translation>
  | <email_template>
  | <file_c>
  | <json_duality_view>
  | <json_source>
  | <language_mapping>
  | <legacy_data_load_definition>
  | <list>
  | <lov>
  | <map_background>
  | <page>
  | <page_group>
  | <plugin>
  | <pwa_screenshot>
  | <pwa_shortcut>
  | <report_layout>
  | <report_query>
  | <rest_data_source>
  | <role>
  | <search_config>
  | <shortcut>
  | <substitution_a>
