(* layer *)
(* direct properties use default group: identification *)
<layer> ::= "layer" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <layer_body_line> } <indent> ")" <line_end>
<layer_body_line> ::= <layer_direct_property_line>
  | <layer_group_block>
  | <layer_child_component>
<layer_direct_property_line> ::= <indent> <layer_direct_property> <line_end>
<layer_direct_property> ::= "layerType" ":" <ws> ( "points" | "lines" | "polygons" | "heatMap" | "extrudedPolygons" ) (* required; data type: string; lov: STATIC *)
  | "name" ":" <ws> <string_like_value> (* required; data type: string *)
<layer_group_block> ::= <layer_advanced>
  | <layer_appearance>
  | <layer_column_mapping>
  | <layer_comments>
  | <layer_config>
  | <layer_data_profile>
  | <layer_external_filter_and_order_by>
  | <layer_info_window>
  | <layer_label>
  | <layer_layout>
  | <layer_legend>
  | <layer_link>
  | <layer_local_post_processing>
  | <layer_messages>
  | <layer_performance>
  | <layer_point_clustering>
  | <layer_point_objects>
  | <layer_remote_cache>
  | <layer_rest_synchronization>
  | <layer_row_assignment>
  | <layer_security>
  | <layer_server_side_condition>
  | <layer_source>
  | <layer_tooltip>
  | <layer_zoom_levels>
<layer_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <layer_advanced_property_line> } <indent> "}" <line_end>
<layer_advanced_property_line> ::= <indent> <layer_advanced_property> <line_end>
<layer_advanced_property> ::= "maxObjectsPerTile" ":" <ws> <number> (* conditional; data type: integer; applies when location = localDatabase and location in (localDatabase) and type in (tableView) and lazyLoading = true and useVectorTiles = true or location = localDatabase and location in (localDatabase) and type in (sqlQuery) and lazyLoading = true and useVectorTiles = true or location = localDatabase and location in (restEnabledSql) and type in (tableView) and lazyLoading = true and useVectorTiles = true or other dependency conditions are satisfied *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<layer_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <layer_appearance_property_line> } <indent> "}" <line_end>
<layer_appearance_property_line> ::= <indent> <layer_appearance_property> <line_end>
<layer_appearance_property> ::= "colorScheme" ":" <ws> ( "sequential" | "diverging" | "qualitative" ) (* conditional; data type: string; lov: STATIC; applies when layerType in (polygons) and useColorScheme = true or layerType in (extrudedPolygons) and useColorScheme = true *)
  | "colorScheme" ":" <ws> ( "sequential" | "diverging" | "qualitative" ) (* conditional; data type: string; lov: STATIC; applies when layerType = heatMap *)
  | "colorValueColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when layerType in (polygons) and useColorScheme = true or layerType in (polygons) and useColorScheme = true and layerType in (extrudedPolygons) or layerType in (polygons) and useColorScheme = true and layerType in (lines) or other dependency conditions are satisfied *)
  | "customColorList" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when layerType in (polygons) and useColorScheme = true or layerType in (polygons) and useColorScheme = true and layerType in (extrudedPolygons) or layerType in (extrudedPolygons) and useColorScheme = true and layerType in (polygons) or other dependency conditions are satisfied *)
  | "customColorList" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when layerType = heatMap *)
  | "extrusionValueColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when layerType = extrudedPolygons *)
  | "fillColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType in (polygons) and useColorScheme in (false) or layerType in (polygons) and useColorScheme in ($NULL$) or layerType in (polygons) and layerType in (extrudedPolygons) and useColorScheme in (false) or other dependency conditions are satisfied *)
  | "fillColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType = points and style = icon and iconSource in ($NULL$) or layerType = points and style = icon and iconSource in (iconClass) or layerType = points and style = icon and iconSource in (iconClassColumn) *)
  | "fillOpacity" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType in (polygons) or layerType in (extrudedPolygons) *)
  | "fillOpacity" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType = points and style = icon and iconSource in ($NULL$) or layerType = points and style = icon and iconSource in (iconClass) or layerType = points and style = icon and iconSource in (iconClassColumn) *)
  | "schemeName" ":" <ws> ( "burgundy" | "burgundyToYellow" | "redToOrange" | "orangeToYellow" | "peach" | "pinkToYellow" | "mint" | "blueToGreen" | "darkMint" | "emerald" | "blueToYellow" | "teal" | "tealToGreen" | "purple" | "purpleToOrange" | "sunset" | "magenta" | "darkSunset" | "brownToYellow" ) (* required; conditional; data type: string; lov: STATIC; applies when layerType in (polygons) and useColorScheme = true and colorScheme = sequential or layerType in (extrudedPolygons) and useColorScheme = true and colorScheme = sequential *)
  | "schemeName" ":" <ws> ( "armyToRose" | "fallColors" | "geyser" | "temps" | "tealToRose" | "tropicColors" | "earthColors" ) (* required; conditional; data type: string; lov: STATIC; applies when layerType in (polygons) and useColorScheme = true and colorScheme = diverging or layerType in (extrudedPolygons) and useColorScheme = true and colorScheme = diverging *)
  | "schemeName" ":" <ws> ( "antique" | "bold" | "pastel" | "prism" | "safe" | "vivid" ) (* required; conditional; data type: string; lov: STATIC; applies when layerType in (polygons) and useColorScheme = true and colorScheme = qualitative or layerType in (extrudedPolygons) and useColorScheme = true and colorScheme = qualitative *)
  | "schemeName" ":" <ws> ( "burgundy" | "burgundyToYellow" | "redToOrange" | "orangeToYellow" | "peach" | "pinkToYellow" | "mint" | "blueToGreen" | "darkMint" | "emerald" | "blueToYellow" | "teal" | "tealToGreen" | "purple" | "purpleToOrange" | "sunset" | "magenta" | "darkSunset" | "brownToYellow" ) (* required; conditional; data type: string; lov: STATIC; applies when layerType = heatMap and colorScheme = sequential *)
  | "schemeName" ":" <ws> ( "armyToRose" | "fallColors" | "geyser" | "temps" | "tealToRose" | "tropicColors" | "earthColors" ) (* required; conditional; data type: string; lov: STATIC; applies when layerType = heatMap and colorScheme = diverging *)
  | "schemeName" ":" <ws> ( "antique" | "bold" | "pastel" | "prism" | "safe" | "vivid" ) (* required; conditional; data type: string; lov: STATIC; applies when layerType = heatMap and colorScheme = qualitative *)
  | "strokeColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType in (polygons) or layerType in (lines) *)
  | "strokeColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType = points and style = svg and layerType in (polygons) and useColorScheme in (false) or layerType = points and style = svg and layerType in (polygons) and useColorScheme in ($NULL$) or layerType = points and style = svg and layerType in (extrudedPolygons) and useColorScheme in (false) or other dependency conditions are satisfied *)
  | "strokeStyle" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when layerType = lines *)
  | "strokeWidth" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType in (polygons) or layerType in (lines) *)
  | "strokeWidth" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType = points and style = svg and layerType in (polygons) and useColorScheme in (false) or layerType = points and style = svg and layerType in (polygons) and useColorScheme in ($NULL$) or layerType = points and style = svg and layerType in (extrudedPolygons) and useColorScheme in (false) or other dependency conditions are satisfied *)
  | "unit" ":" <ws> ( "meter" | "kilometer" | "foot" | "mile" ) (* required; conditional; data type: string; lov: STATIC; applies when layerType = extrudedPolygons and extrusionValueColumn is set *)
  | "useColorScheme" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when layerType in (polygons) or layerType in (extrudedPolygons) *)
  | "valueColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when layerType = heatMap *)
<layer_column_mapping> ::= <indent> "columnMapping" <ws> "{" <line_end> { <layer_column_mapping_property_line> } <indent> "}" <line_end>
<layer_column_mapping_property_line> ::= <indent> <layer_column_mapping_property> <line_end>
<layer_column_mapping_property> ::= "geojsonColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when geometryColumnDataType = geojson and location = restEnabledSql *)
  | "geometryColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when geometryColumnDataType = sdoGeometry *)
  | "geometryColumnDataType" ":" <ws> ( "sdoGeometry" | "geojson" | "longitudeLatitude" ) (* required; conditional; data type: string; lov: STATIC *)
  | "geometryColumnDataType" ":" <ws> ( "geojson" | "longitudeLatitude" ) (* required; conditional; data type: string; lov: STATIC; applies when location = restEnabledSql *)
  | "latitudeColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when geometryColumnDataType = longitudeLatitude and location = restEnabledSql *)
  | "longitudeColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when geometryColumnDataType = longitudeLatitude and location = restEnabledSql *)
  | "primaryKeyColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when location is set *)
<layer_comments> ::= <indent> "comments" <ws> "{" <line_end> { <layer_comments_property_line> } <indent> "}" <line_end>
<layer_comments_property_line> ::= <indent> <layer_comments_property> <line_end>
