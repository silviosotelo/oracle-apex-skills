<dynamic_action_execution_property_line> ::= <indent> <dynamic_action_execution_property> <line_end>
<dynamic_action_execution_property> ::= "eventScope" ":" <ws> ( "static" | "dynamic" | "once" ) (* required; data type: string; lov: STATIC *)
  | "immediate" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when eventScope in (static) and type in (debounce) or eventScope in (static) and type in (throttle) or eventScope in (dynamic) and type in (debounce) or other dependency conditions are satisfied *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
