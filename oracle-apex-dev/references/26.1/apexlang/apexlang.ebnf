<vector_provider_additional_data_property> ::= "attributes" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = genAIService and provider = ociGenAI *)
  | "httpHeaders" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = genAIService *)
<vector_provider_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <vector_provider_advanced_property_line> } <indent> "}" <line_end>
<vector_provider_advanced_property_line> ::= <indent> <vector_provider_advanced_property> <line_end>
<vector_provider_advanced_property> ::= "maxTokens" ":" <ws> <number> (* data type: integer *)
  | "serverTimeout" ":" <ws> <number> (* data type: integer *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<vector_provider_authentication> ::= <indent> "authentication" <ws> "{" <line_end> { <vector_provider_authentication_property_line> } <indent> "}" <line_end>
<vector_provider_authentication_property_line> ::= <indent> <vector_provider_authentication_property> <line_end>
<vector_provider_authentication_property> ::= "credentials" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: webCredential; applies when type = genAIService; dynamic values omitted *)
<vector_provider_comments> ::= <indent> "comments" <ws> "{" <line_end> { <vector_provider_comments_property_line> } <indent> "}" <line_end>
<vector_provider_comments_property_line> ::= <indent> <vector_provider_comments_property> <line_end>
<vector_provider_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<vector_provider_endpoint_url> ::= <indent> "endpointUrl" <ws> "{" <line_end> { <vector_provider_endpoint_url_property_line> } <indent> "}" <line_end>
<vector_provider_endpoint_url_property_line> ::= <indent> <vector_provider_endpoint_url_property> <line_end>
<vector_provider_endpoint_url_property> ::= "url" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = genAIService *)
<vector_provider_gen_aiservice> ::= <indent> "genAIService" <ws> "{" <line_end> { <vector_provider_gen_aiservice_property_line> } <indent> "}" <line_end>
<vector_provider_gen_aiservice_property_line> ::= <indent> <vector_provider_gen_aiservice_property> <line_end>
<vector_provider_gen_aiservice_property> ::= "modelName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = genAIService *)
  | "provider" ":" <ws> ( "ociGenAI" | "openai" | "cohere" | "googleGemini" | "genericOpenaiApiCompatible" ) (* required; conditional; data type: string; lov: STATIC; applies when type = genAIService *)
<vector_provider_local_embedding> ::= <indent> "localEmbedding" <ws> "{" <line_end> { <vector_provider_local_embedding_property_line> } <indent> "}" <line_end>
<vector_provider_local_embedding_property_line> ::= <indent> <vector_provider_local_embedding_property> <line_end>
<vector_provider_local_embedding_property> ::= "function" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = customPlsql *)
  | "modelName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = databaseOnnxModel *)
  | "owner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = databaseOnnxModel *)

(* webCredential *)
(* direct properties use default group: identification *)
<web_credential> ::= "webCredential" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <web_credential_body_line> } <indent> ")" <line_end>
<web_credential_body_line> ::= <web_credential_direct_property_line>
  | <web_credential_group_block>
<web_credential_direct_property_line> ::= <indent> <web_credential_direct_property> <line_end>
<web_credential_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> ( "basicAuthentication" | "oauth2ClientCredentialsFlow" | "oci" | "httpHeader" | "urlQueryString" | "keyPair" | "certificatePrivateKeyPair" | "oauth2PasswordFlow" | "signedUserAssertion" | "userAssertionSigningCertificate" ) (* required; data type: string; lov: STATIC *)
<web_credential_group_block> ::= <web_credential_advanced>
  | <web_credential_authentication>
  | <web_credential_comments>
<web_credential_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <web_credential_advanced_property_line> } <indent> "}" <line_end>
<web_credential_advanced_property_line> ::= <indent> <web_credential_advanced_property> <line_end>
<web_credential_advanced_property> ::= "authenticationCredential" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: webCredential; applies when type = oauth2PasswordFlow; dynamic values omitted *)
  | "namedScopes" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type in (oauth2ClientCredentialsFlow) or type in (signedUserAssertion) or type in (oauth2PasswordFlow) *)
  | "promptOnInstall" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (basicAuthentication) or type in (oauth2ClientCredentialsFlow) or type in (signedUserAssertion) or other dependency conditions are satisfied *)
  | "signingCredential" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: webCredential; applies when type = signedUserAssertion; dynamic values omitted *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
  | "tokenAuthenticationMethod" ":" <ws> ( "clientIdAndClientSecretInBody" | "basicAuthentication" | "basicAuthenticationAndClientIdInBody" | "clientIdInBody" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (oauth2ClientCredentialsFlow) or type in (oauth2PasswordFlow) *)
  | "usernameExpression" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = signedUserAssertion *)
  | "validForUrls" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type in (basicAuthentication) or type in (oauth2ClientCredentialsFlow) or type in (signedUserAssertion) or other dependency conditions are satisfied *)
<web_credential_authentication> ::= <indent> "authentication" <ws> "{" <line_end> { <web_credential_authentication_property_line> } <indent> "}" <line_end>
<web_credential_authentication_property_line> ::= <indent> <web_credential_authentication_property> <line_end>
<web_credential_authentication_property> ::= "audienceList" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = userAssertionSigningCertificate *)
  | "certificate" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type in (certificatePrivateKeyPair) or type in (userAssertionSigningCertificate) *)
  | "certificateAlias" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = userAssertionSigningCertificate *)
  | "clientIdOrUsername" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (basicAuthentication) or type in (basicAuthentication) and type in (oauth2ClientCredentialsFlow) or type in (basicAuthentication) and type in (signedUserAssertion) or other dependency conditions are satisfied *)
  | "credentialName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (httpHeader) or type in (urlQueryString) *)
  | "databaseCredentialName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (basicAuthentication) or type in (oauth2ClientCredentialsFlow) or type in (signedUserAssertion) or other dependency conditions are satisfied *)
  | "instanceLevelDatabaseCredential" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (basicAuthentication) and databaseCredentialName is set or type in (oauth2ClientCredentialsFlow) and databaseCredentialName is set or type in (signedUserAssertion) and databaseCredentialName is set or other dependency conditions are satisfied *)
  | "oauthScope" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (oauth2ClientCredentialsFlow) or type in (signedUserAssertion) or type in (oauth2PasswordFlow) *)
  | "ociPublicKeyFingerprint" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = oci *)
  | "ociTenancyId" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = oci *)
  | "ociUserId" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = oci *)
  | "publicKey" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = keyPair *)
<web_credential_comments> ::= <indent> "comments" <ws> "{" <line_end> { <web_credential_comments_property_line> } <indent> "}" <line_end>
<web_credential_comments_property_line> ::= <indent> <web_credential_comments_property> <line_end>
<web_credential_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)

(* action *)
(* direct properties use default group: identification *)
<action_d> ::= "action" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <action_d_body_line> } <indent> ")" <line_end>
<action_d_body_line> ::= <action_d_direct_property_line>
  | <action_d_group_block>
  | <action_d_child_component>
<action_d_direct_property_line> ::= <indent> <action_d_direct_property> <line_end>
<action_d_direct_property> ::= "label" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = button *)
  | "type" ":" <ws> ( "button" | "fullCard" | "title" | "subtitle" | "media" ) (* required; data type: string; lov: STATIC *)
<action_d_group_block> ::= <action_d_advanced>
  | <action_d_appearance>
  | <action_d_behavior>
  | <action_d_comments>
  | <action_d_config>
  | <action_d_layout>
  | <action_d_security>
  | <action_d_server_side_condition>
<action_d_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <action_d_advanced_property_line> } <indent> "}" <line_end>
<action_d_advanced_property_line> ::= <indent> <action_d_advanced_property> <line_end>
<action_d_advanced_property> ::= "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<action_d_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <action_d_appearance_property_line> } <indent> "}" <line_end>
<action_d_appearance_property_line> ::= <indent> <action_d_appearance_property> <line_end>
<action_d_appearance_property> ::= "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type = button *)
  | "displayType" ":" <ws> ( "text" | "icon" | "textWithIcon" ) (* required; conditional; data type: string; lov: STATIC; applies when type = button *)
  | "hot" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = button *)
  | "icon" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = button and displayType in (icon) or type = button and displayType in (textWithIcon) *)
<action_d_behavior> ::= <indent> "behavior" <ws> "{" <line_end> { <action_d_behavior_property_line> } <indent> "}" <line_end>
<action_d_behavior_property_line> ::= <indent> <action_d_behavior_property> <line_end>
<action_d_behavior_property> ::= "linkAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (redirectThisApp) or type in (redirectOtherApp) or type in (redirectUrl) *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = redirectThisApp *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = redirectOtherApp *)
  | "targetUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = redirectUrl *)
  | "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "triggerAction" ) (* required; data type: string; lov: STATIC *)
<action_d_comments> ::= <indent> "comments" <ws> "{" <line_end> { <action_d_comments_property_line> } <indent> "}" <line_end>
<action_d_comments_property_line> ::= <indent> <action_d_comments_property> <line_end>
<action_d_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<action_d_config> ::= <indent> "config" <ws> "{" <line_end> { <action_d_config_property_line> } <indent> "}" <line_end>
<action_d_config_property_line> ::= <indent> <action_d_config_property> <line_end>
<action_d_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<action_d_layout> ::= <indent> "layout" <ws> "{" <line_end> { <action_d_layout_property_line> } <indent> "}" <line_end>
<action_d_layout_property_line> ::= <indent> <action_d_layout_property> <line_end>
<action_d_layout_property> ::= "position" ":" <ws> ( "primary" | "secondary" ) (* required; conditional; data type: string; lov: STATIC; applies when type = button *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
<action_d_security> ::= <indent> "security" <ws> "{" <line_end> { <action_d_security_property_line> } <indent> "}" <line_end>
<action_d_security_property_line> ::= <indent> <action_d_security_property> <line_end>
<action_d_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<action_d_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <action_d_server_side_condition_property_line> } <indent> "}" <line_end>
<action_d_server_side_condition_property_line> ::= <indent> <action_d_server_side_condition_property> <line_end>
<action_d_server_side_condition_property> ::= "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; conditional; data type: string; lov: STATIC; applies when type is set *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<action_d_child_component> ::= <trigger_action_d> (* applies when type = triggerAction *)

(* triggerAction *)
(* direct properties use default group: identification *)
<trigger_action_d> ::= "triggerAction" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <trigger_action_d_body_line> } <indent> ")" <line_end>
<trigger_action_d_body_line> ::= <trigger_action_d_direct_property_line>
  | <trigger_action_d_group_block>
<trigger_action_d_direct_property_line> ::= <indent> <trigger_action_d_direct_property> <line_end>
<trigger_action_d_direct_property> ::= "action" ":" <ws> <trigger_action_d_action_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<trigger_action_d_group_block> ::= <trigger_action_d_advanced>
  | <trigger_action_d_affected_elements>
  | <trigger_action_d_appearance>
  | <trigger_action_d_client_side_condition>
  | <trigger_action_d_comments>
  | <trigger_action_d_config>
  | <trigger_action_d_execution>
  | <trigger_action_d_file_handling>
  | <trigger_action_d_gen_ai>
  | <trigger_action_d_initial_prompt>
  | <trigger_action_d_input_value>
  | <trigger_action_d_quick_actions>
  | <trigger_action_d_security>
  | <trigger_action_d_server_side_condition>
  | <trigger_action_d_settings>
  | <trigger_action_d_source>
  | <trigger_action_d_use_response>
<trigger_action_d_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <trigger_action_d_advanced_property_line> } <indent> "}" <line_end>
<trigger_action_d_advanced_property_line> ::= <indent> <trigger_action_d_advanced_property> <line_end>
<trigger_action_d_advanced_property> ::= "initJavaScriptFunction" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports INIT_JAVASCRIPT_CODE *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<trigger_action_d_affected_elements> ::= <indent> "affectedElements" <ws> "{" <line_end> { <trigger_action_d_affected_elements_property_line> } <indent> "}" <line_end>
<trigger_action_d_affected_elements_property_line> ::= <indent> <trigger_action_d_affected_elements_property> <line_end>
<trigger_action_d_affected_elements_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when action supports ITEM and selectionType = button or action supports BUTTON and selectionType = button or action supports REGION and selectionType = button or other dependency conditions are satisfied; dynamic values omitted *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = items or action supports BUTTON and selectionType = items or action supports REGION and selectionType = items or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = javaScriptExpression or action supports BUTTON and selectionType = javaScriptExpression or action supports REGION and selectionType = javaScriptExpression or other dependency conditions are satisfied *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = jquerySelector or action supports BUTTON and selectionType = jquerySelector or action supports REGION and selectionType = jquerySelector or other dependency conditions are satisfied *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when action supports ITEM and selectionType = region or action supports BUTTON and selectionType = region or action supports REGION and selectionType = region or other dependency conditions are satisfied; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jquerySelector" | "javaScriptExpression" | "triggeringElement" | "eventSource" ) (* conditional; data type: string; lov: STATIC; applies when action supports ITEM or action supports BUTTON or action supports REGION or other dependency conditions are satisfied *)
<trigger_action_d_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <trigger_action_d_appearance_property_line> } <indent> "}" <line_end>
<trigger_action_d_appearance_property_line> ::= <indent> <trigger_action_d_appearance_property> <line_end>
<trigger_action_d_appearance_property> ::= "containerSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when display_as = INLINE *)
  | "displayAs" ":" <ws> ( "dialog" | "inline" ) (* required; data type: string; lov: STATIC *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as = DIALOG *)
<trigger_action_d_client_side_condition> ::= <indent> "clientSideCondition" <ws> "{" <line_end> { <trigger_action_d_client_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_d_client_side_condition_property_line> ::= <indent> <trigger_action_d_client_side_condition_property> <line_end>
<trigger_action_d_client_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInList) or type in (itemIsNotInList) *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* data type: string; lov: STATIC *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
<trigger_action_d_comments> ::= <indent> "comments" <ws> "{" <line_end> { <trigger_action_d_comments_property_line> } <indent> "}" <line_end>
<trigger_action_d_comments_property_line> ::= <indent> <trigger_action_d_comments_property> <line_end>
<trigger_action_d_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<trigger_action_d_config> ::= <indent> "config" <ws> "{" <line_end> { <trigger_action_d_config_property_line> } <indent> "}" <line_end>
<trigger_action_d_config_property_line> ::= <indent> <trigger_action_d_config_property> <line_end>
<trigger_action_d_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<trigger_action_d_execution> ::= <indent> "execution" <ws> "{" <line_end> { <trigger_action_d_execution_property_line> } <indent> "}" <line_end>
<trigger_action_d_execution_property_line> ::= <indent> <trigger_action_d_execution_property> <line_end>
<trigger_action_d_execution_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports STOP_EXECUTION_ON_ERROR *)
  | "waitForResult" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports WAIT_FOR_RESULT *)
<trigger_action_d_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <trigger_action_d_file_handling_property_line> } <indent> "}" <line_end>
<trigger_action_d_file_handling_property_line> ::= <indent> <trigger_action_d_file_handling_property> <line_end>
<trigger_action_d_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
