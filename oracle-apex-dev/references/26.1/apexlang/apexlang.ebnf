  | "importantForAccessibility" ":" <ws> <boolean> (* required; data type: boolean *)
<custom_attribute_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <custom_attribute_advanced_property_line> } <indent> "}" <line_end>
<custom_attribute_advanced_property_line> ::= <indent> <custom_attribute_advanced_property> <line_end>
