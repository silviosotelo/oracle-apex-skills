  | "y" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (bubble) or type in (scatter) or type = polar and type in (bubble) or other dependency conditions are satisfied *)
  | "z" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (bar) or type in (bubble) or type = combination and type in (bar) or other dependency conditions are satisfied *)
