(* parameter *)
(* direct properties use default group: identification *)
<parameter_f> ::= "parameter" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <parameter_f_body_line> } <indent> ")" <line_end>
<parameter_f_body_line> ::= <parameter_f_direct_property_line>
  | <parameter_f_group_block>
<parameter_f_direct_property_line> ::= <indent> <parameter_f_direct_property> <line_end>
<parameter_f_direct_property> ::= "name" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: parameter; dynamic values omitted *)
<parameter_f_group_block> ::= <parameter_f_value>
<parameter_f_value> ::= <indent> "value" <ws> "{" <line_end> { <parameter_f_value_property_line> } <indent> "}" <line_end>
<parameter_f_value_property_line> ::= <indent> <parameter_f_value_property> <line_end>
<parameter_f_value_property> ::= "falseValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when name supports BOOLEAN_PARAMETER and type in (item) or name supports BOOLEAN_PARAMETER and type in (preference) *)
  | "formatMask" ":" <ws> <string_like_value> (* conditional; data type: string; applies when name supports NUMBER_PARAMETER and type in (staticValue) or name supports NUMBER_PARAMETER and type in (item) or name supports NUMBER_PARAMETER and type in (preference) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = item *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "name" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = collectionClob *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = preference *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = sqlQuery *)
  | "staticValue" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = staticValue and name does not support BOOLEAN_PARAMETER *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; conditional; data type: string; lov: STATIC; applies when type = staticValue and name supports BOOLEAN_PARAMETER *)
  | "trueValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when name supports BOOLEAN_PARAMETER and type in (item) or name supports BOOLEAN_PARAMETER and type in (preference) *)
  | "type" ":" <ws> ( "staticValue" | "restSourceDefault" | "item" | "sqlQuery" | "expression" | "functionBody" | "collectionClob" | "preference" | "null" ) (* required; data type: string; lov: STATIC *)

