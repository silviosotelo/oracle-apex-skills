<task_definition_deadline> ::= <indent> "deadline" <ws> "{" <line_end> { <task_definition_deadline_property_line> } <indent> "}" <line_end>
<task_definition_deadline_property_line> ::= <indent> <task_definition_deadline_property> <line_end>
<task_definition_deadline_property> ::= "dueOnType" ":" <ws> ( "interval" | "sqlQuery" | "expression" | "functionBody" | "schedulerExpression" ) (* data type: string; lov: STATIC *)
  | "expirationPolicy" ":" <ws> ( "none" | "expire" | "renew" ) (* required; conditional; data type: string; lov: STATIC; applies when dueOnType is set *)
  | "interval" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when dueOnType = interval *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when dueOnType = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when dueOnType = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when dueOnType = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when dueOnType = functionBody *)
  | "maxRenewalCount" ":" <ws> <number> (* required; conditional; data type: number; applies when dueOnType is set and expirationPolicy = renew *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when dueOnType = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when dueOnType = functionBody and language = plsql *)
  | "schedulerExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when dueOnType = schedulerExpression *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when dueOnType = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when dueOnType = sqlQuery *)
