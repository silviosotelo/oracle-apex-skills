<facet_geocoding_result_property> ::= "matchVectorItem" ":" <ws> <string_like_value> (* data type: string *)
<facet_label> ::= <indent> "label" <ws> "{" <line_end> { <facet_label_property_line> } <indent> "}" <line_end>
<facet_label_property_line> ::= <indent> <facet_label_property> <line_end>
<facet_label_property> ::= "label" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports VISIBLE *)
  | "showLabelForCurrentFacet" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports VISIBLE *)
<facet_layout> ::= <indent> "layout" <ws> "{" <line_end> { <facet_layout_property_line> } <indent> "}" <line_end>
<facet_layout_property_line> ::= <indent> <facet_layout_property> <line_end>
<facet_layout_property> ::= "maxHeight" ":" <ws> <number> (* conditional; data type: integer *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
<facet_list_entries> ::= <indent> "listEntries" <ws> "{" <line_end> { <facet_list_entries_property_line> } <indent> "}" <line_end>
<facet_list_entries_property_line> ::= <indent> <facet_list_entries_property> <line_end>
<facet_list_entries_property> ::= "allowToExclude" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (checkboxGroup) or type in (radioGroup) or type in (range) *)
  | "computeCounts" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_HAS_FEEDBACK *)
  | "displayFilterInitially" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_FILTER_VALUES and type supports LOV and type is set *)
  | "maxDisplayedEntries" ":" <ws> <number> (* conditional; data type: integer; applies when type supports FC_SHOW_MORE_COUNT and type supports LOV and type is set *)
  | "showCounts" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_HAS_FEEDBACK and computeCounts = true *)
  | "showSelectedFirst" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_SHOW_SELECTED_FIRST and type supports LOV and type is set *)
  | "sortByTopCounts" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_HAS_FEEDBACK and computeCounts = true and showCounts = true and type in (checkboxGroup) or type supports FC_HAS_FEEDBACK and computeCounts = true and showCounts = true and type in (radioGroup) *)
  | "zeroCountEntries" ":" <ws> ( "hide" | "disable" | "showLast" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports FC_HAS_FEEDBACK and computeCounts = true *)
<facet_lov> ::= <indent> "lov" <ws> "{" <line_end> { <facet_lov_property_line> } <indent> "}" <line_end>
<facet_lov_property_line> ::= <indent> <facet_lov_property> <line_end>
<facet_lov_property> ::= "includeNullOption" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_LOV_DISPLAY_NULL and type supports LOV and type is set *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports LOV and type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports LOV and type = functionBody *)
  | "lov" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: lov; applies when type supports LOV and type = sharedComponent; dynamic values omitted *)
  | "nullDisplayValue" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports FC_LOV_DISPLAY_NULL and type supports LOV and type is set and includeNullOption = true *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports LOV and type = functionBody and language = plsql *)
  | "sortDirection" ":" <ws> ( "asc" | "desc" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports LOV and type = distinctValues *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports LOV and type = sqlQuery *)
  | "staticValues" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports LOV and type = staticValues *)
  | "type" ":" <ws> ( "sharedComponent" | "sqlQuery" | "staticValues" | "functionBody" | "distinctValues" ) (* conditional; data type: string; lov: STATIC; applies when type supports LOV *)
<facet_messages> ::= <indent> "messages" <ws> "{" <line_end> { <facet_messages_property_line> } <indent> "}" <line_end>
<facet_messages_property_line> ::= <indent> <facet_messages_property> <line_end>
<facet_messages_property> ::= "noDataFoundMessage" ":" <ws> <string_like_value> (* data type: string *)
<facet_multiple_values> ::= <indent> "multipleValues" <ws> "{" <line_end> { <facet_multiple_values_property_line> } <indent> "}" <line_end>
<facet_multiple_values_property_line> ::= <indent> <facet_multiple_values_property> <line_end>
<facet_multiple_values_property> ::= "filterCombination" ":" <ws> ( "or" | "and" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (checkboxGroup) and type is set or type in (radioGroup) and type is set or type in (selectList) and type is set *)
  | "separator" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (checkboxGroup) and type = delimitedList or type in (radioGroup) and type = delimitedList or type in (selectList) and type = delimitedList *)
  | "trimWhitespace" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (checkboxGroup) and type = delimitedList or type in (radioGroup) and type = delimitedList or type in (selectList) and type = delimitedList *)
  | "type" ":" <ws> ( "delimitedList" | "jsonArray" ) (* conditional; data type: string; lov: STATIC; applies when type in (checkboxGroup) or type in (radioGroup) or type in (selectList) *)
<facet_qr_code> ::= <indent> "qrCode" <ws> "{" <line_end> { <facet_qr_code_property_line> } <indent> "}" <line_end>
<facet_qr_code_property_line> ::= <indent> <facet_qr_code_property> <line_end>
<facet_qr_code_property> ::= "dataType" ":" <ws> ( "email" | "geoLocation" | "url" | "phone" | "sms" ) (* data type: string; lov: STATIC *)
  | "size" ":" <ws> ( "small" | "large" | "medium" ) (* data type: string; lov: STATIC *)
<facet_resize_to> ::= <indent> "resizeTo" <ws> "{" <line_end> { <facet_resize_to_property_line> } <indent> "}" <line_end>
<facet_resize_to_property_line> ::= <indent> <facet_resize_to_property> <line_end>
<facet_resize_to_property> ::= "maxFileSize" ":" <ws> <number> (* data type: integer *)
  | "maxHeight" ":" <ws> <number> (* data type: integer *)
  | "maxWidth" ":" <ws> <number> (* data type: integer *)
<facet_search> ::= <indent> "search" <ws> "{" <line_end> { <facet_search_property_line> } <indent> "}" <line_end>
<facet_search_property_line> ::= <indent> <facet_search_property> <line_end>
<facet_search_property> ::= "caseSensitive" ":" <ws> <boolean> (* required; data type: boolean *)
  | "matchType" ":" <ws> ( "startsWith" | "contains" ) (* required; data type: string; lov: STATIC *)
  | "minChars" ":" <ws> <number> (* required; data type: integer *)
<facet_security> ::= <indent> "security" <ws> "{" <line_end> { <facet_security_property_line> } <indent> "}" <line_end>
<facet_security_property_line> ::= <indent> <facet_security_property> <line_end>
<facet_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
  | "encryptSessionState" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports ENCRYPT *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports ESCAPE_OUTPUT *)
<facet_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <facet_server_side_condition_property_line> } <indent> "}" <line_end>
<facet_server_side_condition_property_line> ::= <indent> <facet_server_side_condition_property> <line_end>
<facet_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<facet_settings> ::= <indent> "settings" <ws> "{" <line_end> { <facet_settings_property_line> } <indent> "}" <line_end>
<facet_settings_property_line> ::= <indent> <facet_settings_property> <line_end>
<facet_settings_property> ::= "activeColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "additionalOutputs" ":" <ws> <string_like_value> (* data type: string *)
  | "allowCustomHtml" ":" <ws> <boolean> (* required; data type: boolean *)
  | "altText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when based_on = URL *)
  | "altTextColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when based_on = DB_COLUMN *)
  | "appearanceBehavior" ":" <ws> ( "paginateByMultipleMonths" | "showWeek" | "yearPicker" | "showTodayButton" | "monthPicker" ) (* conditional; data type: string; lov: STATIC; applies when display_as in (POPUP) and use_defaults = N or display_as in (INLINE) and use_defaults = N *)
  | "autoHeight" ":" <ws> <boolean> (* required; data type: boolean *)
  | "backgroundColor" ":" <ws> <string_like_value> (* data type: string *)
  | "barWidth" ":" <ws> <number> (* data type: integer *)
  | "basedOn" ":" <ws> ( "plsql" | "lov" | "value" ) (* required; conditional; data type: string; lov: STATIC; applies when format = PLAIN *)
  | "blobLastUpdatedColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when based_on = DB_COLUMN *)
  | "caseSensitive" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when comparison_operator in (STARTS_WITH) or comparison_operator in (CONTAINS) or comparison_operator in (NOT_STARTS_WITH) or other dependency conditions are satisfied *)
  | "charCounter" ":" <ws> <boolean> (* required; data type: boolean *)
  | "checkedValue" ":" <ws> <string_like_value> (* required; conditional; data type: string *)
  | "colorPreset" ":" <ws> ( "none" | "themeStyle" | "custom" ) (* required; conditional; data type: string; lov: STATIC *)
  | "colors" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when color_preset = CUSTOM *)
  | "comparisonOperator" ":" <ws> ( "notEquals" | "contains" | "doesNotContain" | "greaterThanOrEqualTo" | "equals" | "startsWith" | "doesNotStartWith" | "lessThan" | "greaterThan" | "lessThanOrEqualTo" ) (* required; data type: string; lov: STATIC *)
  | "contrastColor" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when contrast_with = STATIC *)
  | "contrastItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when contrast_with = PAGE_ITEM *)
  | "contrastWith" ":" <ws> ( "staticColor" | "pageItem" | "none" ) (* required; conditional; data type: string; lov: STATIC *)
  | "currentLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when manual_entry = Y *)
  | "currentLabelOpenHigh" ":" <ws> <string_like_value> (* conditional; data type: string; applies when manual_entry = Y *)
  | "currentLabelOpenLow" ":" <ws> <string_like_value> (* conditional; data type: string; applies when manual_entry = Y *)
  | "daysOutsideMonth" ":" <ws> ( "visible" | "selectable" | "hidden" ) (* required; conditional; data type: string; lov: STATIC; applies when display_as in (POPUP) and use_defaults = N or display_as in (INLINE) and use_defaults = N *)
  | "displayAs" ":" <ws> ( "inlinePopup" | "modalDialog" ) (* required; data type: string; lov: STATIC *)
  | "displayValuesAs" ":" <ws> ( "chips" | "commaSeparatedList" ) (* required; conditional; data type: string; lov: STATIC; applies when use_defaults = N *)
  | "enableMultiSelect" ":" <ws> <boolean> (* required; data type: boolean *)
  | "executeValidations" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when page_action_on_selection = SUBMIT *)
  | "externalPageItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_field = PAGE_ITEM *)
  | "fetch" ":" <ws> ( "firstRowset" | "firstRowsetFilter" | "noFetch" ) (* required; data type: string; lov: STATIC *)
  | "fetchOnSearch" ":" <ws> <boolean> (* required; data type: boolean *)
  | "fetchOnType" ":" <ws> <boolean> (* required; data type: boolean *)
  | "filenameColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when based_on = DB_COLUMN *)
  | "foregroundColor" ":" <ws> <string_like_value> (* data type: string *)
  | "format" ":" <ws> ( "markdown" | "html" ) (* required; data type: string; lov: STATIC *)
  | "hideControl" ":" <ws> <boolean> (* required; data type: boolean *)
  | "hideRadioButtons" ":" <ws> <boolean> (* required; data type: boolean *)
  | "highlightedDate" ":" <ws> <string_like_value> (* data type: string *)
  | "htmlExpression" ":" <ws> <string_like_value> (* required; data type: string *)
  | "icon" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_defaults = N *)
  | "inactiveColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "infiniteScroll" ":" <ws> <boolean> (* required; data type: boolean *)
  | "initialFetch" ":" <ws> ( "auto" | "autoCurrentValue" | "onUserRequest" ) (* required; data type: string; lov: STATIC *)
  | "inputField" ":" <ws> ( "topOfFacetedSearchRegion" | "externalPageItem" ) (* required; data type: string; lov: STATIC *)
  | "manualEntriesItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when fetch_on_search = N *)
  | "manualEntry" ":" <ws> <boolean> (* required; data type: boolean *)
  | "maxDate" ":" <ws> ( "static" | "none" | "item" ) (* required; data type: string; lov: STATIC *)
  | "maxHeight" ":" <ws> <number> (* data type: number *)
  | "maxItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when max_date = ITEM *)
  | "maxStatic" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when max_date = STATIC *)
  | "maxValue" ":" <ws> <number> (* data type: number *)
  | "maxValuesInList" ":" <ws> <number> (* conditional; data type: integer; applies when infinite_scroll = N *)
  | "mimeTypeColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when based_on = DB_COLUMN *)
  | "minDate" ":" <ws> ( "none" | "item" | "static" ) (* required; data type: string; lov: STATIC *)
  | "minHeight" ":" <ws> <number> (* data type: number *)
  | "minItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when min_date = ITEM *)
  | "minStatic" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when min_date = STATIC *)
  | "minValue" ":" <ws> <number> (* data type: number *)
  | "multiSelection" ":" <ws> <boolean> (* required; data type: boolean *)
  | "multipleMonths" ":" <ws> ( "5" | "false" | "3" | "2" | "4" ) (* required; conditional; data type: string; lov: STATIC; applies when display_as in (POPUP) or display_as in (INLINE) *)
  | "navigationListFor" ":" <ws> ( "month" | "monthAndYear" | "year" | "none" ) (* required; data type: string; lov: STATIC *)
  | "noOfMonths" ":" <ws> <string_like_value> (* conditional; data type: string; applies when show_other_months = Y *)
  | "noOfStars" ":" <ws> ( "2" | "4" | "3" | "10" | "8" | "1" | "6" | "5" | "7" | "9" ) (* required; data type: string; lov: STATIC *)
  | "numberAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; data type: string; lov: STATIC *)
  | "offLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "offValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "onLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "onValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when format = PLAIN and based_on = PLSQL *)
  | "popupHeight" ":" <ws> <number> (* data type: number *)
  | "popupWidth" ":" <ws> <number> (* data type: number *)
  | "prefixText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when user_can_choose_operator = N *)
  | "preserveCase" ":" <ws> <boolean> (* required; data type: boolean *)
  | "rangeText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when manual_entry = Y *)
  | "readOnlyDisplay" ":" <ws> ( "singleStarAndValue" | "stars" | "value" | "starsAndValue" ) (* required; conditional; data type: string; lov: STATIC; applies when use_defaults = N *)
  | "resizable" ":" <ws> <boolean> (* required; data type: boolean *)
  | "searchType" ":" <ws> ( "oracleText" | "rowSearch" ) (* required; data type: string; lov: STATIC *)
  | "selectMultiple" ":" <ws> <boolean> (* required; data type: boolean *)
  | "show" ":" <ws> ( "inline" | "onIconClick" | "onFocus" | "both" ) (* required; data type: string; lov: STATIC *)
  | "showClearButton" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_defaults = N *)
  | "showControls" ":" <ws> ( "none" | "orderingOnly" | "all" | "movingOnly" ) (* required; data type: string; lov: STATIC *)
  | "showOn" ":" <ws> ( "iconClick" | "itemFocus" ) (* required; conditional; data type: string; lov: STATIC; applies when display_as in (POPUP) and use_defaults = N or display_as in (INLINE) and use_defaults = N *)
  | "showOtherMonths" ":" <ws> <boolean> (* required; data type: boolean *)
  | "showSelectAll" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when enable_multi_select = Y *)
  | "showTime" ":" <ws> <boolean> (* required; data type: boolean *)
  | "showValue" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_defaults = N *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when based_on = SQL *)
  | "submitWhenEnterPressed" ":" <ws> <boolean> (* required; data type: boolean *)
  | "suffixText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when user_can_choose_operator = N *)
  | "syntaxHighlighting" ":" <ws> <boolean> (* required; data type: boolean *)
  | "textCase" ":" <ws> ( "lower" | "upper" ) (* data type: string; lov: STATIC *)
  | "textColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when show_value = Y *)
  | "timeIncrement" ":" <ws> <number> (* conditional; data type: integer; applies when display_as in (POPUP) and use_defaults = N or display_as in (INLINE) and use_defaults = N *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "toolbar" ":" <ws> ( "full" | "basic" | "intermediate" ) (* required; conditional; data type: string; lov: STATIC; applies when format = HTML *)
  | "toolbarStyle" ":" <ws> ( "overflowMenu" | "multiline" ) (* required; conditional; data type: string; lov: STATIC; applies when format = HTML and toolbar in (INTERMEDIATE) or format = HTML and toolbar in (FULL) *)
  | "tooltip" ":" <ws> <string_like_value> (* conditional; data type: string; applies when show_marker = Y *)
  | "trimSpaces" ":" <ws> ( "trailing" | "leadingAndTrailing" | "leading" | "none" ) (* required; data type: string; lov: STATIC *)
  | "useCache" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when fetch_on_search = Y *)
  | "useDefaults" ":" <ws> <boolean> (* required; data type: boolean *)
  | "userCanChooseOperator" ":" <ws> <boolean> (* required; data type: boolean *)
  | "valueHtmlExpression" ":" <ws> <string_like_value> (* data type: string *)
  | "valueProtected" ":" <ws> <boolean> (* required; data type: boolean *)
  | "valuesCase" ":" <ws> ( "lower" | "mixed" | "upper" ) (* required; conditional; data type: string; lov: STATIC; applies when comparison_operator in (STARTS_WITH) and case_sensitive = Y or comparison_operator in (CONTAINS) and case_sensitive = Y or comparison_operator in (NOT_STARTS_WITH) and case_sensitive = Y or other dependency conditions are satisfied *)
  | "virtualKeyboard" ":" <ws> ( "decimal" | "numeric" | "text" ) (* required; data type: string; lov: STATIC *)
  | "yearRange" ":" <ws> <string_like_value> (* conditional; data type: string; applies when navigation_list_for in (YEAR) or navigation_list_for in (MONTH_AND_YEAR) *)
<facet_source> ::= <indent> "source" <ws> "{" <line_end> { <facet_source_property_line> } <indent> "}" <line_end>
<facet_source_property_line> ::= <indent> <facet_source_property> <line_end>
<facet_source_property> ::= "dataType" ":" <ws> ( "varchar2" | "number" | "date" | "timestamp" | "timestampWithTimeZone" | "timestampWithLocalTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "clob" | "blob" | "boolean" | "rowid" | "bfile" | "sdoGeometry" ) (* required; conditional; data type: string; lov: STATIC *)
  | "databaseColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string *)
  | "dbColumns" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = search *)
<facet_storage> ::= <indent> "storage" <ws> "{" <line_end> { <facet_storage_property_line> } <indent> "}" <line_end>
<facet_storage_property_line> ::= <indent> <facet_storage_property> <line_end>
<facet_storage_property> ::= "allowMultipleFiles" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when storage_type = APEX_APPLICATION_TEMP_FILES *)
  | "blobLastUpdatedColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "bobLastUpdatedColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "charSetColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "fileTypes" ":" <ws> <string_like_value> (* data type: string *)
  | "filenameColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "maxFileSize" ":" <ws> <number> (* data type: integer *)
  | "mimeTypeColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN *)
  | "purgeFileAt" ":" <ws> ( "endOfRequest" | "endOfSession" ) (* required; conditional; data type: string; lov: STATIC; applies when storage_type = APEX_APPLICATION_TEMP_FILES *)
  | "purgeFilesAt" ":" <ws> ( "endOfRequest" | "endOfSession" ) (* required; conditional; data type: string; lov: STATIC; applies when storage_type = APEX_APPLICATION_TEMP_FILES *)
  | "type" ":" <ws> ( "appTempFiles" | "wwvFlowFiles" | "blobCol" ) (* required; data type: string; lov: STATIC *)

(* facetGroup *)
(* direct properties use default group: label *)
<facet_group> ::= "facetGroup" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <facet_group_body_line> } <indent> ")" <line_end>
<facet_group_body_line> ::= <facet_group_direct_property_line>
  | <facet_group_group_block>
  | <facet_group_child_component>
<facet_group_direct_property_line> ::= <indent> <facet_group_direct_property> <line_end>
<facet_group_direct_property> ::= "label" ":" <ws> <string_like_value> (* required; data type: string *)
<facet_group_group_block> ::= <facet_group_actions_menu>
  | <facet_group_advanced>
  | <facet_group_appearance>
  | <facet_group_comments>
  | <facet_group_config>
  | <facet_group_layout>
  | <facet_group_list_entries>
  | <facet_group_security>
  | <facet_group_server_side_condition>
<facet_group_actions_menu> ::= <indent> "actionsMenu" <ws> "{" <line_end> { <facet_group_actions_menu_property_line> } <indent> "}" <line_end>
<facet_group_actions_menu_property_line> ::= <indent> <facet_group_actions_menu_property> <line_end>
<facet_group_actions_menu_property> ::= "chart" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when computeCounts = true and display = inline *)
<facet_group_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <facet_group_advanced_property_line> } <indent> "}" <line_end>
<facet_group_advanced_property_line> ::= <indent> <facet_group_advanced_property> <line_end>
<facet_group_advanced_property> ::= "collapsible" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when display = inline *)
  | "combineFilters" ":" <ws> ( "or" | "and" ) (* required; data type: string; lov: STATIC *)
  | "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when display = inline *)
  | "initiallyCollapsed" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when display = inline and collapsible = true *)
  | "showChartInitially" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when computeCounts = true and display = inline and chart = true *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<facet_group_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <facet_group_appearance_property_line> } <indent> "}" <line_end>
<facet_group_appearance_property_line> ::= <indent> <facet_group_appearance_property> <line_end>
<facet_group_appearance_property> ::= "display" ":" <ws> ( "inline" | "addFilterDialog" ) (* required; data type: string; lov: STATIC *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
<facet_group_comments> ::= <indent> "comments" <ws> "{" <line_end> { <facet_group_comments_property_line> } <indent> "}" <line_end>
<facet_group_comments_property_line> ::= <indent> <facet_group_comments_property> <line_end>
<facet_group_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<facet_group_config> ::= <indent> "config" <ws> "{" <line_end> { <facet_group_config_property_line> } <indent> "}" <line_end>
<facet_group_config_property_line> ::= <indent> <facet_group_config_property> <line_end>
<facet_group_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<facet_group_layout> ::= <indent> "layout" <ws> "{" <line_end> { <facet_group_layout_property_line> } <indent> "}" <line_end>
<facet_group_layout_property_line> ::= <indent> <facet_group_layout_property> <line_end>
<facet_group_layout_property> ::= "maxHeight" ":" <ws> <number> (* data type: integer *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
<facet_group_list_entries> ::= <indent> "listEntries" <ws> "{" <line_end> { <facet_group_list_entries_property_line> } <indent> "}" <line_end>
<facet_group_list_entries_property_line> ::= <indent> <facet_group_list_entries_property> <line_end>
<facet_group_list_entries_property> ::= "computeCounts" ":" <ws> <boolean> (* required; data type: boolean *)
  | "maxDisplayedEntries" ":" <ws> <number> (* data type: integer *)
  | "showCounts" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when computeCounts = true *)
  | "showSelectedFirst" ":" <ws> <boolean> (* required; data type: boolean *)
  | "sortByTopCounts" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when computeCounts = true and showCounts = true *)
  | "zeroCountEntries" ":" <ws> ( "hide" | "disable" | "showLast" ) (* required; conditional; data type: string; lov: STATIC; applies when computeCounts = true *)
<facet_group_security> ::= <indent> "security" <ws> "{" <line_end> { <facet_group_security_property_line> } <indent> "}" <line_end>
<facet_group_security_property_line> ::= <indent> <facet_group_security_property> <line_end>
<facet_group_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<facet_group_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <facet_group_server_side_condition_property_line> } <indent> "}" <line_end>
<facet_group_server_side_condition_property_line> ::= <indent> <facet_group_server_side_condition_property> <line_end>
<facet_group_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<facet_group_child_component> ::= <checkbox_a>

(* checkbox *)
(* direct properties use default group: identification *)
<checkbox_a> ::= "checkbox" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <checkbox_a_body_line> } <indent> ")" <line_end>
<checkbox_a_body_line> ::= <checkbox_a_direct_property_line>
  | <checkbox_a_group_block>
<checkbox_a_direct_property_line> ::= <indent> <checkbox_a_direct_property> <line_end>
<checkbox_a_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> <checkbox_a_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
<checkbox_a_group_block> ::= <checkbox_a_appearance>
  | <checkbox_a_cascading_lov>
  | <checkbox_a_comments>
  | <checkbox_a_config>
  | <checkbox_a_cropping>
  | <checkbox_a_default>
  | <checkbox_a_depending_on>
  | <checkbox_a_display>
  | <checkbox_a_geocoding_input>
  | <checkbox_a_geocoding_result>
  | <checkbox_a_label>
  | <checkbox_a_layout>
  | <checkbox_a_lov>
  | <checkbox_a_messages>
  | <checkbox_a_qr_code>
  | <checkbox_a_resize_to>
  | <checkbox_a_search>
