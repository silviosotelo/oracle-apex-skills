<authentication_login_processing_property_line> ::= <indent> <authentication_login_processing_property> <line_end>
<authentication_login_processing_property> ::= "postAuthenticationProcedureName" ":" <ws> <string_like_value> (* data type: string *)
  | "preAuthenticationProcedureName" ":" <ws> <string_like_value> (* data type: string *)
  | "switchInSession" ":" <ws> <boolean> (* required; data type: boolean *)
<authentication_post_logout> ::= <indent> "postLogout" <ws> "{" <line_end> { <authentication_post_logout_property_line> } <indent> "}" <line_end>
<authentication_post_logout_property_line> ::= <indent> <authentication_post_logout_property> <line_end>
<authentication_post_logout_property> ::= "redirectTo" ":" <ws> ( "homePage" | "url" ) (* required; data type: string; lov: STATIC *)
  | "url" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when redirectTo = url *)
<authentication_real_app_security> ::= <indent> "realAppSecurity" <ws> "{" <line_end> { <authentication_real_app_security_property_line> } <indent> "}" <line_end>
<authentication_real_app_security_property_line> ::= <indent> <authentication_real_app_security_property> <line_end>
<authentication_real_app_security_property> ::= "dynamicRoles" ":" <ws> <string_like_value> (* conditional; data type: string; applies when rasMode in (externalUsers) or rasMode in (internalUsers) *)
  | "namespaces" ":" <ws> <string_like_value> (* conditional; data type: string; applies when rasMode in (externalUsers) or rasMode in (internalUsers) *)
  | "rasMode" ":" <ws> ( "disabled" | "externalUsers" | "internalUsers" ) (* required; data type: string; lov: STATIC *)
<authentication_session_not_valid> ::= <indent> "sessionNotValid" <ws> "{" <line_end> { <authentication_session_not_valid_property_line> } <indent> "}" <line_end>
<authentication_session_not_valid_property_line> ::= <indent> <authentication_session_not_valid_property> <line_end>
<authentication_session_not_valid_property> ::= "invalidSessionUrl" ":" <ws> <value> (* conditional; data type: complex; applies when type supports INVALID_SESSION and redirectTo = url *)
  | "redirectTo" ":" <ws> ( "loginPage" | "builtInLoginPage" | "url" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports INVALID_SESSION *)
  | "verifyFunctionName" ":" <ws> <string_like_value> (* data type: string *)
<authentication_session_sharing> ::= <indent> "sessionSharing" <ws> "{" <line_end> { <authentication_session_sharing_property_line> } <indent> "}" <line_end>
<authentication_session_sharing_property_line> ::= <indent> <authentication_session_sharing_property> <line_end>
<authentication_session_sharing_property> ::= "cookieDomain" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = custom *)
  | "cookieName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = custom *)
  | "cookiePath" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = custom *)
  | "secure" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = custom *)
  | "type" ":" <ws> ( "app" | "workspaceSharing" | "custom" ) (* required; data type: string; lov: STATIC *)
<authentication_settings> ::= <indent> "settings" <ws> "{" <line_end> { <authentication_settings_property_line> } <indent> "}" <line_end>
<authentication_settings_property_line> ::= <indent> <authentication_settings_property> <line_end>
<authentication_settings_property> ::= "actionIfUsernameIsEmpty" ":" <ws> ( "redirectToUrl" | "displayError" | "redirectToBuiltInUrl" ) (* required; data type: string; lov: STATIC *)
  | "additionalUserAttrs" ":" <ws> <string_like_value> (* data type: string *)
  | "authFunctionName" ":" <ws> <string_like_value> (* data type: string *)
  | "authProvider" ":" <ws> ( "genericOauth2Provider" | "google" | "facebook" | "openidConnect" ) (* required; data type: string; lov: STATIC *)
  | "authUriParams" ":" <ws> <string_like_value> (* data type: string *)
  | "authorizationEndpointUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when authentication_provider = OAUTH2 *)
  | "convertUsernameToUpperCase" ":" <ws> <boolean> (* required; data type: boolean *)
  | "credentialStore" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: webCredential; dynamic values omitted *)
  | "credentialStoreForSigningRequests" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: webCredential; applies when use_saml_attributes = APP; dynamic values omitted *)
  | "discoveryUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when authentication_provider = OPENID_CONNECT *)
  | "dnString" ":" <ws> <string_like_value> (* required; data type: string *)
  | "enableLegacyAuthAttrs" ":" <ws> <boolean> (* required; data type: boolean *)
  | "errorMessage" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action_if_username_empty = ERROR *)
  | "host" ":" <ws> <string_like_value> (* required; data type: string *)
  | "identityProviderIssuer" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_saml_attributes = APP *)
  | "identityProviderSigningCertificate" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_saml_attributes = APP *)
  | "identityProviderSingleSignOnUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_saml_attributes = APP *)
  | "identityProviderSingleSignOutUrl" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_saml_attributes = APP *)
  | "invalidSessionProcedureName" ":" <ws> <string_like_value> (* data type: string *)
  | "ldapDnString" ":" <ws> <string_like_value> (* conditional; data type: string; applies when enable_legacy_attributes = Y *)
  | "ldapHost" ":" <ws> <string_like_value> (* conditional; data type: string; applies when enable_legacy_attributes = Y *)
  | "ldapPort" ":" <ws> <number> (* conditional; data type: integer; applies when enable_legacy_attributes = Y *)
  | "ldapUsernameEditFunction" ":" <ws> <string_like_value> (* data type: string *)
  | "mapAdditionalUserAttrsTo" ":" <ws> <string_like_value> (* data type: string *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
  | "partnerAppName" ":" <ws> <string_like_value> (* data type: string *)
  | "port" ":" <ws> <number> (* data type: integer *)
  | "postLogoutProcedureName" ":" <ws> <string_like_value> (* data type: string *)
  | "scope" ":" <ws> <string_like_value> (* required; data type: string *)
  | "searchFilter" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_exact_dn = N *)
  | "sentryFunctionName" ":" <ws> <string_like_value> (* data type: string *)
  | "ssoPartnerAppName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when enable_legacy_attributes = Y *)
  | "ssoServerLogoutUrl" ":" <ws> <string_like_value> (* data type: string *)
  | "tokenAuthMethod" ":" <ws> ( "basicClientIdInBody" | "clientIdClientSecretInBody" | "clientIdInBody" | "basic" ) (* conditional; data type: string; lov: STATIC; applies when authentication_provider in (OPENID_CONNECT) or authentication_provider in (OAUTH2) *)
  | "tokenEndpointUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when authentication_provider = OAUTH2 *)
  | "url" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action_if_username_empty = URL *)
  | "useExactDn" ":" <ws> <boolean> (* required; data type: boolean *)
  | "useSamlAttrsOf" ":" <ws> ( "application" | "instance" ) (* data type: string; lov: STATIC *)
  | "useSsl" ":" <ws> ( "ssl" | "sslWithAuth" | "noSsl" ) (* required; data type: string; lov: STATIC *)
  | "userInfoEndpointUrl" ":" <ws> <string_like_value> (* conditional; data type: string; applies when authentication_provider = OAUTH2 *)
  | "username" ":" <ws> <string_like_value> (* required; data type: string *)
  | "usernameAttr" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_saml_attributes = APP *)
  | "usernameEscaping" ":" <ws> ( "standard" | "noEscaping" | "onlySpecialChars" ) (* required; data type: string; lov: STATIC *)
  | "verifyAttrs" ":" <ws> <boolean> (* required; data type: boolean *)
  | "verifyUsername" ":" <ws> ( "eachRequest" | "afterLogin" ) (* required; data type: string; lov: STATIC *)
<authentication_source> ::= <indent> "source" <ws> "{" <line_end> { <authentication_source_property_line> } <indent> "}" <line_end>
<authentication_source_property_line> ::= <indent> <authentication_source_property> <line_end>
<authentication_source_property> ::= "plsqlCode" ":" <ws> <multiline_string> (* data type: string *)
<authentication_subscription> ::= <indent> "subscription" <ws> "{" <line_end> { <authentication_subscription_property_line> } <indent> "}" <line_end>
<authentication_subscription_property_line> ::= <indent> <authentication_subscription_property> <line_end>
<authentication_subscription_property> ::= "master" ":" <ws> ( "@/8842.261/builder-extension-sign-in" | "@/8842.9999/builder-extension-sign-in" | "@/8842.9999/oracle-apex-accounts" ) (* data type: string; lov: COMPONENT; references: authentication; dynamic values omitted *)

