<dynamic_action_server_side_condition_property_line> ::= <indent> <dynamic_action_server_side_condition_property> <line_end>
<dynamic_action_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<dynamic_action_when> ::= <indent> "when" <ws> "{" <line_end> { <dynamic_action_when_property_line> } <indent> "}" <line_end>
<dynamic_action_when_property_line> ::= <indent> <dynamic_action_when_property> <line_end>
<dynamic_action_when_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when selectionType = button; dynamic values omitted *)
  | "columns" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when selectionType = columns *)
  | "customEvent" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when event = custom *)
  | "domObject" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when selectionType = domObject *)
  | "event" ":" <ws> <string_like_value> (* required; data type: string; lov: EVENTS *)
  | "interactiveGrid" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when selectionType = columns; dynamic values omitted *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when selectionType = items *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when selectionType = jsExpression *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when selectionType = jQuerySelector *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when selectionType = region; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jQuerySelector" | "jsExpression" ) (* required; conditional; data type: string; lov: STATIC *)
<dynamic_action_child_component> ::= <action_c>

(* action *)
(* direct properties use default group: identification *)
<action_c> ::= "action" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <action_c_body_line> } <indent> ")" <line_end>
<action_c_body_line> ::= <action_c_direct_property_line>
  | <action_c_group_block>
<action_c_direct_property_line> ::= <indent> <action_c_direct_property> <line_end>
<action_c_direct_property> ::= "action" ":" <ws> <action_c_action_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<action_c_group_block> ::= <action_c_advanced>
  | <action_c_affected_elements>
  | <action_c_appearance>
  | <action_c_client_side_condition>
  | <action_c_comments>
  | <action_c_config>
  | <action_c_execution>
  | <action_c_file_handling>
  | <action_c_gen_ai>
  | <action_c_initial_prompt>
  | <action_c_input_value>
  | <action_c_quick_actions>
  | <action_c_security>
  | <action_c_server_side_condition>
  | <action_c_settings>
  | <action_c_source>
  | <action_c_use_response>
<action_c_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <action_c_advanced_property_line> } <indent> "}" <line_end>
<action_c_advanced_property_line> ::= <indent> <action_c_advanced_property> <line_end>
<action_c_advanced_property> ::= "initJavaScriptFunction" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports INIT_JAVASCRIPT_CODE *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<action_c_affected_elements> ::= <indent> "affectedElements" <ws> "{" <line_end> { <action_c_affected_elements_property_line> } <indent> "}" <line_end>
<action_c_affected_elements_property_line> ::= <indent> <action_c_affected_elements_property> <line_end>
<action_c_affected_elements_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when action supports ITEM and selectionType = button or action supports BUTTON and selectionType = button or action supports REGION and selectionType = button or other dependency conditions are satisfied; dynamic values omitted *)
  | "columns" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = columns or action supports BUTTON and selectionType = columns or action supports REGION and selectionType = columns or other dependency conditions are satisfied *)
  | "domObject" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = domObject or action supports BUTTON and selectionType = domObject or action supports REGION and selectionType = domObject or other dependency conditions are satisfied *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = items or action supports BUTTON and selectionType = items or action supports REGION and selectionType = items or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = javaScriptExpression or action supports BUTTON and selectionType = javaScriptExpression or action supports REGION and selectionType = javaScriptExpression or other dependency conditions are satisfied *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = jquerySelector or action supports BUTTON and selectionType = jquerySelector or action supports REGION and selectionType = jquerySelector or other dependency conditions are satisfied *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when action supports ITEM and selectionType = region or action supports BUTTON and selectionType = region or action supports REGION and selectionType = region or other dependency conditions are satisfied; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jquerySelector" | "javaScriptExpression" | "triggeringElement" | "eventSource" ) (* conditional; data type: string; lov: STATIC; applies when action supports ITEM or action supports BUTTON or action supports REGION or other dependency conditions are satisfied *)
<action_c_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <action_c_appearance_property_line> } <indent> "}" <line_end>
<action_c_appearance_property_line> ::= <indent> <action_c_appearance_property> <line_end>
<action_c_appearance_property> ::= "containerSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when display_as = INLINE *)
  | "displayAs" ":" <ws> ( "dialog" | "inline" ) (* required; data type: string; lov: STATIC *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as = DIALOG *)
<action_c_client_side_condition> ::= <indent> "clientSideCondition" <ws> "{" <line_end> { <action_c_client_side_condition_property_line> } <indent> "}" <line_end>
<action_c_client_side_condition_property_line> ::= <indent> <action_c_client_side_condition_property> <line_end>
<action_c_client_side_condition_property> ::= "column" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (itemColumn=value) and componentType = column or type in (itemColumn!=value) and componentType = column or type in (itemColumn>value) and componentType = column or other dependency conditions are satisfied *)
  | "componentType" ":" <ws> ( "item" | "column" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (itemColumn=value) or type in (itemColumn!=value) or type in (itemColumn>value) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (itemColumn=value) and componentType = item or type in (itemColumn!=value) and componentType = item or type in (itemColumn>value) and componentType = item or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when region does not support IG_REGION and type in (item=value) or region does not support IG_REGION and type in (item!=value) or region does not support IG_REGION and type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when region does not support IG_REGION and type = jsExpression *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsExpression or region supports IG_REGION and type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when region does not support IG_REGION and type in (itemIsInList) or region does not support IG_REGION and type in (itemIsNotInList) *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemColumnIsInList) or type in (itemColumnIsNotInList) or region supports IG_REGION and type in (itemColumnIsInList) or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* conditional; data type: string; lov: STATIC; applies when region does not support IG_REGION *)
  | "type" ":" <ws> ( "itemColumn=value" | "itemColumn!=value" | "itemColumn>value" | "itemColumn>=value" | "itemColumn<value" | "itemColumn<=value" | "itemColumnIsNull" | "itemColumnIsNotNull" | "itemColumnIsInList" | "itemColumnIsNotInList" | "jsExpression" ) (* conditional; data type: string; lov: STATIC; applies when region supports IG_REGION *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when region does not support IG_REGION and type in (item=value) or region does not support IG_REGION and type in (item!=value) or region does not support IG_REGION and type in (item>value) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (itemColumn=value) or type in (itemColumn!=value) or type in (itemColumn>value) or other dependency conditions are satisfied *)
<action_c_comments> ::= <indent> "comments" <ws> "{" <line_end> { <action_c_comments_property_line> } <indent> "}" <line_end>
<action_c_comments_property_line> ::= <indent> <action_c_comments_property> <line_end>
<action_c_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<action_c_config> ::= <indent> "config" <ws> "{" <line_end> { <action_c_config_property_line> } <indent> "}" <line_end>
<action_c_config_property_line> ::= <indent> <action_c_config_property> <line_end>
<action_c_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<action_c_execution> ::= <indent> "execution" <ws> "{" <line_end> { <action_c_execution_property_line> } <indent> "}" <line_end>
<action_c_execution_property_line> ::= <indent> <action_c_execution_property> <line_end>
<action_c_execution_property> ::= "event" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: dynamicAction; dynamic values omitted *)
  | "fireOnInit" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action is set *)
  | "fireWhenEventResultIs" ":" <ws> ( "true" | "false" ) (* required; data type: string; lov: STATIC *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports STOP_EXECUTION_ON_ERROR *)
  | "waitForResult" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports WAIT_FOR_RESULT *)
<action_c_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <action_c_file_handling_property_line> } <indent> "}" <line_end>
<action_c_file_handling_property_line> ::= <indent> <action_c_file_handling_property> <line_end>
<action_c_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
  | "viewFileAs" ":" <ws> ( "inline" | "attachment" ) (* required; conditional; data type: string; lov: STATIC; applies when multiple_files = N *)
<action_c_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <action_c_gen_ai_property_line> } <indent> "}" <line_end>
<action_c_gen_ai_property_line> ::= <indent> <action_c_gen_ai_property> <line_end>
<action_c_gen_ai_property> ::= "agent" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: aiAgent; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "enabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports AI_ENABLED *)
  | "itemsToSubmit" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true *)
  | "service" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: genAIService; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "systemPrompt" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED and enabled = true *)
  | "welcomeMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_UI and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_UI and action supports AI_ENABLED and enabled = true *)
<action_c_initial_prompt> ::= <indent> "initialPrompt" <ws> "{" <line_end> { <action_c_initial_prompt_property_line> } <indent> "}" <line_end>
<action_c_initial_prompt_property_line> ::= <indent> <action_c_initial_prompt_property> <line_end>
<action_c_initial_prompt_property> ::= "displayedMessage" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "immediateActionPrompt" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = JAVASCRIPT_EXPRESSION *)
  | "type" ":" <ws> ( "item" | "jsExpression" ) (* data type: string; lov: STATIC *)
<action_c_input_value> ::= <indent> "inputValue" <ws> "{" <line_end> { <action_c_input_value_property_line> } <indent> "}" <line_end>
<action_c_input_value_property_line> ::= <indent> <action_c_input_value_property> <line_end>
<action_c_input_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = JAVASCRIPT *)
  | "type" ":" <ws> ( "jsCode" | "item" | "onlySystemPrompt" ) (* required; data type: string; lov: STATIC *)
<action_c_quick_actions> ::= <indent> "quickActions" <ws> "{" <line_end> { <action_c_quick_actions_property_line> } <indent> "}" <line_end>
<action_c_quick_actions_property_line> ::= <indent> <action_c_quick_actions_property> <line_end>
<action_c_quick_actions_property> ::= "message1" ":" <ws> <string_like_value> (* data type: string *)
  | "message2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when quick_action_message1 is set *)
<action_c_security> ::= <indent> "security" <ws> "{" <line_end> { <action_c_security_property_line> } <indent> "}" <line_end>
<action_c_security_property_line> ::= <indent> <action_c_security_property> <line_end>
<action_c_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<action_c_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <action_c_server_side_condition_property_line> } <indent> "}" <line_end>
<action_c_server_side_condition_property_line> ::= <indent> <action_c_server_side_condition_property> <line_end>
<action_c_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<action_c_settings> ::= <indent> "settings" <ws> "{" <line_end> { <action_c_settings_property_line> } <indent> "}" <line_end>
<action_c_settings_property_line> ::= <indent> <action_c_settings_property> <line_end>
<action_c_settings_property> ::= "action" ":" <ws> ( "subscription" | "aggregate" | "flashback" | "filters" | "columns" | "compute" | "pivot" | "controlBreak" | "download" | "groupBy" | "saveReport" | "sort" | "chart" | "highlight" ) (* required; data type: string; lov: STATIC *)
  | "cancelLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "class" ":" <ws> <string_like_value> (* required; data type: string *)
  | "clearErrors" ":" <ws> <boolean> (* required; data type: boolean *)
  | "confirmLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "cssClasses" ":" <ws> <string_like_value> (* data type: string *)
  | "enableHighAccuracy" ":" <ws> <boolean> (* required; data type: boolean *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (SQL_STATEMENT) or type in (PLSQL_EXPRESSION) or type in (FUNCTION_BODY) *)
  | "filePassword" ":" <ws> <string_like_value> (* data type: string *)
  | "fileSource" ":" <ws> ( "sqlQuery" | "fileUrls" ) (* required; conditional; data type: string; lov: STATIC; applies when share_type = files *)
  | "fileUrls" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = file_url *)
  | "filename" ":" <ws> <string_like_value> (* data type: string *)
  | "hidePageItemsOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = geojson *)
  | "itemsToReturn" ":" <ws> <string_like_value> (* data type: string *)
  | "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "jsCode" ":" <ws> <string_like_value> (* required; data type: string *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = JAVASCRIPT_EXPRESSION *)
  | "jsFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = javascript_code *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; data type: string; lov: STATIC *)
  | "latitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "longitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "maintainPagination" ":" <ws> <boolean> (* required; data type: boolean *)
  | "message" ":" <ws> <string_like_value> (* required; data type: string *)
  | "okLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = PLSQL *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY *)
  | "reportQuery" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: reportQuery; dynamic values omitted *)
  | "requestButtonName" ":" <ws> <string_like_value> (* data type: string *)
  | "returnItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = DIALOG_RETURN_ITEM *)
  | "returnType" ":" <ws> ( "jsFunction" | "latitudeAndLongitude" | "geojson" ) (* required; data type: string; lov: STATIC *)
  | "showAllOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "showProcessing" ":" <ws> <boolean> (* required; data type: boolean *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = sql_query *)
  | "style" ":" <ws> ( "information" | "danger" | "warning" | "success" ) (* data type: string; lov: STATIC *)
  | "styleName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when items_to_return is set *)
  | "text" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "url" | "currentPage" | "files" ) (* required; data type: string; lov: STATIC *)
  | "type" ":" <ws> ( "plsqlExpression" | "dialogReturnItem" | "static" | "plsqlFunctionBody" | "sqlQuery" | "jsExpression" ) (* required; data type: string; lov: STATIC *)
  | "url" ":" <ws> <value> (* required; conditional; data type: complex; applies when share_type = url *)
  | "value" ":" <ws> <string_like_value> (* data type: string *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; data type: string; lov: STATIC *)
<action_c_source> ::= <indent> "source" <ws> "{" <line_end> { <action_c_source_property_line> } <indent> "}" <line_end>
