<custom_attribute_component_lov_property_line> ::= <indent> <custom_attribute_component_lov_property> <line_end>
<custom_attribute_component_lov_property> ::= "componentType" ":" <ws> <string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = component; dynamic values omitted *)
  | "nullText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (selectList) and required = false or type in (component) and required = false *)
  | "onDeleteBehavior" ":" <ws> ( "cascade" | "setToNull" ) (* conditional; data type: string; lov: STATIC; applies when type = component and componentType is set *)
  | "type" ":" <ws> ( "static" | "component" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (selectList) or type in (checkboxes) *)
<custom_attribute_default> ::= <indent> "default" <ws> "{" <line_end> { <custom_attribute_default_property_line> } <indent> "}" <line_end>
<custom_attribute_default_property_line> ::= <indent> <custom_attribute_default_property> <line_end>
<custom_attribute_default_property> ::= "sampleDataValue" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type in (templateComponent) or type in (region) *)
  | "value" ":" <ws> <multiline_string> (* conditional; data type: string *)
  | "value" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = yesNo *)
<custom_attribute_depending_on> ::= <indent> "dependingOn" <ws> "{" <line_end> { <custom_attribute_depending_on_property_line> } <indent> "}" <line_end>
