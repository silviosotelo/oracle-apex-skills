  | "type" ":" <ws> ( "centeredStepped" | "curved" | "centeredSegmented" | "stepped" | "segmented" | "straight" | "auto" | "none" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (line) or type in (lineWithArea) or type in (area) or other dependency conditions are satisfied *)
  | "width" ":" <ws> <number> (* conditional; data type: integer; applies when type in (line) or type in (lineWithArea) or type in (bubble) or other dependency conditions are satisfied *)
