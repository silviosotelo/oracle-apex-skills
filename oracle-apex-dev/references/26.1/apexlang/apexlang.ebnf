  | "valueAggregation" ":" <ws> ( "count" | "sum" | "average" | "median" | "min" | "max" | "countDistinct" | "approxCountDistinct" ) (* conditional; data type: string; lov: STATIC; applies when type in (area) and location in (localDatabase) or type in (area) and location in (restEnabledSql) or type in (bar) and location in (localDatabase) or other dependency conditions are satisfied *)
