  | "type" ":" <ws> ( "rowsReturned" | "noRowsReturned" | "expression" | "functionBody" | "item=value" | "item!=value" | "itemIsNull" | "itemIsNotNull" | "itemIsZero" | "itemIsNotZero" | "itemIsNullOrZero" | "itemIsNotNullAndNotZero" | "itemContainsNoSpaces" | "itemIsNumeric" | "itemIsNotNumeric" | "itemIsAlphanumeric" | "itemIsInColonDelimitedList" | "itemIsNotInColonDelimitedList" | "textIsContainedInItem" | "text=value" | "text!=value" | "textIsContainedInValue" | "textIsNotContainedInValue" | "never" ) (* data type: string; lov: STATIC *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
