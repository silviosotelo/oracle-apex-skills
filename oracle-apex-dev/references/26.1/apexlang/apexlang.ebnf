  | "comparePlsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = EXPRESSION *)
  | "comparePlsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = FUNCTION_BODY *)
  | "compareSqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = SQL_QUERY *)
  | "compareType" ":" <ws> ( "expression" | "sqlQuery" | "functionBody" ) (* required; conditional; data type: string; lov: STATIC; applies when type = CASE *)
  | "compareVar" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CHECK_WF_VARIABLE *)
  | "dataType" ":" <ws> ( "timestampWithLocalTimeZone" | "number" | "varchar2" | "boolean" | "timestamp" | "timestampWithTimeZone" ) (* required; conditional; data type: string; lov: STATIC; applies when type = CASE *)
