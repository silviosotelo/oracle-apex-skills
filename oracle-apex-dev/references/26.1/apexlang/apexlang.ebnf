  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when location = jsonDualityView and jsonDualityView is set and type = plsqlFunctionBody and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when location = jsonSource and jsonSource is set and type = plsqlFunctionBody and language = javaScript-mle *)
