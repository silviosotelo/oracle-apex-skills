<parameter_l_parameter_property> ::= "ignoreOutput" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name supports IN_OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = interactiveGrid and enabled = true or name supports IN_OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = form and enabled = true or name supports OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = interactiveGrid and enabled = true or other dependency conditions are satisfied *)
