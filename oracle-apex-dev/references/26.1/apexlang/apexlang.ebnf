<layer_config> ::= <indent> "config" <ws> "{" <line_end> { <layer_config_property_line> } <indent> "}" <line_end>
<layer_config_property_line> ::= <indent> <layer_config_property> <line_end>
<layer_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<layer_data_profile> ::= <indent> "dataProfile" <ws> "{" <line_end> { <layer_data_profile_property_line> } <indent> "}" <line_end>
<layer_data_profile_property_line> ::= <indent> <layer_data_profile_property> <line_end>
<layer_data_profile_property> ::= "nestedRows" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: dataProfileColumn; applies when location = jsonDualityView and jsonDualityView supports HAS_ARRAY_COLUMNS; dynamic values omitted *)
  | "nestedRows" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: dataProfileColumn; applies when location = jsonSource and jsonSource supports HAS_ARRAY_COLUMNS; dynamic values omitted *)
  | "nestedRows" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: dataProfileColumn; applies when location = restSource and restSource supports HAS_ARRAY_COLUMNS; dynamic values omitted *)
<layer_external_filter_and_order_by> ::= <indent> "externalFilterAndOrderBy" <ws> "{" <line_end> { <layer_external_filter_and_order_by_property_line> } <indent> "}" <line_end>
<layer_external_filter_and_order_by_property_line> ::= <indent> <layer_external_filter_and_order_by_property> <line_end>
<layer_external_filter_and_order_by_property> ::= "enabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when location = restSource and restSource is set and restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS and useLocalTable in (false) or location = restSource and restSource is set and restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS and useLocalTable in ($NULL$) or location = restSource and restSource is set and restSource supports HAS_ARRAY_COLUMNS and restSource supports HAS_SYNC_ALL_ARRAY_COLUMNS and useLocalTable in (false) or other dependency conditions are satisfied *)
  | "filter" ":" <ws> <multiline_string> (* conditional; data type: string; applies when location = restSource and restSource is set and restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS and useLocalTable in (false) and enabled = true or location = restSource and restSource is set and restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS and useLocalTable in ($NULL$) and enabled = true or location = restSource and restSource is set and restSource supports HAS_ARRAY_COLUMNS and restSource supports HAS_SYNC_ALL_ARRAY_COLUMNS and useLocalTable in (false) and enabled = true or other dependency conditions are satisfied *)
  | "orderBy" ":" <ws> <multiline_string> (* conditional; data type: string; applies when location = restSource and restSource is set and restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS and useLocalTable in (false) and enabled = true or location = restSource and restSource is set and restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS and useLocalTable in ($NULL$) and enabled = true or location = restSource and restSource is set and restSource supports HAS_ARRAY_COLUMNS and restSource supports HAS_SYNC_ALL_ARRAY_COLUMNS and useLocalTable in (false) and enabled = true or other dependency conditions are satisfied *)
<layer_info_window> ::= <indent> "infoWindow" <ws> "{" <line_end> { <layer_info_window_property_line> } <indent> "}" <line_end>
<layer_info_window_property_line> ::= <indent> <layer_info_window_property> <line_end>
<layer_info_window_property> ::= "advancedFormatting" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
  | "bodyColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when advancedFormatting = false *)
  | "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when advancedFormatting = true *)
  | "htmlExpression" ":" <ws> <multiline_string> (* conditional; data type: string; applies when advancedFormatting = true *)
  | "titleColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when advancedFormatting = false *)
