<plugin_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <plugin_advanced_property_line> } <indent> "}" <line_end>
<plugin_advanced_property_line> ::= <indent> <plugin_advanced_property> <line_end>
<plugin_advanced_property> ::= "category" ":" <ws> ( "component" | "effect" | "execute" | "initialize" | "miscellaneous" | "navigation" | "notification" | "style" | "builtInComponents" | "appComponents" | "themeComponents" | "ai" ) (* conditional; data type: string; lov: STATIC; applies when type = dynamicAction *)
  | "deprecated" ":" <ws> <boolean> (* required; data type: boolean *)
  | "filePrefix" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (region) or type in (dynamicAction) or type in (item) or other dependency conditions are satisfied *)
  | "legacy" ":" <ws> <boolean> (* required; data type: boolean *)
  | "quickPick" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = templateComponent *)
  | "substituteAttributeValues" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when apiInterface in (function) or apiInterface in (procedureWithLegacyAttributes) *)
<plugin_ai_tool> ::= <indent> "aiTool" <ws> "{" <line_end> { <plugin_ai_tool_property_line> } <indent> "}" <line_end>
<plugin_ai_tool_property_line> ::= <indent> <plugin_ai_tool_property> <line_end>
<plugin_ai_tool_property> ::= "executionLocation" ":" <ws> ( "clientSide" | "serverSide" ) (* required; conditional; data type: string; lov: STATIC; applies when type = genAITool *)
  | "supportedExecutionPoints" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; lov: STATIC; applies when type = genAITool *)
<plugin_callbacks> ::= <indent> "callbacks" <ws> "{" <line_end> { <plugin_callbacks_property_line> } <indent> "}" <line_end>
<plugin_callbacks_property_line> ::= <indent> <plugin_callbacks_property> <line_end>
<plugin_callbacks_property> ::= "aiRequestHandlerProcedure" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = region and standardAttributes in (configurableAiEnabled) or type = region and standardAttributes in (aiEnabled) or type = item and standardAttributes in (configurableAiEnabled) or other dependency conditions are satisfied *)
  | "aiResponseHandlerProcedure" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = region and standardAttributes in (configurableAiEnabled) or type = region and standardAttributes in (aiEnabled) or type = item and standardAttributes in (configurableAiEnabled) or other dependency conditions are satisfied *)
  | "ajaxProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (authenticationScheme) or type in (dynamicAction) or type in (region) or other dependency conditions are satisfied *)
  | "apiInterface" ":" <ws> ( "procedure" | "procedureWithLegacyAttributes" | "function" ) (* required; conditional; data type: string; lov: STATIC *)
  | "authenticationProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = authenticationScheme *)
  | "completionFunctionProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = process and standardAttributes = waitForCompletion *)
  | "executionFunctionProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (authorizationScheme) or type in (process) or type = genAITool and executionLocation = serverSide *)
  | "invalidSessionProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = authenticationScheme *)
  | "metaDataProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = item *)
  | "postLogoutProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = authenticationScheme *)
  | "renderProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (dynamicAction) or type in (item) or type in (region) or other dependency conditions are satisfied *)
  | "restSourceCapabilitiesProcedure" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = restDataSource *)
  | "restSourceDiscoverProcedure" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = restDataSource *)
  | "restSourceDmlProcedure" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = restDataSource *)
  | "restSourceExecuteProcedure" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = restDataSource *)
  | "restSourceFetchProcedure" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = restDataSource *)
  | "sessionSentryProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = authenticationScheme *)
  | "terminationFunctionProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = process and standardAttributes = waitForCompletion *)
  | "validationProcedureName" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = item *)
<plugin_comments> ::= <indent> "comments" <ws> "{" <line_end> { <plugin_comments_property_line> } <indent> "}" <line_end>
<plugin_comments_property_line> ::= <indent> <plugin_comments_property> <line_end>
