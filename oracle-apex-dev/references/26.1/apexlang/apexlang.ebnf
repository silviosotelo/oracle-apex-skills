  | "hot" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when position supports TEMPLATE and template supports IS_HOT or position supports TMPL_IS_HOT *)
  | "icon" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when position supports TEMPLATE and template supports ICON_CLASSES and displayType in (icon) or position supports TEMPLATE and template supports ICON_CLASSES and displayType in (textWithIcon) or position supports TMPL_ICON_CLASSES and displayType in (icon) or other dependency conditions are satisfied *)
  | "showAsDisabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when position supports TEMPLATE and template supports IS_DISABLED or position supports TMPL_IS_DISABLED *)
