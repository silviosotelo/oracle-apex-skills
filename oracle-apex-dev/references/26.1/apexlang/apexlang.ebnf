  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = functionBody and language = javaScript-mle or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = functionBody and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = dynamicContent and language = javaScript-mle *)
  | "jsonDualityView" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: jsonDualityView; applies when type supports SOURCE_LOCATION and location = jsonDualityView; dynamic values omitted *)
  | "jsonSource" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: jsonSource; applies when type supports SOURCE_LOCATION and location = jsonSource; dynamic values omitted *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = functionBody or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = functionBody *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = dynamicContent *)
  | "list" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: list; applies when type in (list); dynamic values omitted *)
  | "location" ":" <ws> ( "localDatabase" | "restEnabledSql" | "restSource" | "jsonDualityView" | "jsonSource" | "sampleData" ) (* conditional; data type: string; lov: STATIC; applies when type supports SOURCE_LOCATION *)
  | "matchClause" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = propertyGraph or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = propertyGraph *)
  | "optimizerHint" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) or type supports SOURCE_LOCATION and location in (restEnabledSql) or type supports SOURCE_LOCATION and location in (restSource) or other dependency conditions are satisfied *)
  | "orderByClause" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = tableView and type in (interactiveGrid) or type supports SOURCE_LOCATION and location in (localDatabase) and type = tableView and type in (interactiveReport) or type supports SOURCE_LOCATION and location in (localDatabase) and type = tableView and type in (map) or other dependency conditions are satisfied *)
  | "orderByClause" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = propertyGraph and type in (interactiveGrid) or type supports SOURCE_LOCATION and location in (localDatabase) and type = propertyGraph and type in (interactiveReport) or type supports SOURCE_LOCATION and location in (localDatabase) and type = propertyGraph and type in (map) or other dependency conditions are satisfied *)
  | "pageItemsToSubmit" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type supports AJAX_ITEMS_TO_SUBMIT *)
  | "plsqlCode" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE_PLSQL *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE_PLSQL_FUNCTION *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = functionBody and language = plsql or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = functionBody and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = dynamicContent and language = plsql *)
