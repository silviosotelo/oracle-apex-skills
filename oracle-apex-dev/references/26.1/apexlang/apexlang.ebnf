  | "time" ":" <ws> <number> (* required; conditional; data type: integer; applies when eventScope in (static) and type in (debounce) or eventScope in (static) and type in (throttle) or eventScope in (dynamic) and type in (debounce) or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "immediate" | "debounce" | "throttle" ) (* required; conditional; data type: string; lov: STATIC; applies when eventScope in (static) or eventScope in (dynamic) *)
<dynamic_action_security> ::= <indent> "security" <ws> "{" <line_end> { <dynamic_action_security_property_line> } <indent> "}" <line_end>
