  | "showEndDate" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = chart and show = true and type = gantt *)
  | "showGroupName" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = chart and show = true *)
