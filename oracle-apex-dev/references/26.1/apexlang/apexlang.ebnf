(* facet *)
(* direct properties use default group: identification *)
<facet> ::= "facet" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <facet_body_line> } <indent> ")" <line_end>
<facet_body_line> ::= <facet_direct_property_line>
  | <facet_group_block>
<facet_direct_property_line> ::= <indent> <facet_direct_property> <line_end>
<facet_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> <facet_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
<facet_group_block> ::= <facet_actions_menu>
  | <facet_advanced>
  | <facet_appearance>
  | <facet_cascading_lov>
  | <facet_comments>
  | <facet_config>
  | <facet_cropping>
  | <facet_default>
  | <facet_depending_on>
  | <facet_display>
  | <facet_geocoding_input>
  | <facet_geocoding_result>
  | <facet_label>
  | <facet_layout>
  | <facet_list_entries>
  | <facet_lov>
  | <facet_messages>
  | <facet_multiple_values>
  | <facet_qr_code>
  | <facet_resize_to>
  | <facet_search>
  | <facet_security>
  | <facet_server_side_condition>
  | <facet_settings>
  | <facet_source>
  | <facet_storage>
<facet_actions_menu> ::= <indent> "actionsMenu" <ws> "{" <line_end> { <facet_actions_menu_property_line> } <indent> "}" <line_end>
<facet_actions_menu_property_line> ::= <indent> <facet_actions_menu_property> <line_end>
<facet_actions_menu_property> ::= "chart" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_HAS_FEEDBACK and computeCounts = true and type supports LOV and type is set *)
  | "filter" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_FILTER_VALUES and type supports LOV and type is set and display = inline *)
<facet_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <facet_advanced_property_line> } <indent> "}" <line_end>
<facet_advanced_property_line> ::= <indent> <facet_advanced_property> <line_end>
<facet_advanced_property> ::= "collapsible" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when display = inline *)
  | "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when display = inline *)
  | "initiallyCollapsed" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when display = inline and collapsible = true *)
  | "showChartInitially" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports FC_HAS_FEEDBACK and computeCounts = true and type supports LOV and type is set and chart = true and display = inline *)
<facet_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <facet_appearance_property_line> } <indent> "}" <line_end>
<facet_appearance_property_line> ::= <indent> <facet_appearance_property> <line_end>
<facet_appearance_property> ::= "display" ":" <ws> ( "inline" | "addFilterDialog" ) (* required; conditional; data type: string; lov: STATIC *)
  | "formatMask" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports FORMAT_MASK_DATE and dataType in (date) or type supports FORMAT_MASK_DATE and dataType in (timestamp) or type supports FORMAT_MASK_DATE and dataType in (timestampWithTimeZone) or other dependency conditions are satisfied *)
  | "icon" ":" <ws> <string_like_value> (* conditional; data type: string *)
  | "valuePlaceholder" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports PLACEHOLDER *)
<facet_cascading_lov> ::= <indent> "cascadingLov" <ws> "{" <line_end> { <facet_cascading_lov_property_line> } <indent> "}" <line_end>
<facet_cascading_lov_property_line> ::= <indent> <facet_cascading_lov_property> <line_end>
<facet_cascading_lov_property> ::= "lovColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports LOV and type = sharedComponent and parentFacet is set *)
  | "parentFacet" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports LOV and type = sharedComponent *)
  | "parentRequired" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports LOV and type = sharedComponent and parentFacet is set *)
<facet_comments> ::= <indent> "comments" <ws> "{" <line_end> { <facet_comments_property_line> } <indent> "}" <line_end>
<facet_comments_property_line> ::= <indent> <facet_comments_property> <line_end>
<facet_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<facet_config> ::= <indent> "config" <ws> "{" <line_end> { <facet_config_property_line> } <indent> "}" <line_end>
<facet_config_property_line> ::= <indent> <facet_config_property> <line_end>
<facet_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<facet_cropping> ::= <indent> "cropping" <ws> "{" <line_end> { <facet_cropping_property_line> } <indent> "}" <line_end>
<facet_cropping_property_line> ::= <indent> <facet_cropping_property> <line_end>
<facet_cropping_property> ::= "allowCropping" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when storage_type = APEX_APPLICATION_TEMP_FILES *)
  | "aspectRatio" ":" <ws> ( "original" | "univisium" | "standard" | "square" | "widescreen" | "custom" ) (* required; conditional; data type: string; lov: STATIC; applies when storage_type = APEX_APPLICATION_TEMP_FILES and allow_cropping = Y *)
  | "customAspectRatio" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when storage_type = APEX_APPLICATION_TEMP_FILES and allow_cropping = Y and aspect_ratio = CUSTOM *)
<facet_default> ::= <indent> "default" <ws> "{" <line_end> { <facet_default_property_line> } <indent> "}" <line_end>
<facet_default_property_line> ::= <indent> <facet_default_property> <line_end>
<facet_default_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports SOURCE and type = item *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE and type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE and type = functionBody *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = functionBody and language = plsql *)
  | "sequence" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports SOURCE and type = sequence *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = expression and language = sql *)
  | "sqlQueryMultipleValues" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = sqlQueryMultipleValues *)
  | "sqlQuerySingleValue" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = sqlQuerySingleValue *)
  | "staticValue" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE and type = static *)
  | "type" ":" <ws> ( "static" | "item" | "sqlQuerySingleValue" | "sqlQueryMultipleValues" | "expression" | "functionBody" | "sequence" ) (* conditional; data type: string; lov: STATIC; applies when type supports SOURCE *)
<facet_depending_on> ::= <indent> "dependingOn" <ws> "{" <line_end> { <facet_depending_on_property_line> } <indent> "}" <line_end>
<facet_depending_on_property_line> ::= <indent> <facet_depending_on_property> <line_end>
<facet_depending_on_property> ::= "facet" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: facet; dynamic values omitted *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when facet is set and type in (inList) or facet is set and type in (notInList) *)
  | "type" ":" <ws> ( "=" | "!=" | "inList" | "notInList" | "isNull" | "isNotNull" ) (* required; conditional; data type: string; lov: STATIC; applies when facet is set *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when facet is set and type in (=) or facet is set and type in (!=) *)
<facet_display> ::= <indent> "display" <ws> "{" <line_end> { <facet_display_property_line> } <indent> "}" <line_end>
<facet_display_property_line> ::= <indent> <facet_display_property> <line_end>
<facet_display_property> ::= "allowCopyPaste" ":" <ws> <boolean> (* required; data type: boolean *)
  | "captureUsing" ":" <ws> ( "selfieCamera" | "mainCamera" ) (* data type: string; lov: STATIC *)
  | "contentDisposition" ":" <ws> ( "inline" | "attachment" ) (* required; conditional; data type: string; lov: STATIC; applies when storage_type = DB_COLUMN and display_download_link = Y *)
  | "displayAs" ":" <ws> ( "inlineFileBrowse" | "inlineDropzone" | "blockDropzone" | "nativeFileBrowse" ) (* required; data type: string; lov: STATIC *)
  | "displayDownloadLink" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when storage_type = DB_COLUMN *)
  | "downloadLinkText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when storage_type = DB_COLUMN and display_download_link = Y *)
  | "dropzoneDesc" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as in (DROPZONE_INLINE) or display_as in (DROPZONE_BLOCK) *)
  | "dropzoneTitle" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as in (INLINE) or display_as in (DROPZONE_INLINE) or display_as in (DROPZONE_BLOCK) *)
  | "previewSize" ":" <ws> ( "extraLarge" | "extraSmall" | "auto" | "large" | "medium" | "small" ) (* required; conditional; data type: string; lov: STATIC; applies when display_as = DROPZONE_ICON *)
<facet_geocoding_input> ::= <indent> "geocodingInput" <ws> "{" <line_end> { <facet_geocoding_input_property_line> } <indent> "}" <line_end>
<facet_geocoding_input_property_line> ::= <indent> <facet_geocoding_input_property> <line_end>
<facet_geocoding_input_property> ::= "addressItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when structured_address = N *)
  | "cityItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "citySubAreaItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "country" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when country_type = ITEM *)
  | "country" ":" <ws> <string_like_value> (* required; conditional; data type: string; lov: STATIC; applies when country_type = STATIC; dynamic values omitted *)
  | "countryType" ":" <ws> ( "static" | "item" ) (* required; data type: string; lov: STATIC *)
  | "houseNoItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "postalCodeItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "regionItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "streetItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when structured_address = Y *)
<facet_geocoding_result> ::= <indent> "geocodingResult" <ws> "{" <line_end> { <facet_geocoding_result_property_line> } <indent> "}" <line_end>
