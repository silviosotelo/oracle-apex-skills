(* menu *)
(* direct properties use default group: identification *)
<menu_b> ::= "menu" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <menu_b_body_line> } <indent> ")" <line_end>
<menu_b_body_line> ::= <menu_b_direct_property_line>
  | <menu_b_group_block>
  | <menu_b_child_component>
<menu_b_direct_property_line> ::= <indent> <menu_b_direct_property> <line_end>
<menu_b_direct_property> ::= "label" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) or type in (subMenu) *)
  | "parentMenu" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: menu; dynamic values omitted *)
  | "type" ":" <ws> ( "menuEntry" | "subMenu" | "separator" ) (* required; data type: string; lov: STATIC *)
<menu_b_group_block> ::= <menu_b_advanced>
  | <menu_b_appearance>
  | <menu_b_behavior>
  | <menu_b_comments>
  | <menu_b_config>
  | <menu_b_layout>
  | <menu_b_security>
  | <menu_b_server_side_condition>
<menu_b_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <menu_b_advanced_property_line> } <indent> "}" <line_end>
<menu_b_advanced_property_line> ::= <indent> <menu_b_advanced_property> <line_end>
<menu_b_advanced_property> ::= "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<menu_b_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <menu_b_appearance_property_line> } <indent> "}" <line_end>
<menu_b_appearance_property_line> ::= <indent> <menu_b_appearance_property> <line_end>
<menu_b_appearance_property> ::= "icon" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (menuEntry) or type in (subMenu) *)
<menu_b_behavior> ::= <indent> "behavior" <ws> "{" <line_end> { <menu_b_behavior_property_line> } <indent> "}" <line_end>
<menu_b_behavior_property_line> ::= <indent> <menu_b_behavior_property> <line_end>
<menu_b_behavior_property> ::= "linkAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = menuEntry and type in (redirectThisApp) or type = menuEntry and type in (redirectOtherApp) or type = menuEntry and type in (redirectUrl) *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = menuEntry and type = redirectThisApp *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = menuEntry and type = redirectOtherApp *)
  | "targetUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = menuEntry and type = redirectUrl *)
  | "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "triggerAction" ) (* required; conditional; data type: string; lov: STATIC; applies when type = menuEntry *)
<menu_b_comments> ::= <indent> "comments" <ws> "{" <line_end> { <menu_b_comments_property_line> } <indent> "}" <line_end>
<menu_b_comments_property_line> ::= <indent> <menu_b_comments_property> <line_end>
<menu_b_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<menu_b_config> ::= <indent> "config" <ws> "{" <line_end> { <menu_b_config_property_line> } <indent> "}" <line_end>
<menu_b_config_property_line> ::= <indent> <menu_b_config_property> <line_end>
<menu_b_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<menu_b_layout> ::= <indent> "layout" <ws> "{" <line_end> { <menu_b_layout_property_line> } <indent> "}" <line_end>
<menu_b_layout_property_line> ::= <indent> <menu_b_layout_property> <line_end>
<menu_b_layout_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
<menu_b_security> ::= <indent> "security" <ws> "{" <line_end> { <menu_b_security_property_line> } <indent> "}" <line_end>
<menu_b_security_property_line> ::= <indent> <menu_b_security_property> <line_end>
<menu_b_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* conditional; data type: string; lov: COMPONENT; references: authorization; applies when type in (menuEntry) or type in (subMenu); dynamic values omitted *)
<menu_b_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <menu_b_server_side_condition_property_line> } <indent> "}" <line_end>
<menu_b_server_side_condition_property_line> ::= <indent> <menu_b_server_side_condition_property> <line_end>
<menu_b_server_side_condition_property> ::= "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (menuEntry) and type is set or type in (menuEntry) and type is set and type in (subMenu) or type in (subMenu) and type is set and type in (menuEntry) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (item=value) or type in (menuEntry) and type in (item!=value) or type in (menuEntry) and type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type = textIsContainedInItem or type in (subMenu) and type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = javaScript-mle or type in (subMenu) and type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = functionBody and language = javaScript-mle or type in (subMenu) and type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (menuEntry) and type = expression or type in (subMenu) and type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (menuEntry) and type = functionBody or type in (subMenu) and type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (itemIsInColonDelimitedList) or type in (menuEntry) and type in (itemIsNotInColonDelimitedList) or type in (subMenu) and type in (itemIsInColonDelimitedList) or other dependency conditions are satisfied *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (menuEntry) and type in (currentPage=page) or type in (menuEntry) and type in (currentPage!=page) or type in (subMenu) and type in (currentPage=page) or other dependency conditions are satisfied *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (menuEntry) and type in (currentPageInList) or type in (menuEntry) and type in (currentPageNotInList) or type in (subMenu) and type in (currentPageInList) or other dependency conditions are satisfied *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = plsql or type in (subMenu) and type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = functionBody and language = plsql or type in (subMenu) and type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (userPreference=value) or type in (menuEntry) and type in (userPreference!=value) or type in (subMenu) and type in (userPreference=value) or other dependency conditions are satisfied *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = sql or type in (subMenu) and type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (rowsReturned) or type in (menuEntry) and type in (noRowsReturned) or type in (subMenu) and type in (rowsReturned) or other dependency conditions are satisfied *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (textIsContainedInItem) or type in (menuEntry) and type in (textIsContainedInValue) or type in (menuEntry) and type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* conditional; data type: string; lov: STATIC; applies when type in (menuEntry) or type in (subMenu); dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (request=Value) or type in (menuEntry) and type in (request!=Value) or type in (menuEntry) and type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (item=value) or type in (menuEntry) and type in (item!=value) or type in (menuEntry) and type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (textIsContainedInValue) or type in (menuEntry) and type in (textIsNotContainedInValue) or type in (menuEntry) and type in (text=value) or other dependency conditions are satisfied *)
<menu_b_child_component> ::= <trigger_action_g> (* applies when type = menuEntry and type = triggerAction *)

(* triggerAction *)
(* direct properties use default group: identification *)
<trigger_action_g> ::= "triggerAction" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <trigger_action_g_body_line> } <indent> ")" <line_end>
<trigger_action_g_body_line> ::= <trigger_action_g_direct_property_line>
  | <trigger_action_g_group_block>
<trigger_action_g_direct_property_line> ::= <indent> <trigger_action_g_direct_property> <line_end>
<trigger_action_g_direct_property> ::= "action" ":" <ws> <trigger_action_g_action_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<trigger_action_g_group_block> ::= <trigger_action_g_advanced>
  | <trigger_action_g_affected_elements>
  | <trigger_action_g_appearance>
  | <trigger_action_g_client_side_condition>
  | <trigger_action_g_comments>
  | <trigger_action_g_config>
  | <trigger_action_g_execution>
  | <trigger_action_g_file_handling>
  | <trigger_action_g_gen_ai>
  | <trigger_action_g_initial_prompt>
  | <trigger_action_g_input_value>
  | <trigger_action_g_quick_actions>
  | <trigger_action_g_security>
  | <trigger_action_g_server_side_condition>
  | <trigger_action_g_settings>
  | <trigger_action_g_source>
  | <trigger_action_g_use_response>
<trigger_action_g_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <trigger_action_g_advanced_property_line> } <indent> "}" <line_end>
<trigger_action_g_advanced_property_line> ::= <indent> <trigger_action_g_advanced_property> <line_end>
<trigger_action_g_advanced_property> ::= "initJavaScriptFunction" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports INIT_JAVASCRIPT_CODE *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<trigger_action_g_affected_elements> ::= <indent> "affectedElements" <ws> "{" <line_end> { <trigger_action_g_affected_elements_property_line> } <indent> "}" <line_end>
<trigger_action_g_affected_elements_property_line> ::= <indent> <trigger_action_g_affected_elements_property> <line_end>
<trigger_action_g_affected_elements_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when action supports ITEM and selectionType = button or action supports BUTTON and selectionType = button or action supports REGION and selectionType = button or other dependency conditions are satisfied; dynamic values omitted *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = items or action supports BUTTON and selectionType = items or action supports REGION and selectionType = items or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = javaScriptExpression or action supports BUTTON and selectionType = javaScriptExpression or action supports REGION and selectionType = javaScriptExpression or other dependency conditions are satisfied *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = jquerySelector or action supports BUTTON and selectionType = jquerySelector or action supports REGION and selectionType = jquerySelector or other dependency conditions are satisfied *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when action supports ITEM and selectionType = region or action supports BUTTON and selectionType = region or action supports REGION and selectionType = region or other dependency conditions are satisfied; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jquerySelector" | "javaScriptExpression" | "triggeringElement" | "eventSource" ) (* conditional; data type: string; lov: STATIC; applies when action supports ITEM or action supports BUTTON or action supports REGION or other dependency conditions are satisfied *)
<trigger_action_g_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <trigger_action_g_appearance_property_line> } <indent> "}" <line_end>
<trigger_action_g_appearance_property_line> ::= <indent> <trigger_action_g_appearance_property> <line_end>
<trigger_action_g_appearance_property> ::= "containerSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when display_as = INLINE *)
  | "displayAs" ":" <ws> ( "dialog" | "inline" ) (* required; data type: string; lov: STATIC *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as = DIALOG *)
<trigger_action_g_client_side_condition> ::= <indent> "clientSideCondition" <ws> "{" <line_end> { <trigger_action_g_client_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_g_client_side_condition_property_line> ::= <indent> <trigger_action_g_client_side_condition_property> <line_end>
<trigger_action_g_client_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInList) or type in (itemIsNotInList) *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* data type: string; lov: STATIC *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
<trigger_action_g_comments> ::= <indent> "comments" <ws> "{" <line_end> { <trigger_action_g_comments_property_line> } <indent> "}" <line_end>
<trigger_action_g_comments_property_line> ::= <indent> <trigger_action_g_comments_property> <line_end>
<trigger_action_g_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<trigger_action_g_config> ::= <indent> "config" <ws> "{" <line_end> { <trigger_action_g_config_property_line> } <indent> "}" <line_end>
<trigger_action_g_config_property_line> ::= <indent> <trigger_action_g_config_property> <line_end>
<trigger_action_g_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<trigger_action_g_execution> ::= <indent> "execution" <ws> "{" <line_end> { <trigger_action_g_execution_property_line> } <indent> "}" <line_end>
<trigger_action_g_execution_property_line> ::= <indent> <trigger_action_g_execution_property> <line_end>
<trigger_action_g_execution_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports STOP_EXECUTION_ON_ERROR *)
  | "waitForResult" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports WAIT_FOR_RESULT *)
<trigger_action_g_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <trigger_action_g_file_handling_property_line> } <indent> "}" <line_end>
<trigger_action_g_file_handling_property_line> ::= <indent> <trigger_action_g_file_handling_property> <line_end>
<trigger_action_g_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
  | "viewFileAs" ":" <ws> ( "inline" | "attachment" ) (* required; conditional; data type: string; lov: STATIC; applies when multiple_files = N *)
<trigger_action_g_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <trigger_action_g_gen_ai_property_line> } <indent> "}" <line_end>
<trigger_action_g_gen_ai_property_line> ::= <indent> <trigger_action_g_gen_ai_property> <line_end>
<trigger_action_g_gen_ai_property> ::= "agent" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: aiAgent; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "enabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports AI_ENABLED *)
  | "itemsToSubmit" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true *)
  | "service" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: genAIService; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "systemPrompt" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED and enabled = true *)
  | "welcomeMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_UI and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_UI and action supports AI_ENABLED and enabled = true *)
<trigger_action_g_initial_prompt> ::= <indent> "initialPrompt" <ws> "{" <line_end> { <trigger_action_g_initial_prompt_property_line> } <indent> "}" <line_end>
<trigger_action_g_initial_prompt_property_line> ::= <indent> <trigger_action_g_initial_prompt_property> <line_end>
<trigger_action_g_initial_prompt_property> ::= "displayedMessage" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "immediateActionPrompt" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = JAVASCRIPT_EXPRESSION *)
  | "type" ":" <ws> ( "item" | "jsExpression" ) (* data type: string; lov: STATIC *)
<trigger_action_g_input_value> ::= <indent> "inputValue" <ws> "{" <line_end> { <trigger_action_g_input_value_property_line> } <indent> "}" <line_end>
<trigger_action_g_input_value_property_line> ::= <indent> <trigger_action_g_input_value_property> <line_end>
<trigger_action_g_input_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = JAVASCRIPT *)
  | "type" ":" <ws> ( "jsCode" | "item" | "onlySystemPrompt" ) (* required; data type: string; lov: STATIC *)
<trigger_action_g_quick_actions> ::= <indent> "quickActions" <ws> "{" <line_end> { <trigger_action_g_quick_actions_property_line> } <indent> "}" <line_end>
<trigger_action_g_quick_actions_property_line> ::= <indent> <trigger_action_g_quick_actions_property> <line_end>
<trigger_action_g_quick_actions_property> ::= "message1" ":" <ws> <string_like_value> (* data type: string *)
  | "message2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when quick_action_message1 is set *)
<trigger_action_g_security> ::= <indent> "security" <ws> "{" <line_end> { <trigger_action_g_security_property_line> } <indent> "}" <line_end>
<trigger_action_g_security_property_line> ::= <indent> <trigger_action_g_security_property> <line_end>
<trigger_action_g_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<trigger_action_g_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <trigger_action_g_server_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_g_server_side_condition_property_line> ::= <indent> <trigger_action_g_server_side_condition_property> <line_end>
<trigger_action_g_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<trigger_action_g_settings> ::= <indent> "settings" <ws> "{" <line_end> { <trigger_action_g_settings_property_line> } <indent> "}" <line_end>
<trigger_action_g_settings_property_line> ::= <indent> <trigger_action_g_settings_property> <line_end>
<trigger_action_g_settings_property> ::= "action" ":" <ws> ( "subscription" | "aggregate" | "flashback" | "filters" | "columns" | "compute" | "pivot" | "controlBreak" | "download" | "groupBy" | "saveReport" | "sort" | "chart" | "highlight" ) (* required; data type: string; lov: STATIC *)
  | "cancelLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "class" ":" <ws> <string_like_value> (* required; data type: string *)
  | "clearErrors" ":" <ws> <boolean> (* required; data type: boolean *)
  | "confirmLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "cssClasses" ":" <ws> <string_like_value> (* data type: string *)
  | "enableHighAccuracy" ":" <ws> <boolean> (* required; data type: boolean *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (SQL_STATEMENT) or type in (PLSQL_EXPRESSION) or type in (FUNCTION_BODY) *)
  | "filePassword" ":" <ws> <string_like_value> (* data type: string *)
  | "fileSource" ":" <ws> ( "sqlQuery" | "fileUrls" ) (* required; conditional; data type: string; lov: STATIC; applies when share_type = files *)
  | "fileUrls" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = file_url *)
  | "filename" ":" <ws> <string_like_value> (* data type: string *)
  | "hidePageItemsOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = geojson *)
  | "itemsToReturn" ":" <ws> <string_like_value> (* data type: string *)
  | "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "jsCode" ":" <ws> <string_like_value> (* required; data type: string *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = JAVASCRIPT_EXPRESSION *)
  | "jsFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = javascript_code *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; data type: string; lov: STATIC *)
  | "latitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "longitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "maintainPagination" ":" <ws> <boolean> (* required; data type: boolean *)
  | "message" ":" <ws> <string_like_value> (* required; data type: string *)
  | "okLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = PLSQL *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY *)
  | "reportQuery" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: reportQuery; dynamic values omitted *)
  | "requestButtonName" ":" <ws> <string_like_value> (* data type: string *)
  | "returnItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = DIALOG_RETURN_ITEM *)
  | "returnType" ":" <ws> ( "jsFunction" | "latitudeAndLongitude" | "geojson" ) (* required; data type: string; lov: STATIC *)
  | "showAllOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "showProcessing" ":" <ws> <boolean> (* required; data type: boolean *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = sql_query *)
  | "style" ":" <ws> ( "information" | "danger" | "warning" | "success" ) (* data type: string; lov: STATIC *)
  | "styleName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when items_to_return is set *)
  | "text" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "url" | "currentPage" | "files" ) (* required; data type: string; lov: STATIC *)
  | "type" ":" <ws> ( "plsqlExpression" | "dialogReturnItem" | "static" | "plsqlFunctionBody" | "sqlQuery" | "jsExpression" ) (* required; data type: string; lov: STATIC *)
  | "url" ":" <ws> <value> (* required; conditional; data type: complex; applies when share_type = url *)
  | "value" ":" <ws> <string_like_value> (* data type: string *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; data type: string; lov: STATIC *)
<trigger_action_g_source> ::= <indent> "source" <ws> "{" <line_end> { <trigger_action_g_source_property_line> } <indent> "}" <line_end>
<trigger_action_g_source_property_line> ::= <indent> <trigger_action_g_source_property> <line_end>
<trigger_action_g_source_property> ::= "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = N *)
<trigger_action_g_use_response> ::= <indent> "useResponse" <ws> "{" <line_end> { <trigger_action_g_use_response_property_line> } <indent> "}" <line_end>
<trigger_action_g_use_response_property_line> ::= <indent> <trigger_action_g_use_response_property> <line_end>
<trigger_action_g_use_response_property> ::= "buttonLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = ITEM *)
  | "jsCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = JAVASCRIPT *)
  | "jsDetectionExpression" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_response_type = ITEM *)
  | "type" ":" <ws> ( "item" | "jsCode" ) (* data type: string; lov: STATIC *)

(* triggerAction *)
(* direct properties use default group: identification *)
<trigger_action_f> ::= "triggerAction" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <trigger_action_f_body_line> } <indent> ")" <line_end>
<trigger_action_f_body_line> ::= <trigger_action_f_direct_property_line>
  | <trigger_action_f_group_block>
<trigger_action_f_direct_property_line> ::= <indent> <trigger_action_f_direct_property> <line_end>
<trigger_action_f_direct_property> ::= "action" ":" <ws> <trigger_action_f_action_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<trigger_action_f_group_block> ::= <trigger_action_f_advanced>
  | <trigger_action_f_affected_elements>
  | <trigger_action_f_appearance>
  | <trigger_action_f_client_side_condition>
  | <trigger_action_f_comments>
  | <trigger_action_f_config>
  | <trigger_action_f_execution>
  | <trigger_action_f_file_handling>
  | <trigger_action_f_gen_ai>
  | <trigger_action_f_initial_prompt>
  | <trigger_action_f_input_value>
  | <trigger_action_f_quick_actions>
  | <trigger_action_f_security>
  | <trigger_action_f_server_side_condition>
  | <trigger_action_f_settings>
  | <trigger_action_f_source>
  | <trigger_action_f_use_response>
<trigger_action_f_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <trigger_action_f_advanced_property_line> } <indent> "}" <line_end>
<trigger_action_f_advanced_property_line> ::= <indent> <trigger_action_f_advanced_property> <line_end>
<trigger_action_f_advanced_property> ::= "initJavaScriptFunction" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports INIT_JAVASCRIPT_CODE *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<trigger_action_f_affected_elements> ::= <indent> "affectedElements" <ws> "{" <line_end> { <trigger_action_f_affected_elements_property_line> } <indent> "}" <line_end>
<trigger_action_f_affected_elements_property_line> ::= <indent> <trigger_action_f_affected_elements_property> <line_end>
<trigger_action_f_affected_elements_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when action supports ITEM and selectionType = button or action supports BUTTON and selectionType = button or action supports REGION and selectionType = button or other dependency conditions are satisfied; dynamic values omitted *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = items or action supports BUTTON and selectionType = items or action supports REGION and selectionType = items or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = javaScriptExpression or action supports BUTTON and selectionType = javaScriptExpression or action supports REGION and selectionType = javaScriptExpression or other dependency conditions are satisfied *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = jquerySelector or action supports BUTTON and selectionType = jquerySelector or action supports REGION and selectionType = jquerySelector or other dependency conditions are satisfied *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when action supports ITEM and selectionType = region or action supports BUTTON and selectionType = region or action supports REGION and selectionType = region or other dependency conditions are satisfied; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jquerySelector" | "javaScriptExpression" | "triggeringElement" | "eventSource" ) (* conditional; data type: string; lov: STATIC; applies when action supports ITEM or action supports BUTTON or action supports REGION or other dependency conditions are satisfied *)
<trigger_action_f_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <trigger_action_f_appearance_property_line> } <indent> "}" <line_end>
<trigger_action_f_appearance_property_line> ::= <indent> <trigger_action_f_appearance_property> <line_end>
<trigger_action_f_appearance_property> ::= "containerSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when display_as = INLINE *)
  | "displayAs" ":" <ws> ( "dialog" | "inline" ) (* required; data type: string; lov: STATIC *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as = DIALOG *)
<trigger_action_f_client_side_condition> ::= <indent> "clientSideCondition" <ws> "{" <line_end> { <trigger_action_f_client_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_f_client_side_condition_property_line> ::= <indent> <trigger_action_f_client_side_condition_property> <line_end>
<trigger_action_f_client_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInList) or type in (itemIsNotInList) *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* data type: string; lov: STATIC *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
<trigger_action_f_comments> ::= <indent> "comments" <ws> "{" <line_end> { <trigger_action_f_comments_property_line> } <indent> "}" <line_end>
<trigger_action_f_comments_property_line> ::= <indent> <trigger_action_f_comments_property> <line_end>
<trigger_action_f_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<trigger_action_f_config> ::= <indent> "config" <ws> "{" <line_end> { <trigger_action_f_config_property_line> } <indent> "}" <line_end>
<trigger_action_f_config_property_line> ::= <indent> <trigger_action_f_config_property> <line_end>
<trigger_action_f_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<trigger_action_f_execution> ::= <indent> "execution" <ws> "{" <line_end> { <trigger_action_f_execution_property_line> } <indent> "}" <line_end>
<trigger_action_f_execution_property_line> ::= <indent> <trigger_action_f_execution_property> <line_end>
<trigger_action_f_execution_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports STOP_EXECUTION_ON_ERROR *)
  | "waitForResult" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports WAIT_FOR_RESULT *)
<trigger_action_f_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <trigger_action_f_file_handling_property_line> } <indent> "}" <line_end>
<trigger_action_f_file_handling_property_line> ::= <indent> <trigger_action_f_file_handling_property> <line_end>
<trigger_action_f_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
  | "viewFileAs" ":" <ws> ( "inline" | "attachment" ) (* required; conditional; data type: string; lov: STATIC; applies when multiple_files = N *)
<trigger_action_f_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <trigger_action_f_gen_ai_property_line> } <indent> "}" <line_end>
<trigger_action_f_gen_ai_property_line> ::= <indent> <trigger_action_f_gen_ai_property> <line_end>
<trigger_action_f_gen_ai_property> ::= "agent" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: aiAgent; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "enabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports AI_ENABLED *)
  | "itemsToSubmit" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true *)
  | "service" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: genAIService; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "systemPrompt" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED and enabled = true *)
  | "welcomeMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_UI and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_UI and action supports AI_ENABLED and enabled = true *)
<trigger_action_f_initial_prompt> ::= <indent> "initialPrompt" <ws> "{" <line_end> { <trigger_action_f_initial_prompt_property_line> } <indent> "}" <line_end>
<trigger_action_f_initial_prompt_property_line> ::= <indent> <trigger_action_f_initial_prompt_property> <line_end>
<trigger_action_f_initial_prompt_property> ::= "displayedMessage" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "immediateActionPrompt" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = JAVASCRIPT_EXPRESSION *)
  | "type" ":" <ws> ( "item" | "jsExpression" ) (* data type: string; lov: STATIC *)
<trigger_action_f_input_value> ::= <indent> "inputValue" <ws> "{" <line_end> { <trigger_action_f_input_value_property_line> } <indent> "}" <line_end>
<trigger_action_f_input_value_property_line> ::= <indent> <trigger_action_f_input_value_property> <line_end>
<trigger_action_f_input_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = JAVASCRIPT *)
  | "type" ":" <ws> ( "jsCode" | "item" | "onlySystemPrompt" ) (* required; data type: string; lov: STATIC *)
<trigger_action_f_quick_actions> ::= <indent> "quickActions" <ws> "{" <line_end> { <trigger_action_f_quick_actions_property_line> } <indent> "}" <line_end>
<trigger_action_f_quick_actions_property_line> ::= <indent> <trigger_action_f_quick_actions_property> <line_end>
<trigger_action_f_quick_actions_property> ::= "message1" ":" <ws> <string_like_value> (* data type: string *)
  | "message2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when quick_action_message1 is set *)
<trigger_action_f_security> ::= <indent> "security" <ws> "{" <line_end> { <trigger_action_f_security_property_line> } <indent> "}" <line_end>
<trigger_action_f_security_property_line> ::= <indent> <trigger_action_f_security_property> <line_end>
<trigger_action_f_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<trigger_action_f_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <trigger_action_f_server_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_f_server_side_condition_property_line> ::= <indent> <trigger_action_f_server_side_condition_property> <line_end>
<trigger_action_f_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<trigger_action_f_settings> ::= <indent> "settings" <ws> "{" <line_end> { <trigger_action_f_settings_property_line> } <indent> "}" <line_end>
<trigger_action_f_settings_property_line> ::= <indent> <trigger_action_f_settings_property> <line_end>
<trigger_action_f_settings_property> ::= "action" ":" <ws> ( "subscription" | "aggregate" | "flashback" | "filters" | "columns" | "compute" | "pivot" | "controlBreak" | "download" | "groupBy" | "saveReport" | "sort" | "chart" | "highlight" ) (* required; data type: string; lov: STATIC *)
  | "cancelLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "class" ":" <ws> <string_like_value> (* required; data type: string *)
  | "clearErrors" ":" <ws> <boolean> (* required; data type: boolean *)
  | "confirmLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "cssClasses" ":" <ws> <string_like_value> (* data type: string *)
  | "enableHighAccuracy" ":" <ws> <boolean> (* required; data type: boolean *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (SQL_STATEMENT) or type in (PLSQL_EXPRESSION) or type in (FUNCTION_BODY) *)
  | "filePassword" ":" <ws> <string_like_value> (* data type: string *)
  | "fileSource" ":" <ws> ( "sqlQuery" | "fileUrls" ) (* required; conditional; data type: string; lov: STATIC; applies when share_type = files *)
  | "fileUrls" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = file_url *)
  | "filename" ":" <ws> <string_like_value> (* data type: string *)
  | "hidePageItemsOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = geojson *)
  | "itemsToReturn" ":" <ws> <string_like_value> (* data type: string *)
  | "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "jsCode" ":" <ws> <string_like_value> (* required; data type: string *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = JAVASCRIPT_EXPRESSION *)
  | "jsFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = javascript_code *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; data type: string; lov: STATIC *)
  | "latitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "longitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "maintainPagination" ":" <ws> <boolean> (* required; data type: boolean *)
  | "message" ":" <ws> <string_like_value> (* required; data type: string *)
  | "okLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = PLSQL *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY *)
  | "reportQuery" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: reportQuery; dynamic values omitted *)
  | "requestButtonName" ":" <ws> <string_like_value> (* data type: string *)
  | "returnItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = DIALOG_RETURN_ITEM *)
  | "returnType" ":" <ws> ( "jsFunction" | "latitudeAndLongitude" | "geojson" ) (* required; data type: string; lov: STATIC *)
  | "showAllOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "showProcessing" ":" <ws> <boolean> (* required; data type: boolean *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = sql_query *)
  | "style" ":" <ws> ( "information" | "danger" | "warning" | "success" ) (* data type: string; lov: STATIC *)
  | "styleName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when items_to_return is set *)
  | "text" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "url" | "currentPage" | "files" ) (* required; data type: string; lov: STATIC *)
  | "type" ":" <ws> ( "plsqlExpression" | "dialogReturnItem" | "static" | "plsqlFunctionBody" | "sqlQuery" | "jsExpression" ) (* required; data type: string; lov: STATIC *)
  | "url" ":" <ws> <value> (* required; conditional; data type: complex; applies when share_type = url *)
  | "value" ":" <ws> <string_like_value> (* data type: string *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; data type: string; lov: STATIC *)
<trigger_action_f_source> ::= <indent> "source" <ws> "{" <line_end> { <trigger_action_f_source_property_line> } <indent> "}" <line_end>
<trigger_action_f_source_property_line> ::= <indent> <trigger_action_f_source_property> <line_end>
<trigger_action_f_source_property> ::= "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = N *)
<trigger_action_f_use_response> ::= <indent> "useResponse" <ws> "{" <line_end> { <trigger_action_f_use_response_property_line> } <indent> "}" <line_end>
<trigger_action_f_use_response_property_line> ::= <indent> <trigger_action_f_use_response_property> <line_end>
<trigger_action_f_use_response_property> ::= "buttonLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = ITEM *)
  | "jsCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = JAVASCRIPT *)
  | "jsDetectionExpression" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_response_type = ITEM *)
  | "type" ":" <ws> ( "item" | "jsCode" ) (* data type: string; lov: STATIC *)

(* aggregate *)
(* direct properties use default group: aggregate *)
<aggregate_a> ::= "aggregate" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <aggregate_a_body_line> } <indent> ")" <line_end>
<aggregate_a_body_line> ::= <aggregate_a_direct_property_line>
<aggregate_a_direct_property_line> ::= <indent> <aggregate_a_direct_property> <line_end>
<aggregate_a_direct_property> ::= "column" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when function in (count) or function in (countDistinct) *)
  | "column" ":" <ws> <string_like_value> (* required; conditional; data type: string *)
  | "function" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "min" | "max" | "median" ) (* required; data type: string; lov: STATIC *)

(* aggregate *)
(* direct properties use default group: aggregate *)
<aggregate_b> ::= "aggregate" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <aggregate_b_body_line> } <indent> ")" <line_end>
<aggregate_b_body_line> ::= <aggregate_b_direct_property_line>
  | <aggregate_b_group_block>
