  | "operator" ":" <ws> ( "=" | "!=" | ">" | ">=" | "<" | "<=" | "between" | "isNull" | "isNotNull" | "like" | "notLike" | "in" | "notIn" | "contains" | "doesNotContain" | "regexp" | "isInTheLast" | "isNotInTheLast" | "isInTheNext" | "isNotInTheNext" ) (* required; data type: string; lov: STATIC *)
  | "to" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when operator = between *)
  | "unit" ":" <ws> ( "min" | "hours" | "days" | "weeks" | "months" | "years" ) (* required; conditional; data type: string; lov: STATIC; applies when operator in (isInTheLast) or operator in (isNotInTheLast) or operator in (isInTheNext) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string *)
  | "value" ":" <ws> <number> (* required; conditional; data type: number; applies when operator in (isInTheLast) or operator in (isNotInTheLast) or operator in (isInTheNext) or other dependency conditions are satisfied *)
