  | "restSource" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: restDataSource; applies when actionsInitiatedOn in (rowsReturned) and location = restSource or actionsInitiatedOn in (noRowsReturned) and location = restSource; dynamic values omitted *)
  | "sampleData" ":" <ws> ( "employees" | "tasks" | "products" | "projects" ) (* required; conditional; data type: string; lov: STATIC; applies when actionsInitiatedOn in (rowsReturned) and location = sampleData or actionsInitiatedOn in (noRowsReturned) and location = sampleData *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when actionsInitiatedOn in (rowsReturned) and location in (localDatabase) and type = sqlQuery or actionsInitiatedOn in (rowsReturned) and location in (restEnabledSql) and type = sqlQuery or actionsInitiatedOn in (noRowsReturned) and location in (localDatabase) and type = sqlQuery or other dependency conditions are satisfied *)
  | "tableName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when actionsInitiatedOn in (rowsReturned) and location in (localDatabase) and type = tableView or actionsInitiatedOn in (rowsReturned) and location in (restEnabledSql) and type = tableView or actionsInitiatedOn in (noRowsReturned) and location in (localDatabase) and type = tableView or other dependency conditions are satisfied *)
  | "tableOwner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when actionsInitiatedOn in (rowsReturned) and location in (localDatabase) and type = tableView or actionsInitiatedOn in (rowsReturned) and location in (restEnabledSql) and type = tableView or actionsInitiatedOn in (noRowsReturned) and location in (localDatabase) and type = tableView or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "tableView" | "sqlQuery" | "functionBody" | "propertyGraph" ) (* required; conditional; data type: string; lov: STATIC; applies when actionsInitiatedOn in (rowsReturned) and location in (localDatabase) or actionsInitiatedOn in (rowsReturned) and location in (restEnabledSql) or actionsInitiatedOn in (noRowsReturned) and location in (localDatabase) or other dependency conditions are satisfied *)
  | "whereClause" ":" <ws> <multiline_string> (* conditional; data type: string; applies when actionsInitiatedOn in (rowsReturned) and location in (localDatabase) and type = propertyGraph or actionsInitiatedOn in (rowsReturned) and location in (restEnabledSql) and type = propertyGraph or actionsInitiatedOn in (noRowsReturned) and location in (localDatabase) and type = propertyGraph or other dependency conditions are satisfied *)
  | "whereClause" ":" <ws> <multiline_string> (* conditional; data type: string; applies when actionsInitiatedOn in (rowsReturned) and location in (localDatabase) and type = tableView or actionsInitiatedOn in (rowsReturned) and location in (restEnabledSql) and type = tableView or actionsInitiatedOn in (noRowsReturned) and location in (localDatabase) and type = tableView or other dependency conditions are satisfied *)
<automation_child_component> ::= <action_a>
  | <parameter_f> (* applies when actionsInitiatedOn in (rowsReturned) and location = restSource and restSource is set and restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS and useLocalTable = false or actionsInitiatedOn in (rowsReturned) and location = restSource and restSource is set and actionsInitiatedOn in (noRowsReturned) and restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS and useLocalTable = false or actionsInitiatedOn in (rowsReturned) and location = restSource and restSource is set and restSource supports HAS_ARRAY_COLUMNS and restSource supports HAS_SYNC_ALL_ARRAY_COLUMNS and useLocalTable = false or other dependency conditions are satisfied *)

(* action *)
(* direct properties use default group: identification *)
<action_a> ::= "action" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <action_a_body_line> } <indent> ")" <line_end>
<action_a_body_line> ::= <action_a_direct_property_line>
  | <action_a_group_block>
<action_a_direct_property_line> ::= <indent> <action_a_direct_property> <line_end>
<action_a_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> <action_a_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
<action_a_group_block> ::= <action_a_action>
  | <action_a_address>
  | <action_a_advanced>
  | <action_a_background_execution>
  | <action_a_clear>
  | <action_a_comments>
  | <action_a_compare>
  | <action_a_condition>
  | <action_a_config>
  | <action_a_data_loading>
  | <action_a_email_attachments>
  | <action_a_email_content>
  | <action_a_email_dispatch_mode>
  | <action_a_email_header>
  | <action_a_email_template>
  | <action_a_end_state>
  | <action_a_error>
  | <action_a_execution>
  | <action_a_file_handling>
  | <action_a_geocoding_input>
  | <action_a_geocoding_result>
  | <action_a_human_task>
  | <action_a_input_value>
  | <action_a_invoke>
  | <action_a_lock_row>
  | <action_a_navigation>
  | <action_a_parsing_options>
  | <action_a_processing>
  | <action_a_processing_result>
  | <action_a_renew>
  | <action_a_reset_pagination>
  | <action_a_serialization>
  | <action_a_server_side_condition>
  | <action_a_settings>
  | <action_a_source>
  | <action_a_source_data>
  | <action_a_switch>
  | <action_a_target>
  | <action_a_timeout>
  | <action_a_use_response>
  | <action_a_workflow>
  | <action_a_workflow_instance>
<action_a_action> ::= <indent> "action" <ws> "{" <line_end> { <action_a_action_property_line> } <indent> "}" <line_end>
<action_a_action_property_line> ::= <indent> <action_a_action_property> <line_end>
<action_a_action_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (SET_PREFERENCE_TO_ITEM_VALUE) or type in (SET_PREFERENCE_TO_ITEM_VALUE_IF_ITEM_NOT_NULL) *)
  | "preferenceName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (SET_PREFERENCE_TO_ITEM_VALUE) or type in (SET_PREFERENCE_TO_ITEM_VALUE_IF_ITEM_NOT_NULL) *)
  | "type" ":" <ws> ( "setToItemValue" | "setToItemValueIfNotNull" | "resetPreferences" ) (* required; data type: string; lov: STATIC *)
<action_a_address> ::= <indent> "address" <ws> "{" <line_end> { <action_a_address_property_line> } <indent> "}" <line_end>
<action_a_address_property_line> ::= <indent> <action_a_address_property> <line_end>
<action_a_address_property> ::= "sanitizeAddress" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when structured_address = Y *)
  | "structuredAddress" ":" <ws> <boolean> (* required; data type: boolean *)
<action_a_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <action_a_advanced_property_line> } <indent> "}" <line_end>
<action_a_advanced_property_line> ::= <indent> <action_a_advanced_property> <line_end>
<action_a_advanced_property> ::= "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<action_a_background_execution> ::= <indent> "backgroundExecution" <ws> "{" <line_end> { <action_a_background_execution_property_line> } <indent> "}" <line_end>
<action_a_background_execution_property_line> ::= <indent> <action_a_background_execution_property> <line_end>
<action_a_background_execution_property> ::= "contextValueItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when run_in_background = Y *)
  | "executionsLimit" ":" <ws> <number> (* conditional; data type: number; applies when run_in_background = Y *)
  | "returnIdIntoItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when run_in_background = Y *)
  | "runInBackground" ":" <ws> <boolean> (* required; data type: boolean *)
  | "submitImmediately" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when run_in_background = Y *)
  | "tempFileHandling" ":" <ws> ( "ignore" | "copy" | "move" ) (* required; conditional; data type: string; lov: STATIC; applies when run_in_background = Y *)
  | "tempFileItems" ":" <ws> <string_like_value> (* conditional; data type: string; applies when run_in_background = Y and temporary_file_handling in (MOVE) or run_in_background = Y and temporary_file_handling in (COPY) *)
<action_a_clear> ::= <indent> "clear" <ws> "{" <line_end> { <action_a_clear_property_line> } <indent> "}" <line_end>
<action_a_clear_property_line> ::= <indent> <action_a_clear_property> <line_end>
<action_a_clear_property> ::= "applications" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CLEAR_CACHE_FOR_FLOWS *)
  | "items" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CLEAR_CACHE_FOR_ITEMS *)
  | "pages" ":" <ws> <number> (* required; conditional; data type: integer; applies when type = CLEAR_CACHE_FOR_PAGES *)
  | "type" ":" <ws> ( "apps" | "session" | "currentPage" | "currentApp" | "items" | "pages" ) (* required; data type: string; lov: STATIC *)
<action_a_comments> ::= <indent> "comments" <ws> "{" <line_end> { <action_a_comments_property_line> } <indent> "}" <line_end>
<action_a_comments_property_line> ::= <indent> <action_a_comments_property> <line_end>
<action_a_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<action_a_compare> ::= <indent> "compare" <ws> "{" <line_end> { <action_a_compare_property_line> } <indent> "}" <line_end>
<action_a_compare_property_line> ::= <indent> <action_a_compare_property> <line_end>
<action_a_compare_property> ::= "compareLanguage" ":" <ws> ( "plsql" | "js-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = CASE and compare_type in (EXPRESSION) or type = CASE and compare_type in (FUNCTION_BODY) *)
  | "comparePlsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = EXPRESSION *)
  | "comparePlsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = FUNCTION_BODY *)
  | "compareSqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CASE and compare_type = SQL_QUERY *)
  | "compareType" ":" <ws> ( "expression" | "sqlQuery" | "functionBody" ) (* required; conditional; data type: string; lov: STATIC; applies when type = CASE *)
  | "compareVar" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = CHECK_WF_VARIABLE *)
  | "dataType" ":" <ws> ( "timestampWithLocalTimeZone" | "number" | "varchar2" | "boolean" | "timestamp" | "timestampWithTimeZone" ) (* required; conditional; data type: string; lov: STATIC; applies when type = CASE *)
<action_a_condition> ::= <indent> "condition" <ws> "{" <line_end> { <action_a_condition_property_line> } <indent> "}" <line_end>
<action_a_condition_property_line> ::= <indent> <action_a_condition_property> <line_end>
<action_a_condition_property> ::= "conditionType" ":" <ws> ( "functionBody" | "workflowVarIsNotNull" | "workflowVarNotEqualsValue" | "workflowVarEqualsValue" | "expression" | "rowsNotReturned" | "rowsReturned" | "workflowVarIsNull" ) (* required; conditional; data type: string; lov: STATIC; applies when type = TRUE_FALSE_CHECK *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = TRUE_FALSE_CHECK and condition_type in (EXPRESSION) or type = TRUE_FALSE_CHECK and condition_type in (FUNCTION_BODY) *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type = EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type = FUNCTION_BODY *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type in (ROWS_RETURNED) or type = TRUE_FALSE_CHECK and condition_type in (ROWS_NOT_RETURNED) *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_EQ_VAL) or type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_NEQ_VAL) *)
  | "workflowVar" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_NULL) or type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_NOT_NULL) or type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_EQ_VAL) or other dependency conditions are satisfied *)
<action_a_config> ::= <indent> "config" <ws> "{" <line_end> { <action_a_config_property_line> } <indent> "}" <line_end>
<action_a_config_property_line> ::= <indent> <action_a_config_property> <line_end>
<action_a_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<action_a_data_loading> ::= <indent> "dataLoading" <ws> "{" <line_end> { <action_a_data_loading_property_line> } <indent> "}" <line_end>
<action_a_data_loading_property_line> ::= <indent> <action_a_data_loading_property> <line_end>
<action_a_data_loading_property> ::= "dataLoadDefinition" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: legacyDataLoadDefinition; dynamic values omitted *)
<action_a_email_attachments> ::= <indent> "emailAttachments" <ws> "{" <line_end> { <action_a_email_attachments_property_line> } <indent> "}" <line_end>
<action_a_email_attachments_property_line> ::= <indent> <action_a_email_attachments_property> <line_end>
<action_a_email_attachments_property> ::= "attachmentSql" ":" <ws> <string_like_value> (* data type: string *)
<action_a_email_content> ::= <indent> "emailContent" <ws> "{" <line_end> { <action_a_email_content_property_line> } <indent> "}" <line_end>
<action_a_email_content_property_line> ::= <indent> <action_a_email_content_property> <line_end>
<action_a_email_content_property> ::= "bodyHtml" ":" <ws> <string_like_value> (* conditional; data type: string *)
  | "bodyPlainText" ":" <ws> <string_like_value> (* required; conditional; data type: string *)
  | "replyTo" ":" <ws> <string_like_value> (* data type: string *)
  | "subject" ":" <ws> <string_like_value> (* required; conditional; data type: string *)
<action_a_email_dispatch_mode> ::= <indent> "emailDispatchMode" <ws> "{" <line_end> { <action_a_email_dispatch_mode_property_line> } <indent> "}" <line_end>
<action_a_email_dispatch_mode_property_line> ::= <indent> <action_a_email_dispatch_mode_property> <line_end>
<action_a_email_dispatch_mode_property> ::= "sendImmediately" ":" <ws> <boolean> (* required; data type: boolean *)
<action_a_email_header> ::= <indent> "emailHeader" <ws> "{" <line_end> { <action_a_email_header_property_line> } <indent> "}" <line_end>
<action_a_email_header_property_line> ::= <indent> <action_a_email_header_property> <line_end>
<action_a_email_header_property> ::= "bcc" ":" <ws> <string_like_value> (* data type: string *)
  | "cc" ":" <ws> <string_like_value> (* data type: string *)
  | "from" ":" <ws> <string_like_value> (* required; data type: string *)
  | "to" ":" <ws> <string_like_value> (* required; data type: string *)
<action_a_email_template> ::= <indent> "emailTemplate" <ws> "{" <line_end> { <action_a_email_template_property_line> } <indent> "}" <line_end>
<action_a_email_template_property_line> ::= <indent> <action_a_email_template_property> <line_end>
<action_a_email_template_property> ::= "emailTemplate" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: emailTemplate; dynamic values omitted *)
  | "escapeBodySubstitutions" ":" <ws> ( "true" | "false" ) (* conditional; data type: string; lov: STATIC; applies when body_html is set *)
  | "languageOverride" ":" <ws> <string_like_value> (* conditional; data type: string; applies when email_template_id is set *)
  | "placeholderValues" ":" <ws> <string_like_value> (* conditional; data type: string; applies when email_template_id is set *)
<action_a_end_state> ::= <indent> "endState" <ws> "{" <line_end> { <action_a_end_state_property_line> } <indent> "}" <line_end>
<action_a_end_state_property_line> ::= <indent> <action_a_end_state_property> <line_end>
<action_a_end_state_property> ::= "endState" ":" <ws> ( "terminated" | "completed" ) (* required; data type: string; lov: STATIC *)
<action_a_error> ::= <indent> "error" <ws> "{" <line_end> { <action_a_error_property_line> } <indent> "}" <line_end>
<action_a_error_property_line> ::= <indent> <action_a_error_property> <line_end>
<action_a_error_property> ::= "errorMessage" ":" <ws> <multiline_string> (* data type: string *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; data type: boolean *)
<action_a_execution> ::= <indent> "execution" <ws> "{" <line_end> { <action_a_execution_property_line> } <indent> "}" <line_end>
<action_a_execution_property_line> ::= <indent> <action_a_execution_property> <line_end>
<action_a_execution_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
<action_a_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <action_a_file_handling_property_line> } <indent> "}" <line_end>
<action_a_file_handling_property_line> ::= <indent> <action_a_file_handling_property> <line_end>
<action_a_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; conditional; data type: string; lov: STATIC; applies when multiple_files = N *)
<action_a_geocoding_input> ::= <indent> "geocodingInput" <ws> "{" <line_end> { <action_a_geocoding_input_property_line> } <indent> "}" <line_end>
<action_a_geocoding_input_property_line> ::= <indent> <action_a_geocoding_input_property> <line_end>
<action_a_geocoding_input_property> ::= "addressItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when structured_address = N *)
  | "cityItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "citySubAreaItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "country" ":" <ws> <string_like_value> (* required; conditional; data type: string; lov: STATIC; applies when structured_address = Y and country_type = STATIC; dynamic values omitted *)
  | "countryItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when structured_address = Y and country_type = ITEM *)
  | "countryType" ":" <ws> ( "item" | "static" ) (* required; conditional; data type: string; lov: STATIC; applies when structured_address = Y *)
  | "houseNoItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "postalCodeItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "regionItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when structured_address = Y *)
  | "streetItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when structured_address = Y *)
<action_a_geocoding_result> ::= <indent> "geocodingResult" <ws> "{" <line_end> { <action_a_geocoding_result_property_line> } <indent> "}" <line_end>
<action_a_geocoding_result_property_line> ::= <indent> <action_a_geocoding_result_property> <line_end>
<action_a_geocoding_result_property> ::= "collectionName" ":" <ws> <string_like_value> (* data type: string *)
  | "coordinateItem" ":" <ws> <string_like_value> (* data type: string *)
  | "matchVectorItem" ":" <ws> <string_like_value> (* data type: string *)
<action_a_human_task> ::= <indent> "humanTask" <ws> "{" <line_end> { <action_a_human_task_property_line> } <indent> "}" <line_end>
<action_a_human_task_property_line> ::= <indent> <action_a_human_task_property> <line_end>
<action_a_human_task_property> ::= "commentText" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (ADD_TASK_COMMENT) or type in (REQUEST_INFO) or type in (SUBMIT_INFO) *)
  | "dueDateItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = SET_DUE_DATE *)
  | "newValueItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = SET_TASK_PARAMS *)
  | "paramItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = SET_TASK_PARAMS *)
  | "priorityItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = SET_TASK_PRIORITY *)
  | "requestFromUserItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = REQUEST_INFO *)
  | "taskIdItem" ":" <ws> <string_like_value> (* required; data type: string *)
  | "toUserItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (DELEGATE_TASK) or type in (ADD_TASK_POTENTIAL_OWNER) or type in (REMOVE_POTENTIAL_OWNER) or other dependency conditions are satisfied *)
<action_a_input_value> ::= <indent> "inputValue" <ws> "{" <line_end> { <action_a_input_value_property_line> } <indent> "}" <line_end>
<action_a_input_value_property_line> ::= <indent> <action_a_input_value_property> <line_end>
<action_a_input_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = EXPRESSION and input_value_expression_language = JAVASCRIPT *)
  | "jsFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = FUNCTION_BODY and input_value_function_body_language = JAVASCRIPT *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when input_value_type = EXPRESSION *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when input_value_type = FUNCTION_BODY *)
  | "maxTokens" ":" <ws> <number> (* conditional; data type: integer; applies when input_value_type = SQL_QUERY *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = EXPRESSION and input_value_expression_language = PLSQL *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = FUNCTION_BODY and input_value_function_body_language = PLSQL *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = SQL_QUERY *)
  | "type" ":" <ws> ( "functionBody" | "expression" | "item" | "onlySystemPrompt" | "sqlQuery" ) (* required; data type: string; lov: STATIC *)
<action_a_invoke> ::= <indent> "invoke" <ws> "{" <line_end> { <action_a_invoke_property_line> } <indent> "}" <line_end>
<action_a_invoke_property_line> ::= <indent> <action_a_invoke_property> <line_end>
<action_a_invoke_property> ::= "operation" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: operation; applies when type = WEB_SOURCE; dynamic values omitted *)
  | "owner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (PLSQL_PACKAGE) or type in (PLSQL_PROCEDURE_FUNCTION) *)
  | "package" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_PACKAGE *)
  | "procedureOrFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_PACKAGE *)
  | "procedureOrFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_PROCEDURE_FUNCTION *)
  | "restSource" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: restDataSource; applies when type = WEB_SOURCE; dynamic values omitted *)
