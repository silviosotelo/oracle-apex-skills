<aggregate_b_direct_property> ::= "column" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: column; dynamic values omitted *)
  | "function" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "min" | "max" | "median" ) (* required; data type: string; lov: STATIC *)
  | "showGrandTotal" ":" <ws> <boolean> (* required; data type: boolean *)
  | "tooltip" ":" <ws> <string_like_value> (* data type: string *)
<aggregate_b_group_block> ::= <aggregate_b_advanced>
