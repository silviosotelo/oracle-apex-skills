<rest_data_source_source_property> ::= "remoteServer" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: restDataSourceServer; dynamic values omitted *)
  | "remoteServer" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: restEnabledSqlDatabase; applies when type = restEnabledSqlQuery; dynamic values omitted *)
  | "type" ":" <ws> <rest_data_source_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "urlPathPrefix" ":" <ws> <string_like_value> (* required; data type: string *)
