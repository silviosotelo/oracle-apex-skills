<parameter_j_parameter_property> ::= "dataType" ":" <ws> ( "varchar2" | "clob" | "number" | "plsqlInteger" | "boolean" | "date" | "timestamp" | "timestampWithLocalTimeZone" | "timestampWithTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "blob" | "char" | "rowid" | "custom" ) (* required; data type: string; lov: STATIC *)
  | "dataTypeName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when dataType = custom *)
  | "direction" ":" <ws> ( "in" | "out" | "inOut" ) (* required; conditional; data type: string; lov: STATIC; applies when type = parameter *)
  | "hasDefault" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = parameter and direction = in *)
  | "ignoreOutput" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = parameter and direction in (inOut) or type = parameter and direction in (out) *)
<parameter_j_value> ::= <indent> "value" <ws> "{" <line_end> { <parameter_j_value_property_line> } <indent> "}" <line_end>
<parameter_j_value_property_line> ::= <indent> <parameter_j_value_property> <line_end>
<parameter_j_value_property> ::= "falseValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when dataType = boolean and type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type in (item) or dataType = boolean and type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type in (preference) or dataType = boolean and type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type in (item) or other dependency conditions are satisfied *)
  | "formatMask" ":" <ws> <string_like_value> (* conditional; data type: string; applies when dataType in (number) and type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type in (staticValue) or dataType in (number) and type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type in (item) or dataType in (number) and type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type in (preference) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = item or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = item or type = parameter and direction in (inOut) and ignoreOutput = true and type = item or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = expression and language = javaScript-mle or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = expression and language = javaScript-mle or type = parameter and direction in (inOut) and ignoreOutput = true and type = expression and language = javaScript-mle or other dependency conditions are satisfied *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = functionBody and language = javaScript-mle or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = functionBody and language = javaScript-mle or type = parameter and direction in (inOut) and ignoreOutput = true and type = functionBody and language = javaScript-mle or other dependency conditions are satisfied *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = expression or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = expression or type = parameter and direction in (inOut) and ignoreOutput = true and type = expression or other dependency conditions are satisfied *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = functionBody or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = functionBody or type = parameter and direction in (inOut) and ignoreOutput = true and type = functionBody or other dependency conditions are satisfied *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = expression and dataType = custom or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = expression and dataType = custom or type = parameter and direction in (inOut) and ignoreOutput = true and type = expression and dataType = custom or other dependency conditions are satisfied *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = expression and language = plsql or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = expression and language = plsql or type = parameter and direction in (inOut) and ignoreOutput = true and type = expression and language = plsql or other dependency conditions are satisfied *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = functionBody and dataType = custom or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = functionBody and dataType = custom or type = parameter and direction in (inOut) and ignoreOutput = true and type = functionBody and dataType = custom or other dependency conditions are satisfied *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = functionBody and language = plsql or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = functionBody and language = plsql or type = parameter and direction in (inOut) and ignoreOutput = true and type = functionBody and language = plsql or other dependency conditions are satisfied *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = preference or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = preference or type = parameter and direction in (inOut) and ignoreOutput = true and type = preference or other dependency conditions are satisfied *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = expression and language = sql or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = expression and language = sql or type = parameter and direction in (inOut) and ignoreOutput = true and type = expression and language = sql or other dependency conditions are satisfied *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = sqlQuery or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = sqlQuery or type = parameter and direction in (inOut) and ignoreOutput = true and type = sqlQuery or other dependency conditions are satisfied *)
  | "staticValue" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = staticValue or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = staticValue or type = parameter and direction in (inOut) and ignoreOutput = true and type = staticValue or other dependency conditions are satisfied *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; conditional; data type: string; lov: STATIC; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type = staticValue and dataType = boolean or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type = staticValue and dataType = boolean or type = parameter and direction in (inOut) and ignoreOutput = true and type = staticValue and dataType = boolean or other dependency conditions are satisfied *)
  | "trueValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when dataType = boolean and type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type in (item) or dataType = boolean and type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true and type in (preference) or dataType = boolean and type = parameter and direction in (in) and direction in (out) and ignoreOutput = true and type in (item) or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "staticValue" | "item" | "sqlQuery" | "expression" | "functionBody" | "preference" | "apiDefault" | "null" ) (* required; conditional; data type: string; lov: STATIC; applies when type = parameter and direction in (in) and direction in (inOut) and ignoreOutput = true or type = parameter and direction in (in) and direction in (out) and ignoreOutput = true or type = parameter and direction in (inOut) and ignoreOutput = true or other dependency conditions are satisfied *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter_n> ::= "parameter" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <parameter_n_body_line> } <indent> ")" <line_end>
<parameter_n_body_line> ::= <parameter_n_direct_property_line>
  | <parameter_n_group_block>
<parameter_n_direct_property_line> ::= <indent> <parameter_n_direct_property> <line_end>
<parameter_n_direct_property> ::= "name" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: parameter; dynamic values omitted *)
<parameter_n_group_block> ::= <parameter_n_value>
<parameter_n_value> ::= <indent> "value" <ws> "{" <line_end> { <parameter_n_value_property_line> } <indent> "}" <line_end>
<parameter_n_value_property_line> ::= <indent> <parameter_n_value_property> <line_end>
<parameter_n_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = item *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = preference *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = sqlQuery *)
  | "staticValue" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = staticValue *)
  | "type" ":" <ws> ( "staticValue" | "item" | "sqlQuery" | "expression" | "functionBody" | "preference" | "null" ) (* required; data type: string; lov: STATIC *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter_p> ::= "parameter" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <parameter_p_body_line> } <indent> ")" <line_end>
<parameter_p_body_line> ::= <parameter_p_direct_property_line>
  | <parameter_p_group_block>
<parameter_p_direct_property_line> ::= <indent> <parameter_p_direct_property> <line_end>
<parameter_p_direct_property> ::= "name" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: parameter; dynamic values omitted *)
<parameter_p_group_block> ::= <parameter_p_value>
<parameter_p_value> ::= <indent> "value" <ws> "{" <line_end> { <parameter_p_value_property_line> } <indent> "}" <line_end>
<parameter_p_value_property_line> ::= <indent> <parameter_p_value_property> <line_end>
<parameter_p_value_property> ::= "falseValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when name supports IN_PARAMETER and type in (item) and name supports BOOLEAN_PARAMETER or name supports IN_PARAMETER and type in (preference) and name supports BOOLEAN_PARAMETER or name supports IN_OUT_PARAMETER and type in (item) and name supports BOOLEAN_PARAMETER or other dependency conditions are satisfied *)
  | "formatMask" ":" <ws> <string_like_value> (* conditional; data type: string; applies when name supports NUMBER_PARAMETER and name supports IN_PARAMETER and type in (staticValue) or name supports NUMBER_PARAMETER and name supports IN_PARAMETER and type in (item) or name supports NUMBER_PARAMETER and name supports IN_OUT_PARAMETER and type in (staticValue) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = item or name supports IN_OUT_PARAMETER and type = item *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = expression and language = javaScript-mle or name supports IN_OUT_PARAMETER and type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = functionBody and language = javaScript-mle or name supports IN_OUT_PARAMETER and type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when name supports IN_PARAMETER and type = expression or name supports IN_OUT_PARAMETER and type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when name supports IN_PARAMETER and type = functionBody or name supports IN_OUT_PARAMETER and type = functionBody *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = expression and language = plsql or name supports IN_OUT_PARAMETER and type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = functionBody and language = plsql or name supports IN_OUT_PARAMETER and type = functionBody and language = plsql *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = expression and language = sql or name supports IN_OUT_PARAMETER and type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = sqlQuery or name supports IN_OUT_PARAMETER and type = sqlQuery *)
  | "staticValue" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = staticValue and name does not support BOOLEAN_PARAMETER or name supports IN_OUT_PARAMETER and type = staticValue and name does not support BOOLEAN_PARAMETER *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; conditional; data type: string; lov: STATIC; applies when name supports IN_PARAMETER and type = staticValue and name supports BOOLEAN_PARAMETER or name supports IN_OUT_PARAMETER and type = staticValue and name supports BOOLEAN_PARAMETER *)
  | "trueValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when name supports IN_PARAMETER and type in (item) and name supports BOOLEAN_PARAMETER or name supports IN_PARAMETER and type in (preference) and name supports BOOLEAN_PARAMETER or name supports IN_OUT_PARAMETER and type in (item) and name supports BOOLEAN_PARAMETER or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "staticValue" | "item" | "sqlQuery" | "expression" | "functionBody" | "preference" | "default" | "null" ) (* required; conditional; data type: string; lov: STATIC; applies when name supports IN_PARAMETER or name supports IN_OUT_PARAMETER *)

(* region *)
(* direct properties use default group: identification *)
<region> ::= "region" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <region_body_line> } <indent> ")" <line_end>
<region_body_line> ::= <region_direct_property_line>
  | <region_group_block>
  | <region_child_component>
<region_direct_property_line> ::= <indent> <region_direct_property> <line_end>
<region_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> <region_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
<region_group_block> ::= <region_accessibility>
  | <region_actions_menu>
  | <region_advanced>
  | <region_animation>
  | <region_appearance>
  | <region_attributes>
  | <region_auto_refresh>
  | <region_blob_attributes>
  | <region_body>
  | <region_bounding_box>
  | <region_break_formatting>
  | <region_card>
  | <region_chart>
  | <region_chart_appearance>
  | <region_chart_layout>
  | <region_column_headings>
  | <region_columns>
  | <region_comments>
  | <region_component_advanced>
  | <region_component_appearance>
  | <region_config>
  | <region_controls>
  | <region_customization>
  | <region_data_cursor>
  | <region_data_profile>
  | <region_description>
  | <region_detail_view>
  | <region_download>
  | <region_edit>
  | <region_edit_authorization>
  | <region_enable_users_to>
  | <region_entity_title>
  | <region_external_filter_and_order_by>
  | <region_external_processing>
  | <region_gauge>
  | <region_gen_ai>
  | <region_header_and_footer>
  | <region_heading>
  | <region_help>
  | <region_icon_and_badge>
  | <region_icon_view>
  | <region_image>
  | <region_initial_position_and_zoom>
  | <region_layout>
  | <region_legend>
  | <region_link>
  | <region_local_post_processing>
  | <region_map>
  | <region_master_detail>
  | <region_media>
  | <region_messages>
  | <region_multi_series_chart_data>
  | <region_order_by>
  | <region_output>
  | <region_overview>
  | <region_page>
  | <region_page_footer>
  | <region_page_header>
  | <region_pagination>
  | <region_performance>
  | <region_printing>
  | <region_read_only>
  | <region_remote_cache>
  | <region_report_layout>
  | <region_rest_synchronization>
  | <region_row_selection>
  | <region_search_bar>
  | <region_secondary_body>
  | <region_security>
  | <region_server_cache>
  | <region_server_side_condition>
  | <region_settings>
  | <region_single_row_view>
  | <region_source>
  | <region_subtitle>
  | <region_title>
  | <region_toolbar>
  | <region_tooltip>
  | <region_value>
<region_accessibility> ::= <indent> "accessibility" <ws> "{" <line_end> { <region_accessibility_property_line> } <indent> "}" <line_end>
<region_accessibility_property_line> ::= <indent> <region_accessibility_property> <line_end>
<region_accessibility_property> ::= "landmarkLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports REGION_TEMPLATE and template supports REGION_LANDMARK_ATTRIBUTES and useLandmark = true *)
  | "landmarkType" ":" <ws> ( "banner" | "complementary" | "contentInfo" | "form" | "main" | "navigation" | "region" | "search" ) (* conditional; data type: string; lov: STATIC; applies when type supports REGION_TEMPLATE and template supports REGION_LANDMARK_ATTRIBUTES and useLandmark = true *)
  | "useLandmark" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports REGION_TEMPLATE and template supports REGION_LANDMARK_ATTRIBUTES *)
<region_actions_menu> ::= <indent> "actionsMenu" <ws> "{" <line_end> { <region_actions_menu_property_line> } <indent> "}" <line_end>
<region_actions_menu_property_line> ::= <indent> <region_actions_menu_property> <line_end>
<region_actions_menu_property> ::= "aggregate" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "chart" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "compute" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "controlBreak" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "download" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "filter" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "flashback" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "groupBy" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "help" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "highlight" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "includeActionsMenu" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true *)
  | "pivot" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "reset" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "rowsPerPage" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "savePublicReport" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true and saveReport = true *)
  | "savePublicReportAuthorization" ":" <ws> ( "mustNotBePublicUser" ) (* conditional; data type: string; lov: COMPONENT; references: authorization; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true and saveReport = true and savePublicReport = true; dynamic values omitted *)
  | "saveReport" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "selectColumns" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "sort" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true *)
  | "subscription" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = interactiveReport and includeSearchBar = true and includeActionsMenu = true and download = true *)
<region_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <region_advanced_property_line> } <indent> "}" <line_end>
<region_advanced_property_line> ::= <indent> <region_advanced_property> <line_end>
<region_advanced_property> ::= "customAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports REGION_TEMPLATE *)
  | "excludeTitleFromTranslation" ":" <ws> <boolean> (* required; data type: boolean *)
  | "htmlDomId" ":" <ws> <string_like_value> (* data type: string *)
  | "imageTagAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports REGION_TEMPLATE and template supports NOT_REGION_IMAGE_URL and regionImage is set *)
  | "regionDisplaySelector" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type supports REGION_TEMPLATE and template is set *)
  | "regionImage" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports REGION_TEMPLATE and template supports NOT_REGION_IMAGE_URL *)
  | "savedReportMappingIdentifier" ":" <ws> <string_like_value> (* data type: string; applies when type = interactiveGrid *)
  | "schemaOverrideItem" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (classicReport) or type in (interactiveReport) *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<region_animation> ::= <indent> "animation" <ws> "{" <line_end> { <region_animation_property_line> } <indent> "}" <line_end>
<region_animation_property_line> ::= <indent> <region_animation_property> <line_end>
<region_animation_property> ::= "onDataChange" ":" <ws> ( "auto" | "slideToLeft" | "slideToRight" | "none" ) (* required; data type: string; lov: STATIC; applies when type = chart *)
  | "onDisplay" ":" <ws> ( "auto" | "alphaFade" | "zoom" | "none" ) (* required; data type: string; lov: STATIC; applies when type = chart *)
<region_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <region_appearance_property_line> } <indent> "}" <line_end>
<region_appearance_property_line> ::= <indent> <region_appearance_property> <line_end>
<region_appearance_property> ::= "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type supports REGION_TEMPLATE and template is set *)
