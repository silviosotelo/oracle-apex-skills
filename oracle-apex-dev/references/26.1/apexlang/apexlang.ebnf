  | "customColumn" ":" <ws> <string_like_value> (* conditional; data type: string *)
  | "customTooltip" ":" <ws> <string_like_value> (* data type: string *)
  | "high" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = stock or type = combination and type in (barRange) or type = combination and type in (areaRange) or other dependency conditions are satisfied *)
