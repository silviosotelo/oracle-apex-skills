<action_position_help_property_line> ::= <indent> <action_position_help_property> <line_end>
<action_position_help_property> ::= "helpText" ":" <ws> <multiline_string> (* data type: string *)
<action_position_position> ::= <indent> "position" <ws> "{" <line_end> { <action_position_position_property_line> } <indent> "}" <line_end>
<action_position_position_property_line> ::= <indent> <action_position_position_property> <line_end>
<action_position_position_property> ::= "predefinedTemplate" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: actionTemplate; applies when type = template; dynamic values omitted *)
  | "type" ":" <ws> ( "link" | "template" ) (* required; data type: string; lov: STATIC *)

