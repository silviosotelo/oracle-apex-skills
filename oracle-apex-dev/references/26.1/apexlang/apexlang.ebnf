<dynamic_action_client_side_condition_property> ::= "column" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when selectionType = columns and interactiveGrid is set and type in (itemColumn=value) and componentType = column or selectionType = columns and interactiveGrid is set and type in (itemColumn!=value) and componentType = column or selectionType = columns and interactiveGrid is set and type in (itemColumn>value) and componentType = column or other dependency conditions are satisfied *)
  | "componentType" ":" <ws> ( "item" | "column" ) (* required; conditional; data type: string; lov: STATIC; applies when selectionType = columns and interactiveGrid is set and type in (itemColumn=value) or selectionType = columns and interactiveGrid is set and type in (itemColumn!=value) or selectionType = columns and interactiveGrid is set and type in (itemColumn>value) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when selectionType = columns and interactiveGrid is set and type in (itemColumn=value) and componentType = item or selectionType = columns and interactiveGrid is set and type in (itemColumn!=value) and componentType = item or selectionType = columns and interactiveGrid is set and type in (itemColumn>value) and componentType = item or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when selectionType = columns and selectionType = region and region does not support IG_REGION and type in (item=value) or selectionType = columns and selectionType = region and region does not support IG_REGION and type in (item!=value) or selectionType = columns and selectionType = region and region does not support IG_REGION and type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when selectionType = columns and selectionType = region and region does not support IG_REGION and type = jsExpression *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when selectionType = columns and interactiveGrid is set and type = jsExpression or selectionType = region and region supports IG_REGION and type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when selectionType = columns and selectionType = region and region does not support IG_REGION and type in (itemIsInList) or selectionType = columns and selectionType = region and region does not support IG_REGION and type in (itemIsNotInList) *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when selectionType = columns and interactiveGrid is set and type in (itemColumnIsInList) or selectionType = columns and interactiveGrid is set and type in (itemColumnIsNotInList) or selectionType = region and region supports IG_REGION and type in (itemColumnIsInList) or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* conditional; data type: string; lov: STATIC; applies when selectionType = columns and selectionType = region and region does not support IG_REGION *)
  | "type" ":" <ws> ( "itemColumn=value" | "itemColumn!=value" | "itemColumn>value" | "itemColumn>=value" | "itemColumn<value" | "itemColumn<=value" | "itemColumnIsNull" | "itemColumnIsNotNull" | "itemColumnIsInList" | "itemColumnIsNotInList" | "jsExpression" ) (* conditional; data type: string; lov: STATIC; applies when selectionType = columns and interactiveGrid is set or selectionType = region and region supports IG_REGION *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when selectionType = columns and selectionType = region and region does not support IG_REGION and type in (item=value) or selectionType = columns and selectionType = region and region does not support IG_REGION and type in (item!=value) or selectionType = columns and selectionType = region and region does not support IG_REGION and type in (item>value) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when selectionType = columns and interactiveGrid is set and type in (itemColumn=value) or selectionType = columns and interactiveGrid is set and type in (itemColumn!=value) or selectionType = columns and interactiveGrid is set and type in (itemColumn>value) or other dependency conditions are satisfied *)
