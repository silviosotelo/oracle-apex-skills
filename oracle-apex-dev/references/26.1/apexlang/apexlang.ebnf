(* customAttribute *)
(* direct properties use default group: identification *)
<custom_attribute> ::= "customAttribute" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <custom_attribute_body_line> } <indent> ")" <line_end>
<custom_attribute_body_line> ::= <custom_attribute_direct_property_line>
  | <custom_attribute_group_block>
  | <custom_attribute_child_component>
<custom_attribute_direct_property_line> ::= <indent> <custom_attribute_direct_property> <line_end>
<custom_attribute_direct_property> ::= "apexlangName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "attribute" ":" <ws> <number> (* required; data type: integer *)
  | "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "scope" ":" <ws> ( "app" | "component" | "report" | "reportGroup" | "regionColumn" ) (* required; data type: string; lov: STATIC *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> <string_like_value> (* required; data type: string; lov: STATIC; dynamic values omitted *)
<custom_attribute_group_block> ::= <custom_attribute_accessibility>
  | <custom_attribute_advanced>
  | <custom_attribute_appearance>
  | <custom_attribute_builder>
  | <custom_attribute_comments>
  | <custom_attribute_component_lov>
  | <custom_attribute_default>
  | <custom_attribute_depending_on>
  | <custom_attribute_examples>
  | <custom_attribute_help>
  | <custom_attribute_security>
  | <custom_attribute_supports>
  | <custom_attribute_template_support>
  | <custom_attribute_validation>
