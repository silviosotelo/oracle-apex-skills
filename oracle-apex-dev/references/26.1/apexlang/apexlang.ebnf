  | "rowSelector" ":" <ws> <string_like_value> (* conditional; data type: string; applies when format in (json) or format in (xml) *)
  | "singleRowSelector" ":" <ws> <string_like_value> (* conditional; data type: string; applies when format in (json) and containsSingleRow = false or format in (xml) and containsSingleRow = false *)
  | "useRawSelectors" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when format = json *)
<rest_data_source_invocation_scope> ::= <indent> "invocationScope" <ws> "{" <line_end> { <rest_data_source_invocation_scope_property_line> } <indent> "}" <line_end>
<rest_data_source_invocation_scope_property_line> ::= <indent> <rest_data_source_invocation_scope_property> <line_end>
<rest_data_source_invocation_scope_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when credentials is set and type = staticValue *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when credentials is set and type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when credentials is set and type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when credentials is set and type = functionBody *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when credentials is set and type = expression *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when credentials is set and type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when credentials is set and type = functionBody and language = plsql *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when credentials is set and type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when credentials is set and type = sqlQuery *)
  | "text" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when credentials is set and type = staticValue *)
  | "type" ":" <ws> ( "staticValue" | "item" | "sqlQuery" | "expression" | "functionBody" ) (* conditional; data type: string; lov: STATIC; applies when credentials is set *)
