  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type = FUNCTION_BODY *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type in (ROWS_RETURNED) or type = TRUE_FALSE_CHECK and condition_type in (ROWS_NOT_RETURNED) *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_EQ_VAL) or type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_NEQ_VAL) *)
  | "workflowVar" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_NULL) or type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_NOT_NULL) or type = TRUE_FALSE_CHECK and condition_type in (WF_VARIABLE_EQ_VAL) or other dependency conditions are satisfied *)
