<authentication_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> <authentication_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
<authentication_group_block> ::= <authentication_advanced>
  | <authentication_comments>
  | <authentication_help>
  | <authentication_login_processing>
  | <authentication_post_logout>
  | <authentication_real_app_security>
  | <authentication_session_not_valid>
