<plugin_java_script_property> ::= "fileUrls" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type in (region) or type in (dynamicAction) or type in (item) or other dependency conditions are satisfied *)
<plugin_on_demand> ::= <indent> "onDemand" <ws> "{" <line_end> { <plugin_on_demand_property_line> } <indent> "}" <line_end>
<plugin_on_demand_property_line> ::= <indent> <plugin_on_demand_property> <line_end>
<plugin_on_demand_property> ::= "description" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = genAITool and supportedExecutionPoints = onDemand *)
  | "parameters" ":" <ws> ( "noParameters" | "definedByAiTool" | "definedByPlugIn" ) (* required; conditional; data type: string; lov: STATIC; applies when type = genAITool and supportedExecutionPoints = onDemand *)
  | "parametersJsonSchema" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = genAITool and supportedExecutionPoints = onDemand and parameters = definedByPlugIn *)
<plugin_source> ::= <indent> "source" <ws> "{" <line_end> { <plugin_source_property_line> } <indent> "}" <line_end>
<plugin_source_property_line> ::= <indent> <plugin_source_property> <line_end>
<plugin_source_property> ::= "plsqlCode" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type in (region) or type in (dynamicAction) or type in (process) or other dependency conditions are satisfied *)
  | "sampleData" ":" <ws> ( "employees" | "tasks" | "products" | "projects" ) (* conditional; data type: string; lov: STATIC; applies when type in (region) or type in (templateComponent) *)
<plugin_subscription> ::= <indent> "subscription" <ws> "{" <line_end> { <plugin_subscription_property_line> } <indent> "}" <line_end>
<plugin_subscription_property_line> ::= <indent> <plugin_subscription_property> <line_end>
<plugin_subscription_property> ::= "master" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: plugin; dynamic values omitted *)
  | "subscribeComponentSettings" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when master is set *)
<plugin_template_component> ::= <indent> "templateComponent" <ws> "{" <line_end> { <plugin_template_component_property_line> } <indent> "}" <line_end>
<plugin_template_component_property_line> ::= <indent> <plugin_template_component_property> <line_end>
<plugin_template_component_property> ::= "availableAs" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; lov: STATIC; applies when type = templateComponent *)
  | "defaultEscapeMode" ":" <ws> ( "html" | "htmlAttribute" | "stripHtml" | "raw" ) (* required; conditional; data type: string; lov: STATIC; applies when type = templateComponent *)
  | "numberOfLazyLoadingSkeletons" ":" <ws> <number> (* conditional; data type: integer; applies when type = templateComponent and availableAs = report *)
  | "partial" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = templateComponent *)
  | "reportBody" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = templateComponent and availableAs = report *)
  | "reportContainer" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = templateComponent and availableAs = report *)
  | "reportGroup" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = templateComponent and availableAs = report *)
  | "reportRow" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = templateComponent and availableAs = report *)
  | "translateTemplates" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = templateComponent *)
<plugin_child_component> ::= <action_position> (* applies when type = templateComponent *)
  | <action_template> (* applies when type = templateComponent *)
  | <attribute_group> (* applies when type in (item) or type in (region) or type in (process) or other dependency conditions are satisfied *)
  | <custom_attribute>
  | <event> (* applies when type in (item) or type in (region) or type in (dynamicAction) *)
  | <file_b> (* applies when type in (region) or type in (dynamicAction) or type in (item) or other dependency conditions are satisfied *)
  | <slot_c> (* applies when type = templateComponent *)
  | <standard_attribute_config> (* applies when type in (item) or type in (region) or type in (process) or other dependency conditions are satisfied *)

(* actionPosition *)
(* direct properties use default group: identification *)
<action_position> ::= "actionPosition" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <action_position_body_line> } <indent> ")" <line_end>
