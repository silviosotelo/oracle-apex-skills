  | "pattern" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = chart and type in (statusMeterGauge) and format in (decimal) or type = chart and type in (statusMeterGauge) and format in (currency) or type = chart and type in (statusMeterGauge) and format in (percent) or other dependency conditions are satisfied *)
  | "pieChartOtherThreshold" ":" <ws> <number> (* required; conditional; data type: number; applies when type = chart and type in (pie) or type = chart and type in (donut) *)
  | "position" ":" <ws> ( "auto" | "center" | "insideIndicatorEdge" | "outsideIndicatorEdge" | "outsidePlotArea" | "withLabel" ) (* required; conditional; data type: string; lov: STATIC; applies when type = chart and type = statusMeterGauge *)
  | "show" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = chart and type = statusMeterGauge *)
  | "valueType" ":" <ws> ( "number" | "percent" ) (* required; conditional; data type: string; lov: STATIC; applies when type = chart and type = statusMeterGauge *)
<region_child_component> ::= <action_e>
  | <column_c> (* applies when type = classicReport *)
  | <column_d> (* applies when type = tabform *)
  | <column_e> (* applies when type supports COLUMNS *)
  | <column_f> (* applies when type supports SOURCE_LOCATION and location is set *)
