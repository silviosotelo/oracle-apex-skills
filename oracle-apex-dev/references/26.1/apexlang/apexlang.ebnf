  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = functionBody and language = plsql or name supports IN_OUT_PARAMETER and type = functionBody and language = plsql or name supports IN_OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = interactiveGrid and enabled = true and ignoreOutput = false and type = functionBody and language = plsql or other dependency conditions are satisfied *)
