<parameter_l_value_property> ::= "column" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: column; applies when name supports IN_PARAMETER and type = parentColumn or name supports IN_OUT_PARAMETER and type = parentColumn or name supports IN_OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = interactiveGrid and enabled = true and ignoreOutput = false and type = parentColumn or other dependency conditions are satisfied; dynamic values omitted *)
