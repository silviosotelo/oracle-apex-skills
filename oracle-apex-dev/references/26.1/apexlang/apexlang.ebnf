<action_e_security> ::= <indent> "security" <ws> "{" <line_end> { <action_e_security_property_line> } <indent> "}" <line_end>
<action_e_security_property_line> ::= <indent> <action_e_security_property> <line_end>
<action_e_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<action_e_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <action_e_server_side_condition_property_line> } <indent> "}" <line_end>
<action_e_server_side_condition_property_line> ::= <indent> <action_e_server_side_condition_property> <line_end>
<action_e_server_side_condition_property> ::= "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; conditional; data type: string; lov: STATIC; applies when type is set *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<action_e_child_component> ::= <menu_a> (* applies when position supports MENU or position supports TEMPLATE and template supports MENU *)
  | <trigger_action_b> (* applies when position supports TEMPLATE and template supports LINK_URL and type = triggerAction or position supports LINK and type = triggerAction or position supports TMPL_LINK_URL and type = triggerAction *)

(* menu *)
(* direct properties use default group: identification *)
<menu_a> ::= "menu" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <menu_a_body_line> } <indent> ")" <line_end>
<menu_a_body_line> ::= <menu_a_direct_property_line>
  | <menu_a_group_block>
  | <menu_a_child_component>
<menu_a_direct_property_line> ::= <indent> <menu_a_direct_property> <line_end>
<menu_a_direct_property> ::= "label" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) or type in (subMenu) *)
  | "parentMenu" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: menu; dynamic values omitted *)
  | "type" ":" <ws> ( "menuEntry" | "subMenu" | "separator" ) (* required; data type: string; lov: STATIC *)
<menu_a_group_block> ::= <menu_a_advanced>
  | <menu_a_appearance>
  | <menu_a_behavior>
  | <menu_a_comments>
  | <menu_a_config>
  | <menu_a_layout>
  | <menu_a_security>
  | <menu_a_server_side_condition>
<menu_a_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <menu_a_advanced_property_line> } <indent> "}" <line_end>
<menu_a_advanced_property_line> ::= <indent> <menu_a_advanced_property> <line_end>
<menu_a_advanced_property> ::= "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<menu_a_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <menu_a_appearance_property_line> } <indent> "}" <line_end>
<menu_a_appearance_property_line> ::= <indent> <menu_a_appearance_property> <line_end>
<menu_a_appearance_property> ::= "icon" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (menuEntry) or type in (subMenu) *)
<menu_a_behavior> ::= <indent> "behavior" <ws> "{" <line_end> { <menu_a_behavior_property_line> } <indent> "}" <line_end>
<menu_a_behavior_property_line> ::= <indent> <menu_a_behavior_property> <line_end>
<menu_a_behavior_property> ::= "linkAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = menuEntry and type in (redirectThisApp) or type = menuEntry and type in (redirectOtherApp) or type = menuEntry and type in (redirectUrl) *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = menuEntry and type = redirectThisApp *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = menuEntry and type = redirectOtherApp *)
  | "targetUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = menuEntry and type = redirectUrl *)
  | "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "triggerAction" ) (* required; conditional; data type: string; lov: STATIC; applies when type = menuEntry *)
<menu_a_comments> ::= <indent> "comments" <ws> "{" <line_end> { <menu_a_comments_property_line> } <indent> "}" <line_end>
<menu_a_comments_property_line> ::= <indent> <menu_a_comments_property> <line_end>
<menu_a_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<menu_a_config> ::= <indent> "config" <ws> "{" <line_end> { <menu_a_config_property_line> } <indent> "}" <line_end>
<menu_a_config_property_line> ::= <indent> <menu_a_config_property> <line_end>
<menu_a_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<menu_a_layout> ::= <indent> "layout" <ws> "{" <line_end> { <menu_a_layout_property_line> } <indent> "}" <line_end>
<menu_a_layout_property_line> ::= <indent> <menu_a_layout_property> <line_end>
<menu_a_layout_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
<menu_a_security> ::= <indent> "security" <ws> "{" <line_end> { <menu_a_security_property_line> } <indent> "}" <line_end>
<menu_a_security_property_line> ::= <indent> <menu_a_security_property> <line_end>
<menu_a_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* conditional; data type: string; lov: COMPONENT; references: authorization; applies when type in (menuEntry) or type in (subMenu); dynamic values omitted *)
<menu_a_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <menu_a_server_side_condition_property_line> } <indent> "}" <line_end>
<menu_a_server_side_condition_property_line> ::= <indent> <menu_a_server_side_condition_property> <line_end>
<menu_a_server_side_condition_property> ::= "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (menuEntry) and type is set or type in (menuEntry) and type is set and type in (subMenu) or type in (subMenu) and type is set and type in (menuEntry) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (item=value) or type in (menuEntry) and type in (item!=value) or type in (menuEntry) and type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type = textIsContainedInItem or type in (subMenu) and type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = javaScript-mle or type in (subMenu) and type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = functionBody and language = javaScript-mle or type in (subMenu) and type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (menuEntry) and type = expression or type in (subMenu) and type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (menuEntry) and type = functionBody or type in (subMenu) and type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (itemIsInColonDelimitedList) or type in (menuEntry) and type in (itemIsNotInColonDelimitedList) or type in (subMenu) and type in (itemIsInColonDelimitedList) or other dependency conditions are satisfied *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (menuEntry) and type in (currentPage=page) or type in (menuEntry) and type in (currentPage!=page) or type in (subMenu) and type in (currentPage=page) or other dependency conditions are satisfied *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (menuEntry) and type in (currentPageInList) or type in (menuEntry) and type in (currentPageNotInList) or type in (subMenu) and type in (currentPageInList) or other dependency conditions are satisfied *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = plsql or type in (subMenu) and type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = functionBody and language = plsql or type in (subMenu) and type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (userPreference=value) or type in (menuEntry) and type in (userPreference!=value) or type in (subMenu) and type in (userPreference=value) or other dependency conditions are satisfied *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type = expression and language = sql or type in (subMenu) and type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (rowsReturned) or type in (menuEntry) and type in (noRowsReturned) or type in (subMenu) and type in (rowsReturned) or other dependency conditions are satisfied *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (textIsContainedInItem) or type in (menuEntry) and type in (textIsContainedInValue) or type in (menuEntry) and type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* conditional; data type: string; lov: STATIC; applies when type in (menuEntry) or type in (subMenu); dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (request=Value) or type in (menuEntry) and type in (request!=Value) or type in (menuEntry) and type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (item=value) or type in (menuEntry) and type in (item!=value) or type in (menuEntry) and type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (menuEntry) and type in (textIsContainedInValue) or type in (menuEntry) and type in (textIsNotContainedInValue) or type in (menuEntry) and type in (text=value) or other dependency conditions are satisfied *)
<menu_a_child_component> ::= <trigger_action_a> (* applies when type = menuEntry and type = triggerAction *)

(* triggerAction *)
(* direct properties use default group: identification *)
<trigger_action_a> ::= "triggerAction" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <trigger_action_a_body_line> } <indent> ")" <line_end>
<trigger_action_a_body_line> ::= <trigger_action_a_direct_property_line>
  | <trigger_action_a_group_block>
<trigger_action_a_direct_property_line> ::= <indent> <trigger_action_a_direct_property> <line_end>
<trigger_action_a_direct_property> ::= "action" ":" <ws> <trigger_action_a_action_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<trigger_action_a_group_block> ::= <trigger_action_a_advanced>
  | <trigger_action_a_affected_elements>
  | <trigger_action_a_appearance>
  | <trigger_action_a_client_side_condition>
  | <trigger_action_a_comments>
  | <trigger_action_a_config>
  | <trigger_action_a_execution>
  | <trigger_action_a_file_handling>
  | <trigger_action_a_gen_ai>
  | <trigger_action_a_initial_prompt>
  | <trigger_action_a_input_value>
  | <trigger_action_a_quick_actions>
  | <trigger_action_a_security>
  | <trigger_action_a_server_side_condition>
  | <trigger_action_a_settings>
  | <trigger_action_a_source>
  | <trigger_action_a_use_response>
<trigger_action_a_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <trigger_action_a_advanced_property_line> } <indent> "}" <line_end>
<trigger_action_a_advanced_property_line> ::= <indent> <trigger_action_a_advanced_property> <line_end>
<trigger_action_a_advanced_property> ::= "initJavaScriptFunction" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports INIT_JAVASCRIPT_CODE *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<trigger_action_a_affected_elements> ::= <indent> "affectedElements" <ws> "{" <line_end> { <trigger_action_a_affected_elements_property_line> } <indent> "}" <line_end>
<trigger_action_a_affected_elements_property_line> ::= <indent> <trigger_action_a_affected_elements_property> <line_end>
<trigger_action_a_affected_elements_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when action supports ITEM and selectionType = button or action supports BUTTON and selectionType = button or action supports REGION and selectionType = button or other dependency conditions are satisfied; dynamic values omitted *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = items or action supports BUTTON and selectionType = items or action supports REGION and selectionType = items or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = javaScriptExpression or action supports BUTTON and selectionType = javaScriptExpression or action supports REGION and selectionType = javaScriptExpression or other dependency conditions are satisfied *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = jquerySelector or action supports BUTTON and selectionType = jquerySelector or action supports REGION and selectionType = jquerySelector or other dependency conditions are satisfied *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when action supports ITEM and selectionType = region or action supports BUTTON and selectionType = region or action supports REGION and selectionType = region or other dependency conditions are satisfied; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jquerySelector" | "javaScriptExpression" | "triggeringElement" | "eventSource" ) (* conditional; data type: string; lov: STATIC; applies when action supports ITEM or action supports BUTTON or action supports REGION or other dependency conditions are satisfied *)
<trigger_action_a_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <trigger_action_a_appearance_property_line> } <indent> "}" <line_end>
<trigger_action_a_appearance_property_line> ::= <indent> <trigger_action_a_appearance_property> <line_end>
<trigger_action_a_appearance_property> ::= "containerSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when display_as = INLINE *)
  | "displayAs" ":" <ws> ( "dialog" | "inline" ) (* required; data type: string; lov: STATIC *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as = DIALOG *)
<trigger_action_a_client_side_condition> ::= <indent> "clientSideCondition" <ws> "{" <line_end> { <trigger_action_a_client_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_a_client_side_condition_property_line> ::= <indent> <trigger_action_a_client_side_condition_property> <line_end>
<trigger_action_a_client_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInList) or type in (itemIsNotInList) *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* data type: string; lov: STATIC *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
<trigger_action_a_comments> ::= <indent> "comments" <ws> "{" <line_end> { <trigger_action_a_comments_property_line> } <indent> "}" <line_end>
<trigger_action_a_comments_property_line> ::= <indent> <trigger_action_a_comments_property> <line_end>
<trigger_action_a_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<trigger_action_a_config> ::= <indent> "config" <ws> "{" <line_end> { <trigger_action_a_config_property_line> } <indent> "}" <line_end>
<trigger_action_a_config_property_line> ::= <indent> <trigger_action_a_config_property> <line_end>
<trigger_action_a_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<trigger_action_a_execution> ::= <indent> "execution" <ws> "{" <line_end> { <trigger_action_a_execution_property_line> } <indent> "}" <line_end>
<trigger_action_a_execution_property_line> ::= <indent> <trigger_action_a_execution_property> <line_end>
<trigger_action_a_execution_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports STOP_EXECUTION_ON_ERROR *)
  | "waitForResult" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports WAIT_FOR_RESULT *)
<trigger_action_a_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <trigger_action_a_file_handling_property_line> } <indent> "}" <line_end>
<trigger_action_a_file_handling_property_line> ::= <indent> <trigger_action_a_file_handling_property> <line_end>
<trigger_action_a_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
  | "viewFileAs" ":" <ws> ( "inline" | "attachment" ) (* required; conditional; data type: string; lov: STATIC; applies when multiple_files = N *)
<trigger_action_a_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <trigger_action_a_gen_ai_property_line> } <indent> "}" <line_end>
<trigger_action_a_gen_ai_property_line> ::= <indent> <trigger_action_a_gen_ai_property> <line_end>
<trigger_action_a_gen_ai_property> ::= "agent" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: aiAgent; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "enabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports AI_ENABLED *)
  | "itemsToSubmit" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true *)
  | "service" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: genAIService; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "systemPrompt" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED and enabled = true *)
  | "welcomeMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_UI and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_UI and action supports AI_ENABLED and enabled = true *)
<trigger_action_a_initial_prompt> ::= <indent> "initialPrompt" <ws> "{" <line_end> { <trigger_action_a_initial_prompt_property_line> } <indent> "}" <line_end>
<trigger_action_a_initial_prompt_property_line> ::= <indent> <trigger_action_a_initial_prompt_property> <line_end>
<trigger_action_a_initial_prompt_property> ::= "displayedMessage" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "immediateActionPrompt" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = JAVASCRIPT_EXPRESSION *)
  | "type" ":" <ws> ( "item" | "jsExpression" ) (* data type: string; lov: STATIC *)
<trigger_action_a_input_value> ::= <indent> "inputValue" <ws> "{" <line_end> { <trigger_action_a_input_value_property_line> } <indent> "}" <line_end>
<trigger_action_a_input_value_property_line> ::= <indent> <trigger_action_a_input_value_property> <line_end>
<trigger_action_a_input_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = JAVASCRIPT *)
  | "type" ":" <ws> ( "jsCode" | "item" | "onlySystemPrompt" ) (* required; data type: string; lov: STATIC *)
<trigger_action_a_quick_actions> ::= <indent> "quickActions" <ws> "{" <line_end> { <trigger_action_a_quick_actions_property_line> } <indent> "}" <line_end>
<trigger_action_a_quick_actions_property_line> ::= <indent> <trigger_action_a_quick_actions_property> <line_end>
<trigger_action_a_quick_actions_property> ::= "message1" ":" <ws> <string_like_value> (* data type: string *)
  | "message2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when quick_action_message1 is set *)
<trigger_action_a_security> ::= <indent> "security" <ws> "{" <line_end> { <trigger_action_a_security_property_line> } <indent> "}" <line_end>
<trigger_action_a_security_property_line> ::= <indent> <trigger_action_a_security_property> <line_end>
<trigger_action_a_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<trigger_action_a_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <trigger_action_a_server_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_a_server_side_condition_property_line> ::= <indent> <trigger_action_a_server_side_condition_property> <line_end>
<trigger_action_a_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<trigger_action_a_settings> ::= <indent> "settings" <ws> "{" <line_end> { <trigger_action_a_settings_property_line> } <indent> "}" <line_end>
<trigger_action_a_settings_property_line> ::= <indent> <trigger_action_a_settings_property> <line_end>
<trigger_action_a_settings_property> ::= "action" ":" <ws> ( "subscription" | "aggregate" | "flashback" | "filters" | "columns" | "compute" | "pivot" | "controlBreak" | "download" | "groupBy" | "saveReport" | "sort" | "chart" | "highlight" ) (* required; data type: string; lov: STATIC *)
  | "cancelLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "class" ":" <ws> <string_like_value> (* required; data type: string *)
  | "clearErrors" ":" <ws> <boolean> (* required; data type: boolean *)
  | "confirmLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "cssClasses" ":" <ws> <string_like_value> (* data type: string *)
  | "enableHighAccuracy" ":" <ws> <boolean> (* required; data type: boolean *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (SQL_STATEMENT) or type in (PLSQL_EXPRESSION) or type in (FUNCTION_BODY) *)
  | "filePassword" ":" <ws> <string_like_value> (* data type: string *)
  | "fileSource" ":" <ws> ( "sqlQuery" | "fileUrls" ) (* required; conditional; data type: string; lov: STATIC; applies when share_type = files *)
  | "fileUrls" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = file_url *)
  | "filename" ":" <ws> <string_like_value> (* data type: string *)
  | "hidePageItemsOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = geojson *)
  | "itemsToReturn" ":" <ws> <string_like_value> (* data type: string *)
  | "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "jsCode" ":" <ws> <string_like_value> (* required; data type: string *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = JAVASCRIPT_EXPRESSION *)
  | "jsFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = javascript_code *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; data type: string; lov: STATIC *)
  | "latitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "longitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "maintainPagination" ":" <ws> <boolean> (* required; data type: boolean *)
  | "message" ":" <ws> <string_like_value> (* required; data type: string *)
  | "okLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = PLSQL *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY *)
  | "reportQuery" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: reportQuery; dynamic values omitted *)
  | "requestButtonName" ":" <ws> <string_like_value> (* data type: string *)
  | "returnItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = DIALOG_RETURN_ITEM *)
  | "returnType" ":" <ws> ( "jsFunction" | "latitudeAndLongitude" | "geojson" ) (* required; data type: string; lov: STATIC *)
  | "showAllOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "showProcessing" ":" <ws> <boolean> (* required; data type: boolean *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = sql_query *)
  | "style" ":" <ws> ( "information" | "danger" | "warning" | "success" ) (* data type: string; lov: STATIC *)
  | "styleName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when items_to_return is set *)
  | "text" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "url" | "currentPage" | "files" ) (* required; data type: string; lov: STATIC *)
  | "type" ":" <ws> ( "plsqlExpression" | "dialogReturnItem" | "static" | "plsqlFunctionBody" | "sqlQuery" | "jsExpression" ) (* required; data type: string; lov: STATIC *)
  | "url" ":" <ws> <value> (* required; conditional; data type: complex; applies when share_type = url *)
  | "value" ":" <ws> <string_like_value> (* data type: string *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; data type: string; lov: STATIC *)
<trigger_action_a_source> ::= <indent> "source" <ws> "{" <line_end> { <trigger_action_a_source_property_line> } <indent> "}" <line_end>
<trigger_action_a_source_property_line> ::= <indent> <trigger_action_a_source_property> <line_end>
<trigger_action_a_source_property> ::= "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = N *)
<trigger_action_a_use_response> ::= <indent> "useResponse" <ws> "{" <line_end> { <trigger_action_a_use_response_property_line> } <indent> "}" <line_end>
<trigger_action_a_use_response_property_line> ::= <indent> <trigger_action_a_use_response_property> <line_end>
<trigger_action_a_use_response_property> ::= "buttonLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = ITEM *)
  | "jsCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = JAVASCRIPT *)
  | "jsDetectionExpression" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_response_type = ITEM *)
  | "type" ":" <ws> ( "item" | "jsCode" ) (* data type: string; lov: STATIC *)

(* triggerAction *)
(* direct properties use default group: identification *)
<trigger_action_b> ::= "triggerAction" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <trigger_action_b_body_line> } <indent> ")" <line_end>
<trigger_action_b_body_line> ::= <trigger_action_b_direct_property_line>
  | <trigger_action_b_group_block>
<trigger_action_b_direct_property_line> ::= <indent> <trigger_action_b_direct_property> <line_end>
<trigger_action_b_direct_property> ::= "action" ":" <ws> <trigger_action_b_action_plugin_lov> (* required; data type: string; lov: PLUGINS *)
  | "name" ":" <ws> <string_like_value> (* data type: string *)
<trigger_action_b_group_block> ::= <trigger_action_b_advanced>
  | <trigger_action_b_affected_elements>
  | <trigger_action_b_appearance>
  | <trigger_action_b_client_side_condition>
  | <trigger_action_b_comments>
  | <trigger_action_b_config>
  | <trigger_action_b_execution>
  | <trigger_action_b_file_handling>
  | <trigger_action_b_gen_ai>
  | <trigger_action_b_initial_prompt>
  | <trigger_action_b_input_value>
  | <trigger_action_b_quick_actions>
  | <trigger_action_b_security>
  | <trigger_action_b_server_side_condition>
  | <trigger_action_b_settings>
  | <trigger_action_b_source>
  | <trigger_action_b_use_response>
<trigger_action_b_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <trigger_action_b_advanced_property_line> } <indent> "}" <line_end>
<trigger_action_b_advanced_property_line> ::= <indent> <trigger_action_b_advanced_property> <line_end>
<trigger_action_b_advanced_property> ::= "initJavaScriptFunction" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports INIT_JAVASCRIPT_CODE *)
  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<trigger_action_b_affected_elements> ::= <indent> "affectedElements" <ws> "{" <line_end> { <trigger_action_b_affected_elements_property_line> } <indent> "}" <line_end>
<trigger_action_b_affected_elements_property_line> ::= <indent> <trigger_action_b_affected_elements_property> <line_end>
<trigger_action_b_affected_elements_property> ::= "button" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: button; applies when action supports ITEM and selectionType = button or action supports BUTTON and selectionType = button or action supports REGION and selectionType = button or other dependency conditions are satisfied; dynamic values omitted *)
  | "items" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = items or action supports BUTTON and selectionType = items or action supports REGION and selectionType = items or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = javaScriptExpression or action supports BUTTON and selectionType = javaScriptExpression or action supports REGION and selectionType = javaScriptExpression or other dependency conditions are satisfied *)
  | "jquerySelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when action supports ITEM and selectionType = jquerySelector or action supports BUTTON and selectionType = jquerySelector or action supports REGION and selectionType = jquerySelector or other dependency conditions are satisfied *)
  | "region" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: region; applies when action supports ITEM and selectionType = region or action supports BUTTON and selectionType = region or action supports REGION and selectionType = region or other dependency conditions are satisfied; dynamic values omitted *)
  | "selectionType" ":" <ws> ( "items" | "button" | "region" | "columns" | "domObject" | "jquerySelector" | "javaScriptExpression" | "triggeringElement" | "eventSource" ) (* conditional; data type: string; lov: STATIC; applies when action supports ITEM or action supports BUTTON or action supports REGION or other dependency conditions are satisfied *)
<trigger_action_b_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <trigger_action_b_appearance_property_line> } <indent> "}" <line_end>
<trigger_action_b_appearance_property_line> ::= <indent> <trigger_action_b_appearance_property> <line_end>
<trigger_action_b_appearance_property> ::= "containerSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when display_as = INLINE *)
  | "displayAs" ":" <ws> ( "dialog" | "inline" ) (* required; data type: string; lov: STATIC *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as = DIALOG *)
<trigger_action_b_client_side_condition> ::= <indent> "clientSideCondition" <ws> "{" <line_end> { <trigger_action_b_client_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_b_client_side_condition_property_line> ::= <indent> <trigger_action_b_client_side_condition_property> <line_end>
<trigger_action_b_client_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsExpression *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInList) or type in (itemIsNotInList) *)
  | "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* data type: string; lov: STATIC *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (item>value) or other dependency conditions are satisfied *)
<trigger_action_b_comments> ::= <indent> "comments" <ws> "{" <line_end> { <trigger_action_b_comments_property_line> } <indent> "}" <line_end>
<trigger_action_b_comments_property_line> ::= <indent> <trigger_action_b_comments_property> <line_end>
<trigger_action_b_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<trigger_action_b_config> ::= <indent> "config" <ws> "{" <line_end> { <trigger_action_b_config_property_line> } <indent> "}" <line_end>
<trigger_action_b_config_property_line> ::= <indent> <trigger_action_b_config_property> <line_end>
<trigger_action_b_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<trigger_action_b_execution> ::= <indent> "execution" <ws> "{" <line_end> { <trigger_action_b_execution_property_line> } <indent> "}" <line_end>
<trigger_action_b_execution_property_line> ::= <indent> <trigger_action_b_execution_property> <line_end>
<trigger_action_b_execution_property> ::= "sequence" ":" <ws> <number> (* required; data type: number *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports STOP_EXECUTION_ON_ERROR *)
  | "waitForResult" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports WAIT_FOR_RESULT *)
<trigger_action_b_file_handling> ::= <indent> "fileHandling" <ws> "{" <line_end> { <trigger_action_b_file_handling_property_line> } <indent> "}" <line_end>
<trigger_action_b_file_handling_property_line> ::= <indent> <trigger_action_b_file_handling_property> <line_end>
<trigger_action_b_file_handling_property> ::= "filename" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "multipleFiles" ":" <ws> <boolean> (* required; data type: boolean *)
  | "viewFileAs" ":" <ws> ( "inline" | "attachment" ) (* required; conditional; data type: string; lov: STATIC; applies when multiple_files = N *)
<trigger_action_b_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <trigger_action_b_gen_ai_property_line> } <indent> "}" <line_end>
<trigger_action_b_gen_ai_property_line> ::= <indent> <trigger_action_b_gen_ai_property> <line_end>
<trigger_action_b_gen_ai_property> ::= "agent" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: aiAgent; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "enabled" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when action supports AI_ENABLED *)
  | "itemsToSubmit" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true *)
  | "service" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: genAIService; applies when action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_ENABLED and enabled = true; dynamic values omitted *)
  | "systemPrompt" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_SYSTEM_PROMPT and action supports AI_ENABLED and enabled = true *)
  | "welcomeMessage" ":" <ws> <multiline_string> (* conditional; data type: string; applies when action supports AI_UI and action supports AI_ENABLED_ALWAYS and action supports AI_ENABLED and enabled = true or action supports AI_UI and action supports AI_ENABLED and enabled = true *)
<trigger_action_b_initial_prompt> ::= <indent> "initialPrompt" <ws> "{" <line_end> { <trigger_action_b_initial_prompt_property_line> } <indent> "}" <line_end>
<trigger_action_b_initial_prompt_property_line> ::= <indent> <trigger_action_b_initial_prompt_property> <line_end>
<trigger_action_b_initial_prompt_property> ::= "displayedMessage" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "immediateActionPrompt" ":" <ws> <string_like_value> (* conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when initial_prompt_type = JAVASCRIPT_EXPRESSION *)
  | "type" ":" <ws> ( "item" | "jsExpression" ) (* data type: string; lov: STATIC *)
<trigger_action_b_input_value> ::= <indent> "inputValue" <ws> "{" <line_end> { <trigger_action_b_input_value_property_line> } <indent> "}" <line_end>
<trigger_action_b_input_value_property_line> ::= <indent> <trigger_action_b_input_value_property> <line_end>
<trigger_action_b_input_value_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = ITEM *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when input_value_type = JAVASCRIPT *)
  | "type" ":" <ws> ( "jsCode" | "item" | "onlySystemPrompt" ) (* required; data type: string; lov: STATIC *)
<trigger_action_b_quick_actions> ::= <indent> "quickActions" <ws> "{" <line_end> { <trigger_action_b_quick_actions_property_line> } <indent> "}" <line_end>
<trigger_action_b_quick_actions_property_line> ::= <indent> <trigger_action_b_quick_actions_property> <line_end>
<trigger_action_b_quick_actions_property> ::= "message1" ":" <ws> <string_like_value> (* data type: string *)
  | "message2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when quick_action_message1 is set *)
<trigger_action_b_security> ::= <indent> "security" <ws> "{" <line_end> { <trigger_action_b_security_property_line> } <indent> "}" <line_end>
<trigger_action_b_security_property_line> ::= <indent> <trigger_action_b_security_property> <line_end>
<trigger_action_b_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<trigger_action_b_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <trigger_action_b_server_side_condition_property_line> } <indent> "}" <line_end>
<trigger_action_b_server_side_condition_property_line> ::= <indent> <trigger_action_b_server_side_condition_property> <line_end>
<trigger_action_b_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<trigger_action_b_settings> ::= <indent> "settings" <ws> "{" <line_end> { <trigger_action_b_settings_property_line> } <indent> "}" <line_end>
<trigger_action_b_settings_property_line> ::= <indent> <trigger_action_b_settings_property> <line_end>
<trigger_action_b_settings_property> ::= "action" ":" <ws> ( "subscription" | "aggregate" | "flashback" | "filters" | "columns" | "compute" | "pivot" | "controlBreak" | "download" | "groupBy" | "saveReport" | "sort" | "chart" | "highlight" ) (* required; data type: string; lov: STATIC *)
  | "cancelLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "class" ":" <ws> <string_like_value> (* required; data type: string *)
  | "clearErrors" ":" <ws> <boolean> (* required; data type: boolean *)
  | "confirmLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "cssClasses" ":" <ws> <string_like_value> (* data type: string *)
  | "enableHighAccuracy" ":" <ws> <boolean> (* required; data type: boolean *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (SQL_STATEMENT) or type in (PLSQL_EXPRESSION) or type in (FUNCTION_BODY) *)
  | "filePassword" ":" <ws> <string_like_value> (* data type: string *)
  | "fileSource" ":" <ws> ( "sqlQuery" | "fileUrls" ) (* required; conditional; data type: string; lov: STATIC; applies when share_type = files *)
  | "fileUrls" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = file_url *)
  | "filename" ":" <ws> <string_like_value> (* data type: string *)
  | "hidePageItemsOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "icon" ":" <ws> <string_like_value> (* data type: string *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = geojson *)
  | "itemsToReturn" ":" <ws> <string_like_value> (* data type: string *)
  | "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "jsCode" ":" <ws> <string_like_value> (* required; data type: string *)
  | "jsExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = JAVASCRIPT_EXPRESSION *)
  | "jsFunction" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = javascript_code *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; data type: string; lov: STATIC *)
  | "latitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "longitudeItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when return_type = lat_long *)
  | "maintainPagination" ":" <ws> <boolean> (* required; data type: boolean *)
  | "message" ":" <ws> <string_like_value> (* required; data type: string *)
  | "okLabel" ":" <ws> <string_like_value> (* data type: string *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = PLSQL *)
  | "plsqlExpression" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = PLSQL_EXPRESSION *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY *)
  | "reportQuery" ":" <ws> <reference> (* required; data type: string; lov: COMPONENT; references: reportQuery; dynamic values omitted *)
  | "requestButtonName" ":" <ws> <string_like_value> (* data type: string *)
  | "returnItem" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = DIALOG_RETURN_ITEM *)
  | "returnType" ":" <ws> ( "jsFunction" | "latitudeAndLongitude" | "geojson" ) (* required; data type: string; lov: STATIC *)
  | "showAllOnSameLine" ":" <ws> <boolean> (* data type: boolean *)
  | "showProcessing" ":" <ws> <boolean> (* required; data type: boolean *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when share_type = files and file_source = sql_query *)
  | "style" ":" <ws> ( "information" | "danger" | "warning" | "success" ) (* data type: string; lov: STATIC *)
  | "styleName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when items_to_return is set *)
  | "text" ":" <ws> <string_like_value> (* required; data type: string *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "url" | "currentPage" | "files" ) (* required; data type: string; lov: STATIC *)
  | "type" ":" <ws> ( "plsqlExpression" | "dialogReturnItem" | "static" | "plsqlFunctionBody" | "sqlQuery" | "jsExpression" ) (* required; data type: string; lov: STATIC *)
  | "url" ":" <ws> <value> (* required; conditional; data type: complex; applies when share_type = url *)
  | "value" ":" <ws> <string_like_value> (* data type: string *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; data type: string; lov: STATIC *)
<trigger_action_b_source> ::= <indent> "source" <ws> "{" <line_end> { <trigger_action_b_source_property_line> } <indent> "}" <line_end>
<trigger_action_b_source_property_line> ::= <indent> <trigger_action_b_source_property> <line_end>
<trigger_action_b_source_property> ::= "itemsToSubmit" ":" <ws> <string_like_value> (* data type: string *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = Y *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when multiple_files = N *)
<trigger_action_b_use_response> ::= <indent> "useResponse" <ws> "{" <line_end> { <trigger_action_b_use_response_property_line> } <indent> "}" <line_end>
<trigger_action_b_use_response_property_line> ::= <indent> <trigger_action_b_use_response_property> <line_end>
<trigger_action_b_use_response_property> ::= "buttonLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = ITEM *)
  | "jsCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_response_type = JAVASCRIPT *)
  | "jsDetectionExpression" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_response_type is set *)
  | "suppressChangeEvent" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when use_response_type = ITEM *)
  | "type" ":" <ws> ( "item" | "jsCode" ) (* data type: string; lov: STATIC *)

(* column *)
(* direct properties use default group: identification *)
<column_c> ::= "column" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <column_c_body_line> } <indent> ")" <line_end>
<column_c_body_line> ::= <column_c_direct_property_line>
  | <column_c_group_block>
<column_c_direct_property_line> ::= <indent> <column_c_direct_property> <line_end>
<column_c_direct_property> ::= "columnName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "derivedColumn" ":" <ws> <string_like_value> (* data type: string *)
  | "reportColumnQueryId" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "plainText" | "plainTextBasedOnLov" | "richText" | "link" | "displayImage" | "downloadBlob" | "percentGraph" | "hidden" | "displayAsTextSavesState" | "datePickerClassic" | "datePicker" | "textField" | "textArea" | "selectList" | "radioGroup" | "hiddenField" | "popupLov" | "popupKeyLov" | "simpleCheckbox" | "rowSelector" ) (* required; data type: string; lov: STATIC *)
<column_c_group_block> ::= <column_c_accessibility>
  | <column_c_advanced>
  | <column_c_appearance>
  | <column_c_blob_attributes>
  | <column_c_column_formatting>
  | <column_c_comments>
  | <column_c_config>
  | <column_c_element>
  | <column_c_export_printing>
  | <column_c_heading>
  | <column_c_layout>
  | <column_c_link>
  | <column_c_lov>
  | <column_c_security>
  | <column_c_server_side_condition>
  | <column_c_settings>
  | <column_c_sorting>
  | <column_c_ui_defaults_reference>
<column_c_accessibility> ::= <indent> "accessibility" <ws> "{" <line_end> { <column_c_accessibility_property_line> } <indent> "}" <line_end>
<column_c_accessibility_property_line> ::= <indent> <column_c_accessibility_property> <line_end>
<column_c_accessibility_property> ::= "imageDescription" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = displayImage *)
  | "valueIdentifiesRow" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
<column_c_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <column_c_advanced_property_line> } <indent> "}" <line_end>
<column_c_advanced_property_line> ::= <indent> <column_c_advanced_property> <line_end>
<column_c_advanced_property> ::= "cellWidth" ":" <ws> <number> (* conditional; data type: integer *)
  | "computeSum" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
  | "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type in (textField) or type in (textArea) or type in (datePickerClassic) or other dependency conditions are satisfied *)
  | "customAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (textField) or type in (textArea) or type in (datePickerClassic) or other dependency conditions are satisfied *)
<column_c_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <column_c_appearance_property_line> } <indent> "}" <line_end>
<column_c_appearance_property_line> ::= <indent> <column_c_appearance_property> <line_end>
<column_c_appearance_property> ::= "backgroundColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = percentGraph *)
  | "barWidth" ":" <ws> <number> (* conditional; data type: integer; applies when type = percentGraph *)
  | "downloadText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = downloadBlob *)
  | "foregroundColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = percentGraph *)
  | "formatMask" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (plainText) or type in (link) or type in (displayAsTextSavesState) or other dependency conditions are satisfied *)
  | "formatMask" ":" <ws> ( "useAppDateFormat" | "useAppFormatMask" | "useItemFormatMask" | "ddMmYyyy" | "ddMmYyyyHhMi" | "ddMmYyyyHh24Mi" | "ddMonRr" | "ddMonRrHhMi" | "ddMonRrHh24Mi" | "ddMonYyyy" | "ddMonYyyyHhMi" | "ddMonYyyyHh24Mi" | "mmDdYyyy" | "mmDdYyyyHhMi" | "mmDdYyyyHh24Mi" | "rrMonDd" | "rrMonDdHhMi" | "rrMonDdHh24Mi" | "yyyyDdMm" | "yyyyDdMmHhMi" | "yyyyDdMmHh24Mi" | "yyyyMmDd" | "yyyyMmDdHhMi" | "yyyyMmDdHh24Mi" ) (* required; conditional; data type: string; lov: STATIC; applies when type = datePickerClassic *)
  | "height" ":" <ws> <number> (* conditional; data type: number; applies when type = textArea *)
  | "template" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: fieldTemplate; applies when type in (displayAsTextSavesState) or type in (textField) or type in (textArea) or other dependency conditions are satisfied; dynamic values omitted *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; conditional; data type: string; lov: STATIC; applies when type = downloadBlob *)
  | "width" ":" <ws> <number> (* conditional; data type: number; applies when type in (textField) or type in (textArea) or type in (datePickerClassic) or other dependency conditions are satisfied *)
<column_c_blob_attributes> ::= <indent> "blobAttributes" <ws> "{" <line_end> { <column_c_blob_attributes_property_line> } <indent> "}" <line_end>
<column_c_blob_attributes_property_line> ::= <indent> <column_c_blob_attributes_property> <line_end>
<column_c_blob_attributes_property> ::= "blobColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "charSetColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = downloadBlob *)
  | "filenameColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "lastUpdatedColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "mimeTypeColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "primaryKeyColumn1" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "primaryKeyColumn2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "tableName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "tableOwner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
<column_c_column_formatting> ::= <indent> "columnFormatting" <ws> "{" <line_end> { <column_c_column_formatting_property_line> } <indent> "}" <line_end>
<column_c_column_formatting_property_line> ::= <indent> <column_c_column_formatting_property> <line_end>
<column_c_column_formatting_property> ::= "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type in (plainText) or type in (link) or type in (percentGraph) *)
  | "cssStyle" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type in (plainText) or type in (link) or type in (percentGraph) *)
  | "highlightWords" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = plainText *)
  | "htmlExpression" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = plainText *)
<column_c_comments> ::= <indent> "comments" <ws> "{" <line_end> { <column_c_comments_property_line> } <indent> "}" <line_end>
<column_c_comments_property_line> ::= <indent> <column_c_comments_property> <line_end>
<column_c_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<column_c_config> ::= <indent> "config" <ws> "{" <line_end> { <column_c_config_property_line> } <indent> "}" <line_end>
<column_c_config_property_line> ::= <indent> <column_c_config_property> <line_end>
<column_c_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<column_c_element> ::= <indent> "element" <ws> "{" <line_end> { <column_c_element_property_line> } <indent> "}" <line_end>
<column_c_element_property_line> ::= <indent> <column_c_element_property> <line_end>
<column_c_element_property> ::= "numberOfColumns" ":" <ws> <number> (* conditional; data type: integer; applies when type = radioGroup *)
<column_c_export_printing> ::= <indent> "exportPrinting" <ws> "{" <line_end> { <column_c_export_printing_property_line> } <indent> "}" <line_end>
<column_c_export_printing_property_line> ::= <indent> <column_c_export_printing_property> <line_end>
<column_c_export_printing_property> ::= "includeInExportPrint" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
  | "printWidth" ":" <ws> <string_like_value> (* conditional; data type: string; applies when includeInExportPrint = true *)
<column_c_heading> ::= <indent> "heading" <ws> "{" <line_end> { <column_c_heading_property_line> } <indent> "}" <line_end>
<column_c_heading_property_line> ::= <indent> <column_c_heading_property> <line_end>
<column_c_heading_property> ::= "alignment" ":" <ws> ( "start" | "center" | "end" ) (* required; conditional; data type: string; lov: STATIC *)
  | "heading" ":" <ws> <string_like_value> (* conditional; data type: string *)
<column_c_layout> ::= <indent> "layout" <ws> "{" <line_end> { <column_c_layout_property_line> } <indent> "}" <line_end>
<column_c_layout_property_line> ::= <indent> <column_c_layout_property> <line_end>
<column_c_layout_property> ::= "columnAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; conditional; data type: string; lov: STATIC *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
<column_c_link> ::= <indent> "link" <ws> "{" <line_end> { <column_c_link_property_line> } <indent> "}" <line_end>
<column_c_link_property_line> ::= <indent> <column_c_link_property> <line_end>
<column_c_link_property> ::= "linkAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (link) and target is set or type in (percentGraph) and target is set *)
  | "linkText" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (link) and target is set or type in (percentGraph) and target is set *)
  | "target" ":" <ws> <value> (* conditional; data type: complex; applies when type in (link) or type in (percentGraph) *)
<column_c_lov> ::= <indent> "lov" <ws> "{" <line_end> { <column_c_lov_property_line> } <indent> "}" <line_end>
<column_c_lov_property_line> ::= <indent> <column_c_lov_property> <line_end>
<column_c_lov_property> ::= "checkboxValues" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = simpleCheckbox *)
  | "displayExtraValues" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (selectList) or type in (radioGroup) *)
  | "displayNullValue" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (selectList) or type in (radioGroup) or type in (popupLov) or other dependency conditions are satisfied *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextBasedOnLov) and type = functionBody and language = javaScript-mle or type in (selectList) and type = functionBody and language = javaScript-mle or type in (radioGroup) and type = functionBody and language = javaScript-mle or other dependency conditions are satisfied *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (plainTextBasedOnLov) and type = functionBody or type in (selectList) and type = functionBody or type in (radioGroup) and type = functionBody or other dependency conditions are satisfied *)
  | "lov" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: lov; applies when type in (plainTextBasedOnLov) and type = sharedComponent or type in (selectList) and type = sharedComponent or type in (radioGroup) and type = sharedComponent or other dependency conditions are satisfied; dynamic values omitted *)
  | "nullDisplayValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (selectList) and displayNullValue = true or type in (radioGroup) and displayNullValue = true or type in (popupLov) and displayNullValue = true or other dependency conditions are satisfied *)
  | "nullReturnValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (selectList) and displayNullValue = true or type in (radioGroup) and displayNullValue = true or type in (popupLov) and displayNullValue = true or other dependency conditions are satisfied *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextBasedOnLov) and type = functionBody and language = plsql or type in (selectList) and type = functionBody and language = plsql or type in (radioGroup) and type = functionBody and language = plsql or other dependency conditions are satisfied *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextBasedOnLov) and type = sqlQuery or type in (selectList) and type = sqlQuery or type in (radioGroup) and type = sqlQuery or other dependency conditions are satisfied *)
  | "staticValues" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextBasedOnLov) and type = staticValues or type in (selectList) and type = staticValues or type in (radioGroup) and type = staticValues or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "sharedComponent" | "sqlQuery" | "staticValues" | "functionBody" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (plainTextBasedOnLov) or type in (selectList) or type in (radioGroup) or other dependency conditions are satisfied *)
<column_c_security> ::= <indent> "security" <ws> "{" <line_end> { <column_c_security_property_line> } <indent> "}" <line_end>
<column_c_security_property_line> ::= <indent> <column_c_security_property> <line_end>
<column_c_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (plainText) or type in (link) or type in (hidden) or other dependency conditions are satisfied *)
<column_c_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <column_c_server_side_condition_property_line> } <indent> "}" <line_end>
<column_c_server_side_condition_property_line> ::= <indent> <column_c_server_side_condition_property> <line_end>
<column_c_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<column_c_settings> ::= <indent> "settings" <ws> "{" <line_end> { <column_c_settings_property_line> } <indent> "}" <line_end>
<column_c_settings_property_line> ::= <indent> <column_c_settings_property> <line_end>
<column_c_settings_property> ::= "format" ":" <ws> ( "html" | "markdown" ) (* required; conditional; data type: string; lov: STATIC; applies when type = richText *)
<column_c_sorting> ::= <indent> "sorting" <ws> "{" <line_end> { <column_c_sorting_property_line> } <indent> "}" <line_end>
<column_c_sorting_property_line> ::= <indent> <column_c_sorting_property> <line_end>
<column_c_sorting_property> ::= "defaultSequence" ":" <ws> ( "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" ) (* conditional; data type: string; lov: STATIC *)
  | "direction" ":" <ws> ( "desc" ) (* conditional; data type: string; lov: STATIC; applies when defaultSequence is set *)
  | "sortable" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
<column_c_ui_defaults_reference> ::= <indent> "uiDefaultsReference" <ws> "{" <line_end> { <column_c_ui_defaults_reference_property_line> } <indent> "}" <line_end>
<column_c_ui_defaults_reference_property_line> ::= <indent> <column_c_ui_defaults_reference_property> <line_end>
<column_c_ui_defaults_reference_property> ::= "column" ":" <ws> <string_like_value> (* data type: string *)
  | "tableName" ":" <ws> <string_like_value> (* data type: string *)
  | "tableOwner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when derivedColumn = N *)

(* column *)
(* direct properties use default group: identification *)
<column_d> ::= "column" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <column_d_body_line> } <indent> ")" <line_end>
<column_d_body_line> ::= <column_d_direct_property_line>
  | <column_d_group_block>
<column_d_direct_property_line> ::= <indent> <column_d_direct_property> <line_end>
<column_d_direct_property> ::= "columnName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "derivedColumn" ":" <ws> <string_like_value> (* data type: string *)
  | "reportColumnQueryId" ":" <ws> <string_like_value> (* data type: string *)
  | "type" ":" <ws> ( "rowSelector" | "plainText" | "plainTextSavesState" | "plainTextBasedOnLov" | "link" | "displayImage" | "downloadBlob" | "percentGraph" | "textField" | "textArea" | "selectList" | "popupLovShowsDisplaysValue" | "popupLovShowsReturnValue" | "radioGroup" | "simpleCheckbox" | "datePicker" | "datePickerClassic" | "hidden" | "hiddenSavesState" ) (* required; data type: string; lov: STATIC *)
<column_d_group_block> ::= <column_d_accessibility>
  | <column_d_advanced>
  | <column_d_appearance>
  | <column_d_blob_attributes>
  | <column_d_column_formatting>
  | <column_d_comments>
  | <column_d_config>
  | <column_d_default>
  | <column_d_element>
  | <column_d_export_printing>
  | <column_d_heading>
  | <column_d_layout>
  | <column_d_link>
  | <column_d_lov>
  | <column_d_primary_key_source>
  | <column_d_security>
  | <column_d_server_side_condition>
  | <column_d_sorting>
  | <column_d_ui_defaults_reference>
<column_d_accessibility> ::= <indent> "accessibility" <ws> "{" <line_end> { <column_d_accessibility_property_line> } <indent> "}" <line_end>
<column_d_accessibility_property_line> ::= <indent> <column_d_accessibility_property> <line_end>
<column_d_accessibility_property> ::= "imageDescription" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = displayImage *)
  | "valueIdentifiesRow" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
<column_d_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <column_d_advanced_property_line> } <indent> "}" <line_end>
<column_d_advanced_property_line> ::= <indent> <column_d_advanced_property> <line_end>
<column_d_advanced_property> ::= "cellWidth" ":" <ws> <number> (* conditional; data type: integer *)
  | "computeSum" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
  | "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type in (textField) or type in (textArea) or type in (datePickerClassic) or other dependency conditions are satisfied *)
  | "customAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (textField) or type in (textArea) or type in (datePickerClassic) or other dependency conditions are satisfied *)
<column_d_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <column_d_appearance_property_line> } <indent> "}" <line_end>
<column_d_appearance_property_line> ::= <indent> <column_d_appearance_property> <line_end>
<column_d_appearance_property> ::= "backgroundColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = percentGraph *)
  | "barWidth" ":" <ws> <number> (* conditional; data type: integer; applies when type = percentGraph *)
  | "downloadText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = downloadBlob *)
  | "foregroundColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = percentGraph *)
  | "formatMask" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (plainText) or type in (link) or type in (plainTextSavesState) or other dependency conditions are satisfied *)
  | "formatMask" ":" <ws> ( "useAppDateFormat" | "useAppFormatMask" | "useItemFormatMask" | "ddMmYyyy" | "ddMmYyyyHhMi" | "ddMmYyyyHh24Mi" | "ddMonRr" | "ddMonRrHhMi" | "ddMonRrHh24Mi" | "ddMonYyyy" | "ddMonYyyyHhMi" | "ddMonYyyyHh24Mi" | "mmDdYyyy" | "mmDdYyyyHhMi" | "mmDdYyyyHh24Mi" | "rrMonDd" | "rrMonDdHhMi" | "rrMonDdHh24Mi" | "yyyyDdMm" | "yyyyDdMmHhMi" | "yyyyDdMmHh24Mi" | "yyyyMmDd" | "yyyyMmDdHhMi" | "yyyyMmDdHh24Mi" ) (* required; conditional; data type: string; lov: STATIC; applies when type = datePickerClassic *)
  | "height" ":" <ws> <number> (* conditional; data type: number; applies when type = textArea *)
  | "template" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: fieldTemplate; applies when type in (plainTextSavesState) or type in (textField) or type in (textArea) or other dependency conditions are satisfied; dynamic values omitted *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; conditional; data type: string; lov: STATIC; applies when type = downloadBlob *)
  | "width" ":" <ws> <number> (* conditional; data type: number; applies when type in (textField) or type in (textArea) or type in (datePickerClassic) or other dependency conditions are satisfied *)
<column_d_blob_attributes> ::= <indent> "blobAttributes" <ws> "{" <line_end> { <column_d_blob_attributes_property_line> } <indent> "}" <line_end>
<column_d_blob_attributes_property_line> ::= <indent> <column_d_blob_attributes_property> <line_end>
<column_d_blob_attributes_property> ::= "blobColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "charSetColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = downloadBlob *)
  | "filenameColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "lastUpdatedColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "mimeTypeColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "primaryKeyColumn1" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "primaryKeyColumn2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "tableName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "tableOwner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
<column_d_column_formatting> ::= <indent> "columnFormatting" <ws> "{" <line_end> { <column_d_column_formatting_property_line> } <indent> "}" <line_end>
<column_d_column_formatting_property_line> ::= <indent> <column_d_column_formatting_property> <line_end>
<column_d_column_formatting_property> ::= "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type in (plainText) or type in (link) or type in (percentGraph) *)
  | "cssStyle" ":" <ws> <array_of_string_like_value> (* conditional; data type: string; applies when type in (plainText) or type in (link) or type in (percentGraph) *)
  | "highlightWords" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = plainText *)
  | "htmlExpression" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type = plainText *)
<column_d_comments> ::= <indent> "comments" <ws> "{" <line_end> { <column_d_comments_property_line> } <indent> "}" <line_end>
<column_d_comments_property_line> ::= <indent> <column_d_comments_property> <line_end>
<column_d_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<column_d_config> ::= <indent> "config" <ws> "{" <line_end> { <column_d_config_property_line> } <indent> "}" <line_end>
<column_d_config_property_line> ::= <indent> <column_d_config_property> <line_end>
<column_d_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<column_d_default> ::= <indent> "default" <ws> "{" <line_end> { <column_d_default_property_line> } <indent> "}" <line_end>
<column_d_default_property_line> ::= <indent> <column_d_default_property> <line_end>
<column_d_default_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (plainTextSavesState) and type = item or type in (datePickerClassic) and type = item or type in (datePicker) and type = item or other dependency conditions are satisfied *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextSavesState) and type = plsqlExpression or type in (datePickerClassic) and type = plsqlExpression or type in (datePicker) and type = plsqlExpression or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "item" | "plsqlExpression" ) (* conditional; data type: string; lov: STATIC; applies when type in (plainTextSavesState) or type in (datePickerClassic) or type in (datePicker) or other dependency conditions are satisfied *)
<column_d_element> ::= <indent> "element" <ws> "{" <line_end> { <column_d_element_property_line> } <indent> "}" <line_end>
<column_d_element_property_line> ::= <indent> <column_d_element_property> <line_end>
<column_d_element_property> ::= "numberOfColumns" ":" <ws> <number> (* conditional; data type: integer; applies when type = radioGroup *)
<column_d_export_printing> ::= <indent> "exportPrinting" <ws> "{" <line_end> { <column_d_export_printing_property_line> } <indent> "}" <line_end>
<column_d_export_printing_property_line> ::= <indent> <column_d_export_printing_property> <line_end>
<column_d_export_printing_property> ::= "includeInExportPrint" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
  | "printWidth" ":" <ws> <string_like_value> (* conditional; data type: string; applies when includeInExportPrint = true *)
<column_d_heading> ::= <indent> "heading" <ws> "{" <line_end> { <column_d_heading_property_line> } <indent> "}" <line_end>
<column_d_heading_property_line> ::= <indent> <column_d_heading_property> <line_end>
<column_d_heading_property> ::= "alignment" ":" <ws> ( "start" | "center" | "end" ) (* required; conditional; data type: string; lov: STATIC *)
  | "heading" ":" <ws> <string_like_value> (* conditional; data type: string *)
<column_d_layout> ::= <indent> "layout" <ws> "{" <line_end> { <column_d_layout_property_line> } <indent> "}" <line_end>
<column_d_layout_property_line> ::= <indent> <column_d_layout_property> <line_end>
<column_d_layout_property> ::= "columnAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; conditional; data type: string; lov: STATIC *)
  | "sequence" ":" <ws> <number> (* required; data type: number *)
<column_d_link> ::= <indent> "link" <ws> "{" <line_end> { <column_d_link_property_line> } <indent> "}" <line_end>
<column_d_link_property_line> ::= <indent> <column_d_link_property> <line_end>
<column_d_link_property> ::= "linkAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (link) and target is set or type in (percentGraph) and target is set *)
  | "linkText" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (link) and target is set or type in (percentGraph) and target is set *)
  | "target" ":" <ws> <value> (* conditional; data type: complex; applies when type in (link) or type in (percentGraph) *)
<column_d_lov> ::= <indent> "lov" <ws> "{" <line_end> { <column_d_lov_property_line> } <indent> "}" <line_end>
<column_d_lov_property_line> ::= <indent> <column_d_lov_property> <line_end>
<column_d_lov_property> ::= "checkboxValues" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = simpleCheckbox *)
  | "displayExtraValues" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (selectList) or type in (radioGroup) *)
  | "displayNullValue" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (selectList) or type in (radioGroup) or type in (popupLovShowsReturnValue) or other dependency conditions are satisfied *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextBasedOnLov) and type = functionBody and language = javaScript-mle or type in (selectList) and type = functionBody and language = javaScript-mle or type in (radioGroup) and type = functionBody and language = javaScript-mle or other dependency conditions are satisfied *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (plainTextBasedOnLov) and type = functionBody or type in (selectList) and type = functionBody or type in (radioGroup) and type = functionBody or other dependency conditions are satisfied *)
  | "lov" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: lov; applies when type in (plainTextBasedOnLov) and type = sharedComponent or type in (selectList) and type = sharedComponent or type in (radioGroup) and type = sharedComponent or other dependency conditions are satisfied; dynamic values omitted *)
  | "nullDisplayValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (selectList) and displayNullValue = true or type in (radioGroup) and displayNullValue = true or type in (popupLovShowsReturnValue) and displayNullValue = true or other dependency conditions are satisfied *)
  | "nullReturnValue" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (selectList) and displayNullValue = true or type in (radioGroup) and displayNullValue = true or type in (popupLovShowsReturnValue) and displayNullValue = true or other dependency conditions are satisfied *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextBasedOnLov) and type = functionBody and language = plsql or type in (selectList) and type = functionBody and language = plsql or type in (radioGroup) and type = functionBody and language = plsql or other dependency conditions are satisfied *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextBasedOnLov) and type = sqlQuery or type in (selectList) and type = sqlQuery or type in (radioGroup) and type = sqlQuery or other dependency conditions are satisfied *)
  | "staticValues" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (plainTextBasedOnLov) and type = staticValues or type in (selectList) and type = staticValues or type in (radioGroup) and type = staticValues or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "sharedComponent" | "sqlQuery" | "staticValues" | "functionBody" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (plainTextBasedOnLov) or type in (selectList) or type in (radioGroup) or other dependency conditions are satisfied *)
<column_d_primary_key_source> ::= <indent> "primaryKeySource" <ws> "{" <line_end> { <column_d_primary_key_source_property_line> } <indent> "}" <line_end>
<column_d_primary_key_source_property_line> ::= <indent> <column_d_primary_key_source_property> <line_end>
<column_d_primary_key_source_property> ::= "name" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = existingSequence *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = plsqlExpression *)
  | "type" ":" <ws> ( "existingTrigger" | "plsqlExpression" | "existingSequence" ) (* conditional; data type: string; lov: STATIC *)
<column_d_security> ::= <indent> "security" <ws> "{" <line_end> { <column_d_security_property_line> } <indent> "}" <line_end>
<column_d_security_property_line> ::= <indent> <column_d_security_property> <line_end>
<column_d_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (plainText) or type in (link) or type in (hidden) or other dependency conditions are satisfied *)
<column_d_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <column_d_server_side_condition_property_line> } <indent> "}" <line_end>
<column_d_server_side_condition_property_line> ::= <indent> <column_d_server_side_condition_property> <line_end>
<column_d_server_side_condition_property> ::= "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = textIsContainedInItem *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (itemIsInColonDelimitedList) or type in (itemIsNotInColonDelimitedList) *)
  | "page" ":" <ws> <number> (* required; conditional; data type: integer; applies when type in (currentPage=page) or type in (currentPage!=page) *)
  | "pages" ":" <ws> <array_of_number> (* required; conditional; data type: integer; applies when type in (currentPageInList) or type in (currentPageNotInList) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "preference" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (userPreference=value) or type in (userPreference!=value) *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInItem) or type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or other dependency conditions are satisfied *)
  | "type" ":" <ws> <string_like_value> (* data type: string; lov: STATIC; dynamic values omitted *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (request=Value) or type in (request!=Value) or type in (requestIsContainedInValue) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (item=value) or type in (item!=value) or type in (VALUE_OF_ITEM_IN_COND_1_EQ_COND_2) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (textIsContainedInValue) or type in (textIsNotContainedInValue) or type in (text=value) or other dependency conditions are satisfied *)
<column_d_sorting> ::= <indent> "sorting" <ws> "{" <line_end> { <column_d_sorting_property_line> } <indent> "}" <line_end>
<column_d_sorting_property_line> ::= <indent> <column_d_sorting_property> <line_end>
<column_d_sorting_property> ::= "defaultSequence" ":" <ws> ( "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" ) (* conditional; data type: string; lov: STATIC *)
  | "direction" ":" <ws> ( "desc" ) (* conditional; data type: string; lov: STATIC; applies when defaultSequence is set *)
  | "sortable" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
<column_d_ui_defaults_reference> ::= <indent> "uiDefaultsReference" <ws> "{" <line_end> { <column_d_ui_defaults_reference_property_line> } <indent> "}" <line_end>
<column_d_ui_defaults_reference_property_line> ::= <indent> <column_d_ui_defaults_reference_property> <line_end>
<column_d_ui_defaults_reference_property> ::= "column" ":" <ws> <string_like_value> (* data type: string *)
  | "tableName" ":" <ws> <string_like_value> (* data type: string *)
  | "tableOwner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when derivedColumn = N *)

(* column *)
(* direct properties use default group: identification *)
<column_e> ::= "column" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <column_e_body_line> } <indent> ")" <line_end>
<column_e_body_line> ::= <column_e_direct_property_line>
  | <column_e_group_block>
<column_e_direct_property_line> ::= <indent> <column_e_direct_property> <line_end>
<column_e_direct_property> ::= "columnName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "show" ":" <ws> <boolean> (* required; data type: boolean *)
<column_e_group_block> ::= <column_e_advanced>
  | <column_e_appearance>
  | <column_e_comments>
  | <column_e_config>
  | <column_e_heading>
  | <column_e_layout>
  | <column_e_security>
  | <column_e_server_side_condition>
  | <column_e_source>
<column_e_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <column_e_advanced_property_line> } <indent> "}" <line_end>
<column_e_advanced_property_line> ::= <indent> <column_e_advanced_property> <line_end>
<column_e_advanced_property> ::= "customAttributes" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports VALUE_ATTRIBUTE and show = true *)
