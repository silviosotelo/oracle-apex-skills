(* aiAgent *)
(* direct properties use default group: identification *)
<ai_agent> ::= "aiAgent" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <ai_agent_body_line> } <indent> ")" <line_end>
<ai_agent_body_line> ::= <ai_agent_direct_property_line>
  | <ai_agent_group_block>
  | <ai_agent_child_component>
<ai_agent_direct_property_line> ::= <indent> <ai_agent_direct_property> <line_end>
<ai_agent_direct_property> ::= "name" ":" <ws> <string_like_value> (* required; data type: string *)
<ai_agent_group_block> ::= <ai_agent_advanced>
  | <ai_agent_comments>
  | <ai_agent_gen_ai>
  | <ai_agent_response_format>
  | <ai_agent_subscription>
<ai_agent_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <ai_agent_advanced_property_line> } <indent> "}" <line_end>
<ai_agent_advanced_property_line> ::= <indent> <ai_agent_advanced_property> <line_end>
<ai_agent_advanced_property> ::= "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
  | "temperature" ":" <ws> <number> (* data type: number *)
<ai_agent_comments> ::= <indent> "comments" <ws> "{" <line_end> { <ai_agent_comments_property_line> } <indent> "}" <line_end>
<ai_agent_comments_property_line> ::= <indent> <ai_agent_comments_property> <line_end>
<ai_agent_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<ai_agent_gen_ai> ::= <indent> "genAI" <ws> "{" <line_end> { <ai_agent_gen_ai_property_line> } <indent> "}" <line_end>
<ai_agent_gen_ai_property_line> ::= <indent> <ai_agent_gen_ai_property> <line_end>
<ai_agent_gen_ai_property> ::= "service" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: genAIService; dynamic values omitted *)
  | "systemPrompt" ":" <ws> <multiline_string> (* data type: string *)
  | "welcomeMessage" ":" <ws> <multiline_string> (* data type: string *)
<ai_agent_response_format> ::= <indent> "responseFormat" <ws> "{" <line_end> { <ai_agent_response_format_property_line> } <indent> "}" <line_end>
<ai_agent_response_format_property_line> ::= <indent> <ai_agent_response_format_property> <line_end>
<ai_agent_response_format_property> ::= "jsonSchema" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = jsonObject *)
  | "type" ":" <ws> ( "text" | "jsonObject" ) (* required; data type: string; lov: STATIC *)
<ai_agent_subscription> ::= <indent> "subscription" <ws> "{" <line_end> { <ai_agent_subscription_property_line> } <indent> "}" <line_end>
<ai_agent_subscription_property_line> ::= <indent> <ai_agent_subscription_property> <line_end>
<ai_agent_subscription_property> ::= "master" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: aiAgent; dynamic values omitted *)
<ai_agent_child_component> ::= <tool>

(* tool *)
(* direct properties use default group: identification *)
<tool> ::= "tool" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <tool_body_line> } <indent> ")" <line_end>
<tool_body_line> ::= <tool_direct_property_line>
  | <tool_group_block>
  | <tool_child_component>
<tool_direct_property_line> ::= <indent> <tool_direct_property> <line_end>
<tool_direct_property> ::= "description" ":" <ws> <multiline_string> (* conditional; data type: string; applies when executionPoint = onDemand *)
  | "executionPoint" ":" <ws> ( "augmentSystemPrompt" | "onDemand" ) (* required; data type: string; lov: STATIC *)
  | "name" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> <tool_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
<tool_group_block> ::= <tool_advanced>
  | <tool_comments>
  | <tool_config>
  | <tool_notification>
  | <tool_security>
  | <tool_server_side_condition>
  | <tool_settings>
  | <tool_user_approval>
<tool_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <tool_advanced_property_line> } <indent> "}" <line_end>
<tool_advanced_property_line> ::= <indent> <tool_advanced_property> <line_end>
<tool_advanced_property> ::= "staticId" ":" <ws> <string_like_value> (* required; data type: string *)
<tool_comments> ::= <indent> "comments" <ws> "{" <line_end> { <tool_comments_property_line> } <indent> "}" <line_end>
<tool_comments_property_line> ::= <indent> <tool_comments_property> <line_end>
<tool_comments_property> ::= "comments" ":" <ws> <multiline_string> (* data type: string *)
<tool_config> ::= <indent> "config" <ws> "{" <line_end> { <tool_config_property_line> } <indent> "}" <line_end>
<tool_config_property_line> ::= <indent> <tool_config_property> <line_end>
<tool_config_property> ::= "buildOption" ":" <ws> <reference> (* data type: string; lov: COMPONENT; references: buildOption; dynamic values omitted *)
<tool_notification> ::= <indent> "notification" <ws> "{" <line_end> { <tool_notification_property_line> } <indent> "}" <line_end>
<tool_notification_property_line> ::= <indent> <tool_notification_property> <line_end>
<tool_notification_property> ::= "message" ":" <ws> <multiline_string> (* conditional; data type: string; applies when executionPoint = onDemand *)
  | "type" ":" <ws> ( "info" | "success" ) (* conditional; data type: string; lov: STATIC; applies when executionPoint = onDemand and message is set *)
<tool_security> ::= <indent> "security" <ws> "{" <line_end> { <tool_security_property_line> } <indent> "}" <line_end>
<tool_security_property_line> ::= <indent> <tool_security_property> <line_end>
<tool_security_property> ::= "authorizationScheme" ":" <ws> ( "mustNotBePublicUser" ) (* data type: string; lov: COMPONENT; references: authorization; dynamic values omitted *)
<tool_server_side_condition> ::= <indent> "serverSideCondition" <ws> "{" <line_end> { <tool_server_side_condition_property_line> } <indent> "}" <line_end>
<tool_server_side_condition_property_line> ::= <indent> <tool_server_side_condition_property> <line_end>
<tool_server_side_condition_property> ::= "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = functionBody *)
  | "list" ":" <ws> <array_of_string_like_value> (* required; conditional; data type: string; applies when type in (anyUserPromptContains) or type in (lastUserPromptContains) *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = functionBody and language = plsql *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type = expression and language = sql *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (rowsReturned) or type in (noRowsReturned) *)
  | "type" ":" <ws> ( "anyUserPromptContains" | "lastUserPromptContains" | "rowsReturned" | "noRowsReturned" | "expression" | "functionBody" | "never" ) (* data type: string; lov: STATIC *)
<tool_settings> ::= <indent> "settings" <ws> "{" <line_end> { <tool_settings_property_line> } <indent> "}" <line_end>
<tool_settings_property_line> ::= <indent> <tool_settings_property> <line_end>
<tool_settings_property> ::= "dataDescription" ":" <ws> <string_like_value> (* data type: string *)
  | "jsCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = JAVASCRIPT *)
  | "jsFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY and language = JAVASCRIPT *)
  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = FUNCTION_BODY *)
  | "maxTokens" ":" <ws> <number> (* conditional; data type: integer; applies when type = SQL_QUERY *)
  | "plsqlCode" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when language = PLSQL *)
  | "plsqlFunctionBody" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = FUNCTION_BODY and language = PLSQL *)
  | "sqlQuery" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = SQL_QUERY *)
  | "text" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = STATIC *)
  | "type" ":" <ws> ( "sqlQuery" | "static" | "functionBody" ) (* required; data type: string; lov: STATIC *)
<tool_user_approval> ::= <indent> "userApproval" <ws> "{" <line_end> { <tool_user_approval_property_line> } <indent> "}" <line_end>
<tool_user_approval_property_line> ::= <indent> <tool_user_approval_property> <line_end>
<tool_user_approval_property> ::= "cancelLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when executionPoint = onDemand and requiresConfirmation = true *)
  | "confirmLabel" ":" <ws> <string_like_value> (* conditional; data type: string; applies when executionPoint = onDemand and requiresConfirmation = true *)
  | "message" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when executionPoint = onDemand and requiresConfirmation = true *)
  | "requiresConfirmation" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when executionPoint = onDemand *)
  | "title" ":" <ws> <string_like_value> (* conditional; data type: string; applies when executionPoint = onDemand and requiresConfirmation = true *)
<tool_child_component> ::= <parameter_c> (* applies when executionPoint = onDemand and type supports PARAMETERS_DEFINED_BY_TOOL *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter_c> ::= "parameter" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <parameter_c_body_line> } <indent> ")" <line_end>
<parameter_c_body_line> ::= <parameter_c_direct_property_line>
  | <parameter_c_group_block>
<parameter_c_direct_property_line> ::= <indent> <parameter_c_direct_property> <line_end>
<parameter_c_direct_property> ::= "description" ":" <ws> <multiline_string> (* data type: string *)
  | "name" ":" <ws> <string_like_value> (* required; data type: string *)
