  | "dropzoneTitle" ":" <ws> <string_like_value> (* conditional; data type: string; applies when display_as in (INLINE) or display_as in (DROPZONE_INLINE) or display_as in (DROPZONE_BLOCK) *)
  | "previewSize" ":" <ws> ( "extraLarge" | "extraSmall" | "auto" | "large" | "medium" | "small" ) (* required; conditional; data type: string; lov: STATIC; applies when display_as = DROPZONE_ICON *)
