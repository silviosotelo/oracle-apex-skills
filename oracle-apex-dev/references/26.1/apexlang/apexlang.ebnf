<parameter_a_multiple_values_property> ::= "multipleValues" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = urlQueryString and type in (httpHeader) and type in (urlPattern) and static = false and omitWhenValueIsEmpty = true or type = urlQueryString and type in (httpHeader) and type in (urlQueryString) and static = false and omitWhenValueIsEmpty = true or type = urlQueryString and type in (httpHeader) and type in (requestOrResponseBody) and static = false and omitWhenValueIsEmpty = true or other dependency conditions are satisfied *)
  | "separator" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = urlQueryString and type in (httpHeader) and type in (urlPattern) and static = false and omitWhenValueIsEmpty = true and multipleValues = true or type = urlQueryString and type in (httpHeader) and type in (urlQueryString) and static = false and omitWhenValueIsEmpty = true and multipleValues = true or type = urlQueryString and type in (httpHeader) and type in (requestOrResponseBody) and static = false and omitWhenValueIsEmpty = true and multipleValues = true or other dependency conditions are satisfied *)
<parameter_a_parameter> ::= <indent> "parameter" <ws> "{" <line_end> { <parameter_a_parameter_property_line> } <indent> "}" <line_end>
<parameter_a_parameter_property_line> ::= <indent> <parameter_a_parameter_property> <line_end>
<parameter_a_parameter_property> ::= "dataType" ":" <ws> ( "string" | "numeric" | "date" | "timestamp" | "timestampWithTimeZone" | "boolean" | "binary" ) (* required; conditional; data type: string; lov: STATIC; applies when type in (httpHeader) or type in (httpCookie) or type in (urlPattern) or other dependency conditions are satisfied *)
  | "direction" ":" <ws> ( "in" | "out" | "inOut" ) (* required; data type: string; lov: STATIC *)
  | "omitWhenValueIsEmpty" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (httpHeader) and type in (urlPattern) and static = false or type in (httpHeader) and type in (urlQueryString) and static = false or type in (httpHeader) and type in (requestOrResponseBody) and static = false or other dependency conditions are satisfied *)
  | "type" ":" <ws> ( "urlPattern" | "urlQueryString" | "httpHeader" | "dataProfileColumn" | "requestOrResponseBody" | "httpStatusCode" | "httpReasonPhrase" | "httpCookie" ) (* required; data type: string; lov: STATIC *)
<parameter_a_validation> ::= <indent> "validation" <ws> "{" <line_end> { <parameter_a_validation_property_line> } <indent> "}" <line_end>
<parameter_a_validation_property_line> ::= <indent> <parameter_a_validation_property> <line_end>
<parameter_a_validation_property> ::= "regexPattern" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (httpHeader) and dataType = string or type in (httpCookie) and dataType = string or type in (urlPattern) and dataType = string or other dependency conditions are satisfied *)
  | "required" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type in (urlPattern) and static = false or type in (urlQueryString) and static = false or type in (requestOrResponseBody) and static = false or other dependency conditions are satisfied *)
<parameter_a_value> ::= <indent> "value" <ws> "{" <line_end> { <parameter_a_value_property_line> } <indent> "}" <line_end>
<parameter_a_value_property_line> ::= <indent> <parameter_a_value_property> <line_end>
<parameter_a_value_property> ::= "defaultValueType" ":" <ws> ( "staticValue" | "item" | "sqlQuery" | "expression" | "functionBody" ) (* conditional; data type: string; lov: STATIC *)
  | "formatMask" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (httpHeader) and dataType in (boolean) or type in (httpHeader) and dataType in (numeric) or type in (httpHeader) and dataType in (date) or other dependency conditions are satisfied *)
  | "item" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when defaultValueType = item *)
  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when defaultValueType = expression and language = javaScript-mle *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when defaultValueType = functionBody and language = javaScript-mle *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when defaultValueType = expression *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when defaultValueType = functionBody *)
  | "plsqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when defaultValueType = expression and language = plsql *)
  | "plsqlFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when defaultValueType = functionBody and language = plsql *)
  | "sqlExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when defaultValueType = expression and language = sql *)
