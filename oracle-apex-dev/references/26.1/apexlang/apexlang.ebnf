<region_settings_property> ::= "axisPosition" ":" <ws> ( "top" | "bottom" ) (* required; conditional; data type: string; lov: STATIC; applies when type = chart and type = gantt *)
  | "batchFacetChanges" ":" <ws> <boolean> (* required; data type: boolean *)
  | "chartsSelector" ":" <ws> <string_like_value> (* required; conditional; data type: string *)
  | "compactNosThreshold" ":" <ws> <number> (* data type: number *)
