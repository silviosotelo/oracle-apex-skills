<region_value_property> ::= "currency" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = chart and type in (statusMeterGauge) and format = currency or type = chart and type in (statusMeterGauge) and type in (funnel) and format = currency or type = chart and type in (statusMeterGauge) and type in (pyramid) and format = currency or other dependency conditions are satisfied *)
  | "decimalPlaces" ":" <ws> <number> (* conditional; data type: integer; applies when type = chart and type in (statusMeterGauge) and format in (decimal) or type = chart and type in (statusMeterGauge) and format in (currency) or type = chart and type in (statusMeterGauge) and format in (percent) or other dependency conditions are satisfied *)
  | "format" ":" <ws> ( "dateShort" | "dateMedium" | "dateLong" | "dateFull" | "timeShort" | "timeMedium" | "timeLong" | "timeFull" | "datetimeShort" | "datetimeMedium" | "datetimeLong" | "datetimeFull" | "decimal" | "currency" | "percent" ) (* conditional; data type: string; lov: STATIC; applies when type = chart and type in (statusMeterGauge) or type = chart and type in (funnel) or type = chart and type in (pyramid) or other dependency conditions are satisfied *)
  | "formatScaling" ":" <ws> ( "none" | "auto" | "thousand" | "million" | "billion" | "trillion" | "quadrillion" ) (* required; conditional; data type: string; lov: STATIC; applies when type = chart and type in (statusMeterGauge) or type = chart and type in (funnel) or type = chart and type in (pyramid) or other dependency conditions are satisfied *)
