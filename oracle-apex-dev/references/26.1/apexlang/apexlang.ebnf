  | "staticId" ":" <ws> <string_like_value> (* required; data type: string *)

(* axis *)
(* direct properties use default group: identification *)
<axis> ::= "axis" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <axis_body_line> } <indent> ")" <line_end>
<axis_body_line> ::= <axis_direct_property_line>
  | <axis_group_block>
<axis_direct_property_line> ::= <indent> <axis_direct_property> <line_end>
<axis_direct_property> ::= "name" ":" <ws> ( "x" | "y" | "y2" | "major" | "minor" ) (* required; data type: string; lov: STATIC *)
  | "showAxis" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (x) or name in (y) or name in (y2) or other dependency conditions are satisfied *)
  | "title" ":" <ws> <string_like_value> (* data type: string *)
<axis_group_block> ::= <axis_advanced>
  | <axis_appearance>
  | <axis_dual_yaxes>
  | <axis_major_ticks>
  | <axis_minor_ticks>
  | <axis_tick_label>
  | <axis_time_scale>
  | <axis_title>
  | <axis_value>
  | <axis_zoom_scale>
<axis_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <axis_advanced_property_line> } <indent> "}" <line_end>
<axis_advanced_property_line> ::= <indent> <axis_advanced_property> <line_end>
<axis_advanced_property> ::= "staticId" ":" <ws> <string_like_value> (* data type: string *)
<axis_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <axis_appearance_property_line> } <indent> "}" <line_end>
<axis_appearance_property_line> ::= <indent> <axis_appearance_property> <line_end>
<axis_appearance_property> ::= "position" ":" <ws> ( "auto" | "start" | "end" | "top" | "bottom" ) (* required; conditional; data type: string; lov: STATIC *)
<axis_dual_yaxes> ::= <indent> "dualYAxes" <ws> "{" <line_end> { <axis_dual_yaxes_property_line> } <indent> "}" <line_end>
<axis_dual_yaxes_property_line> ::= <indent> <axis_dual_yaxes_property> <line_end>
<axis_dual_yaxes_property> ::= "show" ":" <ws> ( "auto" | "true" | "false" ) (* required; conditional; data type: string; lov: STATIC; applies when name = y2 *)
  | "splitterPosition" ":" <ws> <number> (* conditional; data type: number; applies when name = y2 *)
<axis_major_ticks> ::= <indent> "majorTicks" <ws> "{" <line_end> { <axis_major_ticks_property_line> } <indent> "}" <line_end>
<axis_major_ticks_property_line> ::= <indent> <axis_major_ticks_property> <line_end>
<axis_major_ticks_property> ::= "minStep" ":" <ws> <number> (* conditional; data type: number; applies when name in (x) or name in (y) or name in (y2) *)
  | "show" ":" <ws> ( "auto" | "true" | "false" ) (* required; conditional; data type: string; lov: STATIC; applies when name in (x) or name in (y) or name in (y2) *)
<axis_minor_ticks> ::= <indent> "minorTicks" <ws> "{" <line_end> { <axis_minor_ticks_property_line> } <indent> "}" <line_end>
<axis_minor_ticks_property_line> ::= <indent> <axis_minor_ticks_property> <line_end>
<axis_minor_ticks_property> ::= "show" ":" <ws> ( "auto" | "true" | "false" ) (* required; conditional; data type: string; lov: STATIC; applies when name in (x) or name in (y) or name in (y2) *)
  | "step" ":" <ws> <number> (* conditional; data type: number; applies when name in (x) or name in (y) or name in (y2) *)
<axis_tick_label> ::= <indent> "tickLabel" <ws> "{" <line_end> { <axis_tick_label_property_line> } <indent> "}" <line_end>
<axis_tick_label_property_line> ::= <indent> <axis_tick_label_property> <line_end>
<axis_tick_label_property> ::= "fontColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when name in (x) and show = on or name in (x) and name in (y) and show = on or name in (x) and name in (y2) and show = on or other dependency conditions are satisfied *)
  | "fontFamily" ":" <ws> ( "arial" | "arialBlack" | "bookman" | "comicSansMs" | "courier" | "courierNew" | "garamond" | "georgia" | "helvetica" | "impact" | "palatino" | "times" | "timesNewRoman" | "trebuchetMs" | "verdana" ) (* conditional; data type: string; lov: STATIC; applies when name in (x) and show = on or name in (x) and name in (y) and show = on or name in (x) and name in (y2) and show = on or other dependency conditions are satisfied *)
  | "fontSize" ":" <ws> ( "8" | "10" | "12" | "14" | "16" | "18" | "20" | "22" ) (* conditional; data type: string; lov: STATIC; applies when name in (x) and show = on or name in (x) and name in (y) and show = on or name in (x) and name in (y2) and show = on or other dependency conditions are satisfied *)
  | "fontStyle" ":" <ws> ( "normal" | "italic" | "oblique" ) (* conditional; data type: string; lov: STATIC; applies when name in (x) and show = on or name in (x) and name in (y) and show = on or name in (x) and name in (y2) and show = on or other dependency conditions are satisfied *)
  | "position" ":" <ws> ( "outside" | "inside" ) (* required; conditional; data type: string; lov: STATIC; applies when name in (x) and show = on and name = x or name in (y) and show = on and name = x or name in (y2) and show = on and name = x *)
  | "rotation" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (x) and show = on and name = x or name in (y) and show = on and name = x or name in (y2) and show = on and name = x *)
  | "show" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (x) or name in (y) or name in (y2) *)
<axis_time_scale> ::= <indent> "timeScale" <ws> "{" <line_end> { <axis_time_scale_property_line> } <indent> "}" <line_end>
<axis_time_scale_property_line> ::= <indent> <axis_time_scale_property> <line_end>
<axis_time_scale_property> ::= "scale" ":" <ws> ( "seconds" | "minutes" | "hours" | "days" | "weeks" | "months" | "quarters" | "years" ) (* required; conditional; data type: string; lov: STATIC; applies when name in (major) or name in (minor) *)
<axis_title> ::= <indent> "title" <ws> "{" <line_end> { <axis_title_property_line> } <indent> "}" <line_end>
<axis_title_property_line> ::= <indent> <axis_title_property> <line_end>
<axis_title_property> ::= "fontColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when name in (x) or name in (y) or name in (y2) *)
  | "fontFamily" ":" <ws> ( "arial" | "arialBlack" | "bookman" | "comicSansMs" | "courier" | "courierNew" | "garamond" | "georgia" | "helvetica" | "impact" | "palatino" | "times" | "timesNewRoman" | "trebuchetMs" | "verdana" ) (* conditional; data type: string; lov: STATIC; applies when name in (x) or name in (y) or name in (y2) *)
  | "fontSize" ":" <ws> ( "8" | "10" | "12" | "14" | "16" | "18" | "20" | "22" ) (* conditional; data type: string; lov: STATIC; applies when name in (x) or name in (y) or name in (y2) *)
  | "fontStyle" ":" <ws> ( "normal" | "italic" | "oblique" ) (* conditional; data type: string; lov: STATIC; applies when name in (x) or name in (y) or name in (y2) *)
<axis_value> ::= <indent> "value" <ws> "{" <line_end> { <axis_value_property_line> } <indent> "}" <line_end>
<axis_value_property_line> ::= <indent> <axis_value_property> <line_end>
<axis_value_property> ::= "baselineScaling" ":" <ws> ( "min" | "zero" ) (* required; conditional; data type: string; lov: STATIC; applies when name in (x) or name in (y) or name in (y2) *)
  | "currency" ":" <ws> <string_like_value> (* conditional; data type: string; applies when format = currency and name in (x) or format = currency and name in (y) or format = currency and name in (y2) *)
  | "decimalPlaces" ":" <ws> <number> (* conditional; data type: integer; applies when format in (decimal) and name in (x) or format in (decimal) and name in (y) or format in (decimal) and name in (y2) or other dependency conditions are satisfied *)
  | "format" ":" <ws> ( "dateShort" | "dateMedium" | "dateLong" | "dateFull" | "timeShort" | "timeMedium" | "timeLong" | "timeFull" | "datetimeShort" | "datetimeMedium" | "datetimeLong" | "datetimeFull" | "decimal" | "currency" | "percent" ) (* data type: string; lov: STATIC *)
  | "formatScaling" ":" <ws> ( "none" | "auto" | "thousand" | "million" | "billion" | "trillion" | "quadrillion" ) (* required; conditional; data type: string; lov: STATIC; applies when name in (x) or name in (y) or name in (y2) *)
  | "max" ":" <ws> <number> (* conditional; data type: number; applies when name in (x) or name in (y) or name in (y2) *)
  | "min" ":" <ws> <number> (* conditional; data type: number; applies when name in (x) or name in (y) or name in (y2) *)
  | "pattern" ":" <ws> <string_like_value> (* conditional; data type: string; applies when format is set and name in (x) or format is set and name in (y) or format is set and name in (y2) or other dependency conditions are satisfied *)
  | "scale" ":" <ws> ( "linear" | "log" ) (* required; conditional; data type: string; lov: STATIC; applies when name in (x) or name in (y) or name in (y2) *)
  | "step" ":" <ws> <number> (* conditional; data type: number; applies when name in (x) or name in (y) or name in (y2) *)
<axis_zoom_scale> ::= <indent> "zoomScale" <ws> "{" <line_end> { <axis_zoom_scale_property_line> } <indent> "}" <line_end>
<axis_zoom_scale_property_line> ::= <indent> <axis_zoom_scale_property> <line_end>
<axis_zoom_scale_property> ::= "days" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (major) or name in (minor) *)
  | "hours" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (major) or name in (minor) *)
  | "minutes" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (major) or name in (minor) *)
  | "months" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (major) or name in (minor) *)
  | "quarters" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (major) or name in (minor) *)
  | "seconds" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (major) or name in (minor) *)
  | "weeks" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (major) or name in (minor) *)
  | "years" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when name in (major) or name in (minor) *)

(* column *)
(* direct properties use default group: identification *)
<column_b> ::= "column" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <column_b_body_line> } <indent> ")" <line_end>
<column_b_body_line> ::= <column_b_direct_property_line>
  | <column_b_group_block>
  | <column_b_child_component>
<column_b_direct_property_line> ::= <indent> <column_b_direct_property> <line_end>
<column_b_direct_property> ::= "columnName" ":" <ws> <string_like_value> (* required; data type: string *)
  | "type" ":" <ws> <column_b_type_plugin_lov> (* required; data type: string; lov: PLUGINS *)
<column_b_group_block> ::= <column_b_accessibility>
  | <column_b_advanced>
  | <column_b_appearance>
  | <column_b_blob_attributes>
  | <column_b_column_filter>
  | <column_b_column_formatting>
  | <column_b_comments>
  | <column_b_config>
  | <column_b_enable_users_to>
  | <column_b_gen_ai>
  | <column_b_heading>
  | <column_b_help>
  | <column_b_layout>
  | <column_b_link>
  | <column_b_lov>
  | <column_b_row_selection>
  | <column_b_security>
  | <column_b_server_side_condition>
  | <column_b_settings>
  | <column_b_single_row_view>
  | <column_b_source>
<column_b_accessibility> ::= <indent> "accessibility" <ws> "{" <line_end> { <column_b_accessibility_property_line> } <indent> "}" <line_end>
<column_b_accessibility_property_line> ::= <indent> <column_b_accessibility_property> <line_end>
<column_b_accessibility_property> ::= "imageDescription" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = displayImage *)
  | "valueIdentifiesRow" ":" <ws> <boolean> (* required; conditional; data type: boolean *)
<column_b_advanced> ::= <indent> "advanced" <ws> "{" <line_end> { <column_b_advanced_property_line> } <indent> "}" <line_end>
<column_b_advanced_property_line> ::= <indent> <column_b_advanced_property> <line_end>
<column_b_advanced_property> ::= "endUserAlias" ":" <ws> <string_like_value> (* data type: string *)
  | "htmlDomId" ":" <ws> <string_like_value> (* conditional; data type: string *)
<column_b_appearance> ::= <indent> "appearance" <ws> "{" <line_end> { <column_b_appearance_property_line> } <indent> "}" <line_end>
<column_b_appearance_property_line> ::= <indent> <column_b_appearance_property> <line_end>
<column_b_appearance_property> ::= "backgroundColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = percentGraph *)
  | "barWidth" ":" <ws> <number> (* conditional; data type: integer; applies when type = percentGraph *)
  | "cssClasses" ":" <ws> <array_of_string_like_value> (* conditional; data type: string *)
  | "downloadText" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = downloadBlob *)
  | "foregroundColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = percentGraph *)
  | "formatMask" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (plainText) or type in (link) or type in (removeHtml) *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; conditional; data type: string; lov: STATIC; applies when type = downloadBlob *)
<column_b_blob_attributes> ::= <indent> "blobAttributes" <ws> "{" <line_end> { <column_b_blob_attributes_property_line> } <indent> "}" <line_end>
<column_b_blob_attributes_property_line> ::= <indent> <column_b_blob_attributes_property> <line_end>
<column_b_blob_attributes_property> ::= "blobColumn" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "charSetColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = downloadBlob *)
  | "filenameColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "lastUpdatedColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "mimeTypeColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "primaryKeyColumn1" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "primaryKeyColumn2" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "tableName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
  | "tableOwner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type in (displayImage) or type in (downloadBlob) *)
<column_b_column_filter> ::= <indent> "columnFilter" <ws> "{" <line_end> { <column_b_column_filter_property_line> } <indent> "}" <line_end>
<column_b_column_filter_property_line> ::= <indent> <column_b_column_filter_property> <line_end>
<column_b_column_filter_property> ::= "dateRanges" ":" <ws> ( "all" | "past" | "future" ) (* required; conditional; data type: string; lov: STATIC; applies when dataType = DATE and type = defaultBasedOnColumnType *)
  | "namedLov" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: lov; applies when type in (namedLovExactMatch) or type in (namedLovWordContains); dynamic values omitted *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type in (definedLovExactMatch) or type in (definedLovWordContains) *)
