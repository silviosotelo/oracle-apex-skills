  | "javaScriptExpression" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = expression and language = javaScript-mle or name supports IN_OUT_PARAMETER and type = expression and language = javaScript-mle or name supports IN_OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = interactiveGrid and enabled = true and ignoreOutput = false and type = expression and language = javaScript-mle or other dependency conditions are satisfied *)
  | "javaScriptFunctionBody" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when name supports IN_PARAMETER and type = functionBody and language = javaScript-mle or name supports IN_OUT_PARAMETER and type = functionBody and language = javaScript-mle or name supports IN_OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = interactiveGrid and enabled = true and ignoreOutput = false and type = functionBody and language = javaScript-mle or other dependency conditions are satisfied *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when name supports IN_PARAMETER and type = expression or name supports IN_OUT_PARAMETER and type = expression or name supports IN_OUT_PARAMETER and name does not support FETCH_COLLECTION_OPERATION_PRM and type = interactiveGrid and enabled = true and ignoreOutput = false and type = expression or other dependency conditions are satisfied *)
