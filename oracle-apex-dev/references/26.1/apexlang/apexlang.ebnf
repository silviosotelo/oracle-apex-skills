<highlight_b_condition_property> ::= "caseSensitive" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = rowSearch or type = column and operator in (contains) or type = column and operator in (doesNotContain) or other dependency conditions are satisfied *)
  | "column" ":" <ws> <reference> (* required; conditional; data type: string; lov: COMPONENT; references: column; applies when type = column; dynamic values omitted *)
  | "from" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = column and operator in (between) or type = column and operator in (notBetween) *)
  | "operator" ":" <ws> ( "equals" | "notEquals" | "greaterThan" | "greaterThanOrEquals" | "lessThan" | "lessThanOrEquals" | "isEmpty" | "isNotEmpty" | "in" | "notIn" | "between" | "notBetween" | "contains" | "doesNotContain" | "startsWith" | "doesNotStartWith" | "matchesRegexp" | "inTheLast" | "notInTheLast" | "inTheNext" | "notInTheNext" ) (* required; conditional; data type: string; lov: STATIC; applies when type = column *)
  | "search" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = rowSearch *)
  | "to" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = column and operator in (between) or type = column and operator in (notBetween) *)
  | "type" ":" <ws> ( "column" | "rowSearch" ) (* required; data type: string; lov: STATIC *)
  | "unit" ":" <ws> ( "min" | "hours" | "days" | "weeks" | "months" | "years" ) (* required; conditional; data type: string; lov: STATIC; applies when type = column and operator in (inTheLast) or type = column and operator in (notInTheLast) or type = column and operator in (inTheNext) or other dependency conditions are satisfied *)
  | "value" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = column *)
  | "value" ":" <ws> <number> (* required; conditional; data type: number; applies when type = column and operator in (inTheLast) or type = column and operator in (notInTheLast) or type = column and operator in (inTheNext) or other dependency conditions are satisfied *)
