(* authentication *)
(* direct properties use default group: identification *)
<authentication> ::= "authentication" [ <required_ws> <component_id> ] <ws> "(" <line_end> { <authentication_body_line> } <indent> ")" <line_end>
<authentication_body_line> ::= <authentication_direct_property_line>
  | <authentication_group_block>
