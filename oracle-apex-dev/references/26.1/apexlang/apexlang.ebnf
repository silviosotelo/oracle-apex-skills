  | "displayAs" ":" <ws> ( "label" | "percentage" | "value" | "labelValue" | "labelPercentage" | "labelPercentageValue" | "percentageValue" ) (* required; conditional; data type: string; lov: STATIC; applies when show = true and type in (pie) or show = true and type in (donut) *)
