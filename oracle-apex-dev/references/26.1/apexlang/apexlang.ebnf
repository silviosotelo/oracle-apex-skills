  | "language" ":" <ws> ( "plsql" | "js-mle" ) (* required; conditional; data type: string; lov: STATIC; applies when type = TRUE_FALSE_CHECK and condition_type in (EXPRESSION) or type = TRUE_FALSE_CHECK and condition_type in (FUNCTION_BODY) *)
