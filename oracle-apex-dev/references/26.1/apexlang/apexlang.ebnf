  | "z" ":" <ws> <reference> (* conditional; data type: string; lov: COMPONENT; references: column; applies when chart = true and type in (bubble) or chart = true and type in (bar) or chart = true and type in (range); dynamic values omitted *)
  | "zAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* conditional; data type: string; lov: STATIC; applies when chart = true and type in (bubble) and z is set or chart = true and type in (bubble) and type in (bar) and z is set or chart = true and type in (bubble) and type in (range) and z is set or other dependency conditions are satisfied *)
