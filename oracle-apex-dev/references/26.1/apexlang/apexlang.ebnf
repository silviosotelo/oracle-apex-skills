  | "sqlQuery" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE_SQL *)
  | "sqlQuery" ":" <ws> <multiline_string> (* required; conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = sqlQuery or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = sqlQuery *)
  | "tableName" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = tableView or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = tableView *)
  | "tableOwner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = tableView or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = tableView *)
  | "text" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE_PLAIN *)
  | "type" ":" <ws> ( "tableView" | "sqlQuery" | "functionBody" | "propertyGraph" ) (* required; conditional; data type: string; lov: STATIC; applies when type supports SOURCE_LOCATION and location in (localDatabase) or type supports SOURCE_LOCATION and location in (restEnabledSql) *)
  | "useGenericColumnNames" ":" <ws> <boolean> (* required; conditional; data type: boolean; applies when type = classicReport and type supports SOURCE_LOCATION and location in (localDatabase) and type = functionBody or type = classicReport and type supports SOURCE_LOCATION and location in (restEnabledSql) and type = functionBody *)
  | "whereClause" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = propertyGraph or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = propertyGraph *)
  | "whereClause" ":" <ws> <multiline_string> (* conditional; data type: string; applies when type supports SOURCE_LOCATION and location in (localDatabase) and type = tableView or type supports SOURCE_LOCATION and location in (restEnabledSql) and type = tableView *)
