<layer_link_property_line> ::= <indent> <layer_link_property> <line_end>
<layer_link_property> ::= "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = redirectThisApp *)
  | "target" ":" <ws> <value> (* required; conditional; data type: complex; applies when type = redirectOtherApp *)
  | "targetUrl" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when type = redirectUrl *)
  | "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "redirectUrlReturnedByFirstCol" ) (* conditional; data type: string; lov: STATIC *)
