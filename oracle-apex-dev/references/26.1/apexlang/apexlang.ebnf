  | "tableOwner" ":" <ws> <string_like_value> (* conditional; data type: string; applies when type = tableView *)
  | "type" ":" <ws> ( "none" | "tableView" | "sqlQuery" ) (* required; data type: string; lov: STATIC *)
<task_definition_task> ::= <indent> "task" <ws> "{" <line_end> { <task_definition_task_property_line> } <indent> "}" <line_end>
