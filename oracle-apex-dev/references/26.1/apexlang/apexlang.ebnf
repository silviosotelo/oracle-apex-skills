  | "fetchOnType" ":" <ws> <boolean> (* required; data type: boolean *)
  | "filenameColumn" ":" <ws> <string_like_value> (* conditional; data type: string; applies when based_on = DB_COLUMN *)
  | "foregroundColor" ":" <ws> <string_like_value> (* data type: string *)
  | "format" ":" <ws> ( "markdown" | "html" ) (* required; data type: string; lov: STATIC *)
  | "hideControl" ":" <ws> <boolean> (* required; data type: boolean *)
  | "highlightedDate" ":" <ws> <string_like_value> (* data type: string *)
  | "htmlExpression" ":" <ws> <string_like_value> (* required; data type: string *)
  | "icon" ":" <ws> <string_like_value> (* required; conditional; data type: string; applies when use_defaults = N *)
  | "inactiveColor" ":" <ws> <string_like_value> (* conditional; data type: string; applies when use_defaults = N *)
  | "infiniteScroll" ":" <ws> <boolean> (* required; data type: boolean *)
